    source: CORTEX_STEP_SOURCE_USER_EXPLICIT
    source_trajectory_step_info {
      trajectory_id: "85e0e3eb-837a-4d22-8f08-695457023526"
      step_index: 1
      cascade_id: "85e0e3eb-837a-4d22-8f08-695457023526"
