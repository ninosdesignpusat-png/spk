            }
            lines {
              text: "4. **Strict Key & Enum Enforcement**: Every collection enforces exact `hasAll` and `hasOnly` key sets on creation, and explicit action-based `affectedKeys().hasOnly(...)` on update wrapped inside `isValid[Entity](incoming())`."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "5. **Path ID Hardening**: All single-document operations (`get`, `create`, `update`, `delete`) validate document IDs using `isValidId(id)` matching `^[a-zA-Z0-9_\\-]+$` with length `<= 128`."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "6. **Query Enforcer on List**: All `allow list` rules explicitly validate `resource.data.ownerId == request.auth.uid` (or `isAdmin()`)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "## 2. The \"Dirty Dozen\" Payloads"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "1. **Unverified Admin Email Spoof**: `{ auth: { uid: \"spoof\", token: { email: \"jajapintravel@gmail.com\", email_verified: false } } }` -> Rejected (`PERMISSION_DENIED`)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "2. **Shadow Field Injection on Room Create**: `{ ...validRoom, isSuperRoom: true }` -> Rejected by `data.keys().hasOnly(...)` (`PERMISSION_DENIED`)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "3. **Cross-Tenant Owner Spoofing on Reservation Create**: `{ ...validReservation, ownerId: \"other_user_uid\" }` -> Rejected by `data.ownerId == request.auth.uid` (`PERMISSION_DENIED`)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "4. **Update-Gap Value Poisoning on Room Update**: Updating `status` to `\"HackedStatus\"` -> Rejected because `isValidRoom(incoming())` wraps the `allow update` rule (`PERMISSION_DENIED`)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "5. **Immutable Field Mutation on Reservation Update**: Changing `createdAt` or `ownerId` during `update` -> Rejected by immutability guard (`PERMISSION_DENIED`)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "6. **Client Timestamp Forgery**: Setting `updatedAt` to a past/future timestamp instead of `request.time` -> Rejected (`PERMISSION_DENIED`)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "7. **ID Poisoning Attack**: Creating `/rooms/invalid$id!with*spaces` -> Rejected by `isValidId(roomId)` (`PERMISSION_DENIED`)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "8. **Denial-of-Wallet Oversized String**: Creating an Expense with a 5,000-character `description` -> Rejected by `data.description.size() <= 200` (`PERMISSION_DENIED`)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "9. **Negative Revenue/Expense Injection**: Creating an Expense with `amount: -500000` -> Rejected by `data.amount >= 0` (`PERMISSION_DENIED`)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "10. **Invalid OTA Channel Enum**: Creating a Reservation with `channel: \"UnknownOTA\"` -> Rejected by enum allowlist (`PERMISSION_DENIED`)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "11. **Unauthorized Blanket List Query**: Listing `/reservations` without filtering by `ownerId == request.auth.uid` -> Rejected by `resource.data.ownerId == request.auth.uid` (`PERMISSION_DENIED`)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "12. **Unauthorised Field Update on Room Housekeeping**: Modifying `roomNumber` during a status update action -> Rejected by `affectedKeys().hasOnly(...)` (`PERMISSION_DENIED`)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "## 3. Red Team Conflict Report"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Identity Spoofing**: Blocked on all 4 collections via `data.ownerId == request.auth.uid` and `request.auth.token.email_verified == true`."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **State Shortcutting**: Room and Reservation statuses are strictly constrained to valid enums (`Available`, `Occupied`, `Dirty`, `Maintenance` and `Confirmed`, `Checked-In`, `Checked-Out`, `Cancelled`)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Resource Poisoning**: All strings have explicit `.size()` upper bounds matching `firebase-blueprint.json`, and all path IDs require `isValidId()`."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Value Poisoning on Update**: Every `allow update` block begins with `isValid[Entity](incoming())` before checking `affectedKeys().hasOnly(...)`."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
          }
        }
        absolute_uri: "file:///security_spec.md"
        create_file: true
      }
    }
    use_fast_apply: true
    description: "Create security_spec.md documenting invariants, Dirty Dozen payloads, and Red Team audit"
    diff_stats {
      additions: 30
    }
  }
}
