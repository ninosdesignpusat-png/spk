  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport {\n  BookingChannel,\n  PropertySettingsConfig,\n  ReservationRecord,\n  ReservationStatus,\n  RoomUnit,\n} from \'../types/hms\';\nimport {\n  ALL_BOOKING_CHANNELS,\n  calculateOtaFinancials,\n  calculateStayBreakdown,\n  formatIDR,\n  getChannelCommissionRate,\n} from \'../utils/hotelCalculations\';\nimport { Check, Plus, RefreshCw, Search } from \'lucide-react\';\n\ninterface ReservationsAndOtaManagerProps {\n  rooms: RoomUnit[];\n  reservations: ReservationRecord[];\n  settings: PropertySettingsConfig;\n  selectedRoomIdForQuickBook?: string | null;\n  onAddReservation: (\n    newRes: Omit<ReservationRecord, \'id\' | \'ownerId\'>\n  ) => void;\n  onUpdateReservationStatus: (\n    reservationId: string,\n    newStatus: ReservationStatus\n  ) => void;\n  onSyncOta: () => void;\n  isSyncingOta: boolean;\n  lastOtaSync: string;\n}\n\nexport const ReservationsAndOtaManager: React.FC<\n  ReservationsAndOtaManagerProps\n> = ({\n  rooms,\n  reservations,\n  settings,\n  selectedRoomIdForQuickBook,\n  onAddReservation,\n  onUpdateReservationStatus,\n  onSyncOta,\n  isSyncingOta,\n  lastOtaSync,\n}) => {\n  const [guestName, setGuestName] = useState(\'\');\n  const [guestPhone, setGuestPhone] = useState(\'\');\n  const [roomId, setRoomId] = useState(\n    selectedRoomIdForQuickBook || rooms[0]?.id || \'room-101\'\n  );\n  const [channel, setChannel] = useState<BookingChannel>(\'Traveloka\');\n  const [checkIn, setCheckIn] = useState(\'2026-10-25\');\n  const [checkOut, setCheckOut] = useState(\'2026-10-27\');\n  const [notes, setNotes] = useState(\'\');\n  const [formError, setFormError] = useState(\'\');\n  const [formSuccess, setFormSuccess] = useState(\'\');\n\n  const [filterChannel, setFilterChannel] = useState<\'ALL\' | BookingChannel>(\'ALL\');\n  const [searchQuery, setSearchQuery] = useState(\'\');\n\n  const selectedRoom = rooms.find((r) => r.id === roomId) || rooms[0];\n  const stayCalc = calculateStayBreakdown(\n    checkIn,\n    checkOut,\n    selectedRoom?.weekdayRate || 300000,\n    selectedRoom?.weekendRate || 350000\n  );\n  const commRate = getChannelCommissionRate(channel, settings);\n  const otaFinancials = calculateOtaFinancials(stayCalc.grossRevenue, commRate);\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    setFormError(\'\');\n    setFormSuccess(\'\');\n\n    if (!guestName.trim()) {\n      setFormError(\'Nama lengkap tamu wajib diisi.\');\n      return;\n    }\n    if (stayCalc.nights <= 0) {\n      setFormError(\'Tanggal Check-Out harus lebih besar dari tanggal Check-In.\');\n      return;\n    }\n    if (!selectedRoom) {\n      setFormError(\'Pilih unit kamar terlebih dahulu.\');\n      return;\n    }\n\n    const prefixMap: Record<BookingChannel, string> = {\n      \'Direct Booking\': \'DIR\',\n      Airbnb: \'ABB\',\n      Traveloka: \'TVL\',\n      \'Tiket.com\': \'TKT\',\n      Agoda: \'AGD\',\n      \'Booking.com\': \'BKG\',\n    };\n\n    const randomDigits = Math.floor(1000 + Math.random() * 9000);\n    const bookingCode = `${prefixMap[channel]}-${randomDigits}`;\n    const monthKey = checkIn.slice(0, 7);\n\n    onAddReservation({\n      bookingCode,\n      guestName: guestName.trim(),\n      guestPhone: guestPhone.trim() || \'-\',\n      roomId: selectedRoom.id,\n      roomNumber: selectedRoom.roomNumber,\n      roomType: selectedRoom.type,\n      physicalCategory: selectedRoom.physicalCategory,\n      checkIn,\n      checkOut,\n      nights: stayCalc.nights,\n      weekdayNights: stayCalc.weekdayNights,\n      weekendNights: stayCalc.weekendNights,\n      channel,\n      grossRevenue: otaFinancials.grossRevenue,\n      commissionRate: otaFinancials.commissionRate,\n      commissionAmount: otaFinancials.commissionAmount,\n      netRevenue: otaFinancials.netRevenue,\n      status: \'Confirmed\',\n      monthKey,\n      notes: notes.trim(),\n    });\n\n    setGuestName(\'\');\n    setGuestPhone(\'\');\n    setNotes(\'\');\n    setFormSuccess(\n      `Reservasi ${bookingCode} (${guestName.trim()}) berhasil disimpan. Net Room Revenue: ${formatIDR(otaFinancials.netRevenue)}.`\n    );\n  };\n\n  const filteredReservations = reservations.filter((r) => {\n    if (filterChannel !== \'ALL\' && r.channel !== filterChannel) return false;\n    if (\n      searchQuery.trim() &&\n      !r.guestName.toLowerCase().includes(searchQuery.toLowerCase()) &&\n      !r.bookingCode.toLowerCase().includes(searchQuery.toLowerCase()) &&\n      !r.roomNumber.includes(searchQuery)\n    ) {\n      return false;\n    }\n    return true;\n  });\n\n  return (\n    <div className=\"space-y-6\">\n      {/* 6 OTA Channel Manager Status Header */}\n      <div className=\"bg-white border border-slate-200 rounded-xl p-6\">\n        <div className=\"flex flex-wrap items-center justify-between gap-4 pb-5 border-b border-slate-100\">\n          <div>\n            <h1 className=\"text-xl font-bold text-slate-900\">\n              Channel Manager 6 OTA & Input Reservasi\n            </h1>\n            <p className=\"text-xs text-slate-500 mt-1\">\n              Ketersediaan 15 kamar terhubung dengan 6 sumber booking \302\267 Terakhir\n              disinkronkan: <span className=\"font-mono\">{lastOtaSync}</span>\n            </p>\n          </div>\n\n          <button\n            type=\"button\"\n            onClick={onSyncOta}\n            disabled={isSyncingOta}\n            className=\"inline-flex items-center gap-2 px-4 py-2.5 text-xs font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-lg transition-colors whitespace-nowrap shrink-0 disabled:opacity-60\"\n          >\n            <RefreshCw\n              className={`w-4 h-4 ${isSyncingOta ? \'animate-spin\' : \'\'}`}\n            />\n            <span>\n              {isSyncingOta\n                ? \'Menyinkronkan Stok Kamar ke 6 OTA...\'\n                : \'Sync OTA Availability\'}\n            </span>\n          </button>\n        </div>\n\n        {/* 6 Connected OTA Channel Cards */}\n        <div className=\"grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 mt-5\">\n          {ALL_BOOKING_CHANNELS.map((ch) => {\n            const rate = getChannelCommissionRate(ch, settings);\n            return (\n              <div\n                key={ch}\n                className=\"p-3.5 border border-slate-200 rounded-lg bg-slate-50/60 flex flex-col justify-between\"\n              >\n                <div className=\"flex items-center justify-between text-xs\">\n                  <span className=\"font-bold text-slate-900\">{ch}</span>\n                </div>\n                <div className=\"mt-2 flex items-center justify-between text-xs\">\n                  <span className=\"text-slate-500\">Komisi:</span>\n                  <span className=\"font-mono tabular-nums font-semibold text-slate-900\">\n                    {rate}%\n                  </span>\n                </div>\n                <div className=\"mt-1.5 text-[11px] text-emerald-700 font-medium flex items-center gap-1\">\n                  <Check className=\"w-3 h-3\" />\n                  <span>Terkoneksi (2-Way XML)</span>\n                </div>\n              </div>\n            );\n          })}\n        </div>\n      </div>\n\n      {/* Input Reservasi Baru & Kalkulator Komisi Otomatis */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n        <form\n          onSubmit={handleSubmit}\n          className=\"lg:col-span-7 bg-white border border-slate-200 rounded-xl p-6 space-y-4\"\n        >\n          <div>\n            <h2 className=\"text-base font-bold text-slate-900\">\n              Form Input Reservasi Baru (Walk-in / OTA Masuk)\n            </h2>\n            <p className=\"text-xs text-slate-500\">\n              Sistem otomatis menghitung tarif Weekday/Weekend, potongan komisi OTA,\n              dan Net Room Revenue\n            </p>\n          </div>\n\n          {formError && (\n            <div\n              role=\"alert\"\n              className=\"p-3 text-xs font-medium text-rose-800 bg-rose-50 border border-rose-200 rounded-lg\"\n            >\n              {formError}\n            </div>\n          )}\n\n          {formSuccess && (\n            <div\n              role=\"status\"\n              className=\"p-3 text-xs font-medium text-emerald-800 bg-emerald-50 border border-emerald-200 rounded-lg\"\n            >\n              {formSuccess}\n            </div>\n          )}\n\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n            <div>\n              <label\n                htmlFor=\"res-guest-name\"\n                className=\"block text-xs font-semibold text-slate-700 mb-1\"\n              >\n                Nama Lengkap Tamu *\n              </label>\n              <input\n                id=\"res-guest-name\"\n                type=\"text\"\n                value={guestName}\n                onChange={(e) => setGuestName(e.target.value)}\n                placeholder=\"Contoh: Budi Santoso\"\n                className=\"w-full px-3 py-2 text-xs bg-white border border-slate-300 rounded-lg text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900\"\n              />\n            </div>\n\n            <div>\n              <label\n                htmlFor=\"res-guest-phone\"\n                className=\"block text-xs font-semibold text-slate-700 mb-1\"\n              >\n                Nomor WhatsApp / Telepon\n              </label>\n              <input\n                id=\"res-guest-phone\"\n                type=\"text\"\n                value={guestPhone}\n                onChange={(e) => setGuestPhone(e.target.value)}\n                placeholder=\"0812-xxxx-xxxx\"\n                className=\"w-full px-3 py-2 text-xs bg-white border border-slate-300 rounded-lg text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900\"\n              />\n            </div>\n\n            <div>\n              <label\n                htmlFor=\"res-room-select\"\n                className=\"block text-xs font-semibold text-slate-700 mb-1\"\n              >\n                Pilih Unit Kamar (15 Kamar) *\n              </label>\n              <select\n                id=\"res-room-select\"\n                value={roomId}\n                onChange={(e) => setRoomId(e.target.value)}\n                className=\"w-full px-3 py-2 text-xs bg-white border border-slate-300 rounded-lg text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900\"\n              >\n                {rooms.map((r) => (\n                  <option key={r.id} value={r.id}>\n                    Kamar {r.roomNumber} \342\200\224 {r.physicalCategory} ({r.type}:{\' \'}\n                    {formatIDR(r.weekdayRate)}) [{r.status}]\n                  </option>\n                ))}\n              </select>\n            </div>\n\n            <div>\n              <label\n                htmlFor=\"res-channel-select\"\n                className=\"block text-xs font-semibold text-slate-700 mb-1\"\n              >\n                Sumber Booking / Channel OTA *\n              </label>\n              <select\n                id=\"res-channel-select\"\n                value={channel}\n                onChange={(e) => setChannel(e.target.value as BookingChannel)}\n                className=\"w-full px-3 py-2 text-xs bg-white border border-slate-300 rounded-lg text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900\"\n              >\n                {ALL_BOOKING_CHANNELS.map((ch) => (\n                  <option key={ch} value={ch}>\n                    {ch} (Komisi {getChannelCommissionRate(ch, settings)}%)\n                  </option>\n                ))}\n              </select>\n            </div>\n\n            <div>\n              <label\n                htmlFor=\"res-checkin\"\n                className=\"block text-xs font-semibold text-slate-700 mb-1\"\n              >\n                Tanggal Check-In *\n              </label>\n              <input\n                id=\"res-checkin\"\n                type=\"date\"\n                value={checkIn}\n                onChange={(e) => setCheckIn(e.target.value)}\n                className=\"w-full px-3 py-2 text-xs font-mono bg-white border border-slate-300 rounded-lg text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900\"\n              />\n            </div>\n\n            <div>\n              <label\n                htmlFor=\"res-checkout\"\n                className=\"block text-xs font-semibold text-slate-700 mb-1\"\n              >\n                Tanggal Check-Out *\n              </label>\n              <input\n                id=\"res-checkout\"\n                type=\"date\"\n                value={checkOut}\n                onChange={(e) => setCheckOut(e.target.value)}\n                className=\"w-full px-3 py-2 text-xs font-mono bg-white border border-slate-300 rounded-lg text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900\"\n              />\n            </div>\n          </div>\n\n          <div>\n            <label\n              htmlFor=\"res-notes\"\n              className=\"block text-xs font-semibold text-slate-700 mb-1\"\n            >\n              Catatan Tambahan (Permintaan Khusus / Sarapan)\n            </label>\n            <input\n              id=\"res-notes\"\n              type=\"text\"\n              value={notes}\n              onChange={(e) => setNotes(e.target.value)}\n              placeholder=\"Contoh: Check-in malam pukul 20:00 WIB\"\n              className=\"w-full px-3 py-2 text-xs bg-white border border-slate-300 rounded-lg text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900\"\n            />\n          </div>\n\n          <button\n            type=\"submit\"\n            className=\"w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-2.5 text-xs font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-lg transition-colors\"\n          >\n            <Plus className=\"w-4 h-4\" />\n            <span>Simpan Reservasi & Hitung Komisi Otomatis</span>\n          </button>\n        </form>\n\n        {/* Live Automatic Commission & Net Revenue Preview Panel */}\n        <div className=\"lg:col-span-5 bg-slate-900 text-white rounded-xl p-6 flex flex-col justify-between\">\n          <div className=\"space-y-4\">\n            <div>\n              <p className=\"text-xs font-mono text-slate-400\">\n                KALKULATOR PENDAPATAN KAMAR & KOMISI OTA\n              </p>\n              <h3 className=\"text-lg font-bold mt-1\">\n                Kamar {selectedRoom?.roomNumber} \342\200\224 {selectedRoom?.name}\n              </h3>\n              <p className=\"text-xs text-slate-300 mt-0.5\">\n                Rate Plan: {selectedRoom?.type} (\n                {selectedRoom?.includesBreakfast\n                  ? \'Include Breakfast\'\n                  : \'Room Only\'}\n                )\n              </p>\n            </div>\n\n            <div className=\"space-y-2.5 pt-3 border-t border-slate-800 text-xs\">\n              <div className=\"flex items-center justify-between\">\n                <span className=\"text-slate-300\">Durasi Menginap:</span>\n                <span className=\"font-mono tabular-nums font-semibold\">\n                  {stayCalc.nights} Malam ({stayCalc.weekdayNights} Weekday,{\' \'}\n                  {stayCalc.weekendNights} Weekend)\n                </span>\n              </div>\n              <div className=\"flex items-center justify-between\">\n                <span className=\"text-slate-300\">Harga Kamar Weekday:</span>\n                <span className=\"font-mono tabular-nums\">\n                  {formatIDR(selectedRoom?.weekdayRate || 0)} / malam\n                </span>\n              </div>\n              <div className=\"flex items-center justify-between\">\n                <span className=\"text-slate-300\">Harga Kamar Weekend:</span>\n                <span className=\"font-mono tabular-nums\">\n                  {formatIDR(selectedRoom?.weekendRate || 0)} / malam\n                </span>\n              </div>\n              <div className=\"flex items-center justify-between pt-2 border-t border-slate-800\">\n                <span className=\"text-slate-200 font-semibold\">\n                  Gross Revenue (Harga \303\227 Malam):\n                </span>\n                <span\n                  data-testid=\"calc-preview-gross\"\n                  className=\"font-mono tabular-nums text-base font-bold text-white\"\n                >\n                  {formatIDR(otaFinancials.grossRevenue)}\n                </span>\n              </div>\n              <div className=\"flex items-center justify-between\">\n                <span className=\"text-amber-300\">\n                  Potongan Komisi {channel} ({otaFinancials.commissionRate}%):\n                </span>\n                <span\n                  data-testid=\"calc-preview-commission\"\n                  className=\"font-mono tabular-nums font-semibold text-amber-300\"\n                >\n                  -{formatIDR(otaFinancials.commissionAmount)}\n                </span>\n              </div>\n            </div>\n          </div>\n\n          <div className=\"pt-4 mt-4 border-t border-slate-800\">\n            <div className=\"flex items-baseline justify-between\">\n              <span className=\"text-xs font-semibold text-slate-300\">\n                NET ROOM REVENUE (Pendapatan Bersih):\n              </span>\n              <span\n                data-testid=\"calc-preview-net\"\n                className=\"text-2xl font-bold font-mono tabular-nums text-emerald-400\"\n              >\n                {formatIDR(otaFinancials.netRevenue)}\n              </span>\n            </div>\n            <p className=\"text-[11px] text-slate-400 mt-1\">\n              Otomatis masuk ke Bagian A & Bagian C Laporan Keuangan Bulanan (P&L)\n            </p>\n          </div>\n        </div>\n      </div>\n\n      {/* Reservations List & Check-in / Check-out Management */}\n      <div className=\"bg-white border border-slate-200 rounded-xl p-6\">\n        <div className=\"flex flex-wrap items-center justify-between gap-4 pb-4 border-b border-slate-100\">\n          <div>\n            <h2 className=\"text-base font-bold text-slate-900\">\n              Daftar Seluruh Reservasi & Tindakan Check-In / Check-Out\n            </h2>\n            <p className=\"text-xs text-slate-500\">\n              Klik Check-In saat tamu tiba atau Check-Out saat tamu meninggalkan kamar\n            </p>\n          </div>\n\n          <div className=\"flex flex-wrap items-center gap-3\">\n            <div className=\"relative\">\n              <Search className=\"w-3.5 h-3.5 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2\" />\n              <input\n                type=\"text\"\n                aria-label=\"Cari nama tamu atau kode booking\"\n                value={searchQuery}\n                onChange={(e) => setSearchQuery(e.target.value)}\n                placeholder=\"Cari tamu / kode / kamar...\"\n                className=\"pl-8 pr-3 py-1.5 text-xs bg-slate-50 border border-slate-300 rounded-lg text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900\"\n              />\n            </div>\n\n            <select\n              aria-label=\"Filter sumber channel OTA\"\n              value={filterChannel}\n              onChange={(e) =>\n                setFilterChannel(e.target.value as \'ALL\' | BookingChannel)\n              }\n              className=\"px-3 py-1.5 text-xs bg-slate-50 border border-slate-300 rounded-lg text-slate-900\"\n            >\n              <option value=\"ALL\">Semua Channel (6 OTA)</option>\n              {ALL_BOOKING_CHANNELS.map((ch) => (\n                <option key={ch} value={ch}>\n                  {ch}\n                </option>\n              ))}\n            </select>\n          </div>\n        </div>\n\n        <div className=\"overflow-x-auto mt-4\">\n          <table className=\"w-full text-left border-collapse\">\n            <thead>\n              <tr className=\"border-b border-slate-200 text-xs font-semibold text-slate-500\">\n                <th className=\"py-2.5 pr-3\">Kode & Tamu</th>\n                <th className=\"py-2.5 px-3\">Unit Kamar</th>\n                <th className=\"py-2.5 px-3\">Check-In / Out</th>\n                <th className=\"py-2.5 px-3\">Sumber OTA</th>\n                <th className=\"py-2.5 px-3 text-right\">Gross</th>\n                <th className=\"py-2.5 px-3 text-right\">Komisi OTA</th>\n                <th className=\"py-2.5 px-3 text-right\">Net Revenue</th>\n                <th className=\"py-2.5 px-3\">Status</th>\n                <th className=\"py-2.5 pl-3 text-right\">Aksi Resepsionis</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-100 text-xs\">\n              {filteredReservations.map((res) => (\n                <tr key={res.id} className=\"hover:bg-slate-50\">\n                  <td className=\"py-3 pr-3\">\n                    <div className=\"font-semibold text-slate-900\">\n                      {res.guestName}\n                    </div>\n                    <div className=\"text-slate-500 font-mono\">\n                      {res.bookingCode} \302\267 {res.guestPhone || \'-\'}\n                    </div>\n                  </td>\n                  <td className=\"py-3 px-3\">\n                    <div className=\"font-medium text-slate-900\">\n                      Kamar {res.roomNumber}\n                    </div>\n                    <div className=\"text-slate-500\">{res.roomType}</div>\n                  </td>\n                  <td className=\"py-3 px-3 font-mono tabular-nums text-slate-600\">\n                    <div>\n                      {res.checkIn} \342\206\222 {res.checkOut}\n                    </div>\n                    <div className=\"text-slate-400\">{res.nights} malam</div>\n                  </td>\n                  <td className=\"py-3 px-3\">\n                    <span className=\"font-semibold text-slate-900\">\n                      {res.channel}\n                    </span>\n                    <span className=\"text-slate-500 font-mono ml-1\">\n                      ({res.commissionRate}%)\n                    </span>\n                  </td>\n                  <td className=\"py-3 px-3 text-right font-mono tabular-nums text-slate-900\">\n                    {formatIDR(res.grossRevenue)}\n                  </td>\n                  <td className=\"py-3 px-3 text-right font-mono tabular-nums text-amber-700\">\n                    -{formatIDR(res.commissionAmount)}\n                  </td>\n                  <td className=\"py-3 px-3 text-right font-mono tabular-nums font-semibold text-emerald-700\">\n                    {formatIDR(res.netRevenue)}\n                  </td>\n                  <td className=\"py-3 px-3 font-medium text-slate-800\">\n                    {res.status}\n                  </td>\n                  <td className=\"py-3 pl-3 text-right\">\n                    <div className=\"inline-flex items-center gap-1.5\">\n                      {res.status === \'Confirmed\' && (\n                        <button\n                          type=\"button\"\n                          onClick={() =>\n                            onUpdateReservationStatus(res.id, \'Checked-In\')\n                          }\n                          className=\"px-2.5 py-1 text-[11px] font-semibold bg-slate-900 text-white rounded hover:bg-slate-800 transition-colors whitespace-nowrap\"\n                        >\n                          Check-In\n                        </button>\n                      )}\n                      {res.status === \'Checked-In\' && (\n                        <button\n                          type=\"button\"\n                          onClick={() =>\n                            onUpdateReservationStatus(res.id, \'Checked-Out\')\n                          }\n                          className=\"px-2.5 py-1 text-[11px] font-semibold bg-emerald-700 text-white rounded hover:bg-emerald-800 transition-colors whitespace-nowrap\"\n                        >\n                          Check-Out\n                        </button>\n                      )}\n                      {res.status !== \'Checked-Out\' &&\n                        res.status !== \'Cancelled\' && (\n                          <button\n                            type=\"button\"\n                            onClick={() =>\n                              onUpdateReservationStatus(res.id, \'Cancelled\')\n                            }\n                            className=\"px-2 py-1 text-[11px] font-medium text-rose-700 hover:bg-rose-50 rounded transition-colors whitespace-nowrap\"\n                          >\n                            Batal\n                          </button>\n                        )}\n                    </div>\n                  </td>\n                </tr>\n              ))}\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/ReservationsAndOtaManager.tsx"
        }
        overwrite: true
      }
    }
