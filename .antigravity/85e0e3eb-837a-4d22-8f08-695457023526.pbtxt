  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { MonthlyProfitLossReport, UserRole } from \'../types/hms\';\nimport { HOTEL_PHOTOS } from \'../data/initialData\';\nimport { BrainCircuit, Image, MapPin, MessageSquare, Sparkles } from \'lucide-react\';\n\ninterface AiAndMapsHubProps {\n  role: UserRole;\n  pnlReport: MonthlyProfitLossReport;\n}\n\nexport const AiAndMapsHub: React.FC<AiAndMapsHubProps> = ({\n  role,\n  pnlReport,\n}) => {\n  const [activeTab, setActiveTab] = useState<\n    \'quick_assist\' | \'maps\' | \'thinking_audit\' | \'image_studio\'\n  >(role === UserRole.RESEPSIONIS ? \'quick_assist\' : \'thinking_audit\');\n\n  // 1. High-Thinking Financial Audit (gemini-4-argon)\n  const [auditQuestion, setAuditQuestion] = useState(\n    \'Bagaimana strategi menurunkan beban komisi OTA dan meningkatkan Net Profit Margin Hotel Putri Sari bulan depan?\'\n  );\n  const [auditResult, setAuditResult] = useState(\'\');\n  const [auditModel, setAuditModel] = useState(\'\');\n  const [isAuditing, setIsAuditing] = useState(false);\n\n  // 2. Quick Front Desk Assistant (gemini-3.1-flash-lite)\n  const [guestName, setGuestName] = useState(\'Keluarga Bp. Bambang Suryono\');\n  const [roomName, setRoomName] = useState(\'Family Suite 301\');\n  const [quickOutput, setQuickOutput] = useState(\'\');\n  const [isQuickLoading, setIsQuickLoading] = useState(false);\n\n  // 3. Google Maps Grounding (gemini-3.8-flash + googleMaps)\n  const [mapsQuery, setMapsQuery] = useState(\n    \'Rekomendasi tempat kuliner populer, ATM center, dan objek wisata keluarga terdekat untuk tamu Hotel Putri Sari\'\n  );\n  const [mapsText, setMapsText] = useState(\'\');\n  const [mapsPlaces, setMapsPlaces] = useState<\n    Array<{ title: string; uri: string }>\n  >([]);\n  const [isMapsLoading, setIsMapsLoading] = useState(false);\n\n  // 4. Image Studio (gemini-nano-banana-2.1)\n  const [selectedAsset, setSelectedAsset] = useState(HOTEL_PHOTOS.deluxeMain);\n  const [imagePrompt, setImagePrompt] = useState(\n    \'Create a warm, high-resolution luxury tropical hotel promotional banner featuring an emerald green bed setup with morning sunlight\'\n  );\n  const [generatedImg, setGeneratedImg] = useState(\'\');\n  const [imageError, setImageError] = useState(\'\');\n  const [isGeneratingImg, setIsGeneratingImg] = useState(false);\n\n  const handleRunAudit = async () => {\n    setIsAuditing(true);\n    setAuditResult(\'\');\n    try {\n      const res = await fetch(\'/api/gemini/financial-audit\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          pnlSummary: reportToCompactPayload(pnlReport),\n          customQuestion: auditQuestion,\n        }),\n      });\n      const data = await res.json();\n      if (!res.ok) throw new Error(data.error || \'Gagal menjalankan analisis AI.\');\n      setAuditResult(data.text);\n      setAuditModel(data.modelUsed || \'gemini-4-argon\');\n    } catch (err: unknown) {\n      setAuditResult(\n        err instanceof Error ? `Info API: ${err.message}` : \'Gagal memuat respons.\'\n      );\n    } finally {\n      setIsAuditing(false);\n    }\n  };\n\n  const handleRunQuickAssist = async () => {\n    setIsQuickLoading(true);\n    setQuickOutput(\'\');\n    try {\n      const res = await fetch(\'/api/gemini/quick-assist\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          taskType: \'Konfirmasi Reservasi & Panduan Check-In WhatsApp\',\n          guestName,\n          roomName,\n          checkIn: \'2026-10-25\',\n          checkOut: \'2026-10-27\',\n          channel: \'Direct Booking\',\n          totalAmount: 1500000,\n        }),\n      });\n      const data = await res.json();\n      if (!res.ok) throw new Error(data.error || \'Gagal membuat pesan cepat.\');\n      setQuickOutput(data.text);\n    } catch (err: unknown) {\n      setQuickOutput(\n        err instanceof Error ? `Info API: ${err.message}` : \'Gagal memuat respons.\'\n      );\n    } finally {\n      setIsQuickLoading(false);\n    }\n  };\n\n  const handleRunMapsGrounding = async () => {\n    setIsMapsLoading(true);\n    setMapsText(\'\');\n    setMapsPlaces([]);\n    try {\n      const res = await fetch(\'/api/gemini/maps-grounding\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({ query: mapsQuery }),\n      });\n      const data = await res.json();\n      if (!res.ok) throw new Error(data.error || \'Gagal memuat Google Maps Grounding.\');\n      setMapsText(data.text);\n      setMapsPlaces(data.places || []);\n    } catch (err: unknown) {\n      setMapsText(\n        err instanceof Error ? `Info API: ${err.message}` : \'Gagal memuat data Maps.\'\n      );\n    } finally {\n      setIsMapsLoading(false);\n    }\n  };\n\n  const handleGenerateImage = async () => {\n    setIsGeneratingImg(true);\n    setImageError(\'\');\n    try {\n      const res = await fetch(\'/api/gemini/image-studio\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          prompt: imagePrompt,\n          sourceAssetPath: selectedAsset,\n          aspectRatio: \'16:9\',\n        }),\n      });\n      const data = await res.json();\n      if (!res.ok) throw new Error(data.error || \'Gagal membuat gambar promosi.\');\n      setGeneratedImg(data.imageUrl);\n    } catch (err: unknown) {\n      setImageError(\n        err instanceof Error\n          ? err.message\n          : \'Gagal membuat gambar. Pastikan API Key mendukung image generation.\'\n      );\n    } finally {\n      setIsGeneratingImg(false);\n    }\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"bg-white border border-slate-200 rounded-xl p-6\">\n        <h1 className=\"text-xl font-bold text-slate-900\">\n          AI Revenue Intelligence, Google Maps Concierge & Studio Promosi\n        </h1>\n        <p className=\"text-xs text-slate-500 mt-1\">\n          Didukung oleh Gemini 4 Argon (High Thinking), Gemini 3.8 Flash (Google Maps\n          Grounding), Gemini 3.1 Flash Lite, dan Nano Banana 2.1\n        </p>\n\n        <div className=\"flex flex-wrap items-center gap-2 mt-5 pt-4 border-t border-slate-100\">\n          {role !== UserRole.RESEPSIONIS && (\n            <button\n              type=\"button\"\n              onClick={() => setActiveTab(\'thinking_audit\')}\n              className={`inline-flex items-center gap-2 px-3.5 py-2 text-xs font-semibold rounded-lg transition-colors ${\n                activeTab === \'thinking_audit\'\n                  ? \'bg-slate-900 text-white\'\n                  : \'bg-slate-100 text-slate-700 hover:bg-slate-200\'\n              }`}\n            >\n              <BrainCircuit className=\"w-4 h-4\" />\n              <span>Konsultan P&L High-Thinking (Gemini 4 Argon)</span>\n            </button>\n          )}\n\n          <button\n            type=\"button\"\n            onClick={() => setActiveTab(\'quick_assist\')}\n            className={`inline-flex items-center gap-2 px-3.5 py-2 text-xs font-semibold rounded-lg transition-colors ${\n              activeTab === \'quick_assist\'\n                ? \'bg-slate-900 text-white\'\n                : \'bg-slate-100 text-slate-700 hover:bg-slate-200\'\n            }`}\n          >\n            <MessageSquare className=\"w-4 h-4\" />\n            <span>Asisten Cepat Resepsionis (Flash Lite)</span>\n          </button>\n\n          <button\n            type=\"button\"\n            onClick={() => setActiveTab(\'maps\')}\n            className={`inline-flex items-center gap-2 px-3.5 py-2 text-xs font-semibold rounded-lg transition-colors ${\n              activeTab === \'maps\'\n                ? \'bg-slate-900 text-white\'\n                : \'bg-slate-100 text-slate-700 hover:bg-slate-200\'\n            }`}\n          >\n            <MapPin className=\"w-4 h-4\" />\n            <span>Panduan Lokasi Google Maps Grounding</span>\n          </button>\n\n          <button\n            type=\"button\"\n            onClick={() => setActiveTab(\'image_studio\')}\n            className={`inline-flex items-center gap-2 px-3.5 py-2 text-xs font-semibold rounded-lg transition-colors ${\n              activeTab === \'image_studio\'\n                ? \'bg-slate-900 text-white\'\n                : \'bg-slate-100 text-slate-700 hover:bg-slate-200\'\n            }`}\n          >\n            <Image className=\"w-4 h-4\" />\n            <span>Studio Foto Promosi OTA (Nano Banana 2.1)</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Tab Content */}\n      {activeTab === \'thinking_audit\' && role !== UserRole.RESEPSIONIS && (\n        <div className=\"bg-white border border-slate-200 rounded-xl p-6 space-y-4\">\n          <h2 className=\"text-base font-bold text-slate-900\">\n            Audit Strategis Laporan Keuangan & Optimasi OTA (ThinkingLevel.HIGH)\n          </h2>\n          <div>\n            <label\n              htmlFor=\"audit-question-input\"\n              className=\"block text-xs font-semibold text-slate-700 mb-1\"\n            >\n              Pertanyaan Strategis untuk AI Revenue Consultant:\n            </label>\n            <input\n              id=\"audit-question-input\"\n              type=\"text\"\n              value={auditQuestion}\n              onChange={(e) => setAuditQuestion(e.target.value)}\n              className=\"w-full px-3 py-2 text-xs bg-white border border-slate-300 rounded-lg\"\n            />\n          </div>\n          <button\n            type=\"button\"\n            onClick={handleRunAudit}\n            disabled={isAuditing}\n            className=\"inline-flex items-center gap-2 px-4 py-2 text-xs font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-lg disabled:opacity-60\"\n          >\n            <Sparkles className=\"w-4 h-4\" />\n            <span>\n              {isAuditing\n                ? \'Menganalisis Laporan P&L dengan High Thinking...\'\n                : \'Jalankan Analisis Mendalam P&L\'}\n            </span>\n          </button>\n\n          {auditResult && (\n            <div className=\"p-4 bg-slate-50 border border-slate-200 rounded-lg text-xs text-slate-800 whitespace-pre-wrap leading-relaxed\">\n              <div className=\"font-mono text-[11px] text-slate-500 mb-2\">\n                Model: {auditModel}\n              </div>\n              {auditResult}\n            </div>\n          )}\n        </div>\n      )}\n\n      {activeTab === \'quick_assist\' && (\n        <div className=\"bg-white border border-slate-200 rounded-xl p-6 space-y-4\">\n          <h2 className=\"text-base font-bold text-slate-900\">\n            Generator Pesan Konfirmasi Tamu Instan (Gemini 3.1 Flash Lite)\n          </h2>\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-700 mb-1\">\n                Nama Tamu\n              </label>\n              <input\n                type=\"text\"\n                value={guestName}\n                onChange={(e) => setGuestName(e.target.value)}\n                className=\"w-full px-3 py-2 text-xs bg-white border border-slate-300 rounded-lg\"\n              />\n            </div>\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-700 mb-1\">\n                Unit Kamar\n              </label>\n              <input\n                type=\"text\"\n                value={roomName}\n                onChange={(e) => setRoomName(e.target.value)}\n                className=\"w-full px-3 py-2 text-xs bg-white border border-slate-300 rounded-lg\"\n              />\n            </div>\n          </div>\n          <button\n            type=\"button\"\n            onClick={handleRunQuickAssist}\n            disabled={isQuickLoading}\n            className=\"inline-flex items-center gap-2 px-4 py-2 text-xs font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-lg disabled:opacity-60\"\n          >\n            <span>\n              {isQuickLoading\n                ? \'Menyusun Draf Pesan...\'\n                : \'Buat Pesan WhatsApp Resepsionis\'}\n            </span>\n          </button>\n          {quickOutput && (\n            <div className=\"p-4 bg-slate-50 border border-slate-200 rounded-lg text-xs text-slate-800 whitespace-pre-wrap leading-relaxed\">\n              {quickOutput}\n            </div>\n          )}\n        </div>\n      )}\n\n      {activeTab === \'maps\' && (\n        <div className=\"bg-white border border-slate-200 rounded-xl p-6 space-y-4\">\n          <h2 className=\"text-base font-bold text-slate-900\">\n            Pencarian Tempat & Rekomendasi Area dengan Google Maps Grounding\n          </h2>\n          <div>\n            <label className=\"block text-xs font-semibold text-slate-700 mb-1\">\n              Cari Lokasi / Rekomendasi Sekitar Properti:\n            </label>\n            <input\n              type=\"text\"\n              value={mapsQuery}\n              onChange={(e) => setMapsQuery(e.target.value)}\n              className=\"w-full px-3 py-2 text-xs bg-white border border-slate-300 rounded-lg\"\n            />\n          </div>\n          <button\n            type=\"button\"\n            onClick={handleRunMapsGrounding}\n            disabled={isMapsLoading}\n            className=\"inline-flex items-center gap-2 px-4 py-2 text-xs font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-lg disabled:opacity-60\"\n          >\n            <MapPin className=\"w-4 h-4\" />\n            <span>\n              {isMapsLoading\n                ? \'Mencari Data di Google Maps...\'\n                : \'Cari dengan Google Maps Grounding\'}\n            </span>\n          </button>\n\n          {mapsText && (\n            <div className=\"p-4 bg-slate-50 border border-slate-200 rounded-lg text-xs text-slate-800 whitespace-pre-wrap leading-relaxed space-y-3\">\n              <div>{mapsText}</div>\n              {mapsPlaces.length > 0 && (\n                <div className=\"pt-3 border-t border-slate-200\">\n                  <p className=\"font-semibold text-slate-900 mb-2\">\n                    Tautan Lokasi Google Maps Terverifikasi:\n                  </p>\n                  <div className=\"flex flex-wrap gap-2\">\n                    {mapsPlaces.map((pl, idx) => (\n                      <a\n                        key={idx}\n                        href={pl.uri}\n                        target=\"_blank\"\n                        rel=\"noopener noreferrer\"\n                        className=\"underline text-blue-700 hover:text-blue-900\"\n                      >\n                        {pl.title}\n                      </a>\n                    ))}\n                  </div>\n                </div>\n              )}\n            </div>\n          )}\n        </div>\n      )}\n\n      {activeTab === \'image_studio\' && (\n        <div className=\"bg-white border border-slate-200 rounded-xl p-6 space-y-4\">\n          <h2 className=\"text-base font-bold text-slate-900\">\n            Studio Pembuatan & Edit Foto Promosi Kamar (Gemini Nano Banana 2.1)\n          </h2>\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n            <div className=\"space-y-3\">\n              <label className=\"block text-xs font-semibold text-slate-700\">\n                Pilih Foto Referensi Kamar Hotel Putri Sari:\n              </label>\n              <select\n                value={selectedAsset}\n                onChange={(e) => setSelectedAsset(e.target.value)}\n                className=\"w-full px-3 py-2 text-xs bg-white border border-slate-300 rounded-lg\"\n              >\n                <option value={HOTEL_PHOTOS.deluxeMain}>\n                  Deluxe Room (Sprei Hijau Emerald)\n                </option>\n                <option value={HOTEL_PHOTOS.standardAcBalcony}>\n                  Standard AC Room (Sprei Oranye & Balkon)\n                </option>\n                <option value={HOTEL_PHOTOS.ekonomiFan1}>\n                  Room Ekonomi Kipas (Sprei Putih)\n                </option>\n                <option value={HOTEL_PHOTOS.exterior}>\n                  Plang Depan Hotel Putri Sari\n                </option>\n              </select>\n\n              <label className=\"block text-xs font-semibold text-slate-700\">\n                Instruksi Prompt Edit / Pembuatan Gambar Promosi:\n              </label>\n              <textarea\n                rows={3}\n                value={imagePrompt}\n                onChange={(e) => setImagePrompt(e.target.value)}\n                className=\"w-full px-3 py-2 text-xs bg-white border border-slate-300 rounded-lg\"\n              />\n\n              <button\n                type=\"button\"\n                onClick={handleGenerateImage}\n                disabled={isGeneratingImg}\n                className=\"inline-flex items-center gap-2 px-4 py-2 text-xs font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-lg disabled:opacity-60\"\n              >\n                <Image className=\"w-4 h-4\" />\n                <span>\n                  {isGeneratingImg\n                    ? \'Memproses dengan Nano Banana 2.1...\'\n                    : \'Generate / Edit Foto Promosi\'}\n                </span>\n              </button>\n\n              {imageError && (\n                <p className=\"text-xs text-amber-800 bg-amber-50 border border-amber-200 p-3 rounded-lg\">\n                  {imageError}\n                </p>\n              )}\n            </div>\n\n            <div className=\"border border-slate-200 rounded-lg p-3 bg-slate-50\">\n              <p className=\"text-xs font-semibold text-slate-700 mb-2\">\n                {generatedImg ? \'Hasil Foto AI Studio:\' : \'Foto Referensi Saat Ini:\'}\n              </p>\n              <img\n                src={generatedImg || selectedAsset}\n                alt=\"Preview Kamar Hotel Putri Sari\"\n                referrerPolicy=\"no-referrer\"\n                className=\"w-full h-56 object-cover rounded-lg border border-slate-200\"\n              />\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n\nfunction reportToCompactPayload(r: MonthlyProfitLossReport) {\n  return {\n    monthKey: r.monthKey,\n    occupancyRate: `${r.occupancyRate.toFixed(1)}%`,\n    totalRoomNightsSold: r.totalRoomNightsSold,\n    totalGrossRevenue: r.totalGrossRevenue,\n    totalCommissionAmount: r.totalCommissionAmount,\n    totalNetRoomRevenue: r.totalNetRoomRevenue,\n    totalOperationalExpenses: r.totalOperationalExpenses,\n    netProfit: r.netProfit,\n    netProfitMargin: `${r.netProfitMargin.toFixed(1)}%`,\n    channels: r.channelRows,\n    expenses: r.expenseRows,\n  };\n}\n"
        path {
          absolute_uri: "file:///src/components/AiAndMapsHub.tsx"
        }
        overwrite: true
      }
    }
    action_result {
