  code_action {
    action_spec {
      create_file {
        instruction: "import React from \'react\';\nimport {\n  AppViewId,\n  MonthlyProfitLossReport,\n  ReservationRecord,\n  RoomUnit,\n  UserRole,\n} from \'../types/hms\';\nimport { formatIDR } from \'../utils/hotelCalculations\';\nimport { HOTEL_PHOTOS } from \'../data/initialData\';\nimport {\n  ArrowRight,\n  BedDouble,\n  CalendarCheck,\n  RefreshCw,\n  TrendingUp,\n  Wallet,\n} from \'lucide-react\';\n\ninterface ExecutiveDashboardProps {\n  role: UserRole;\n  rooms: RoomUnit[];\n  reservations: ReservationRecord[];\n  pnlReport: MonthlyProfitLossReport;\n  selectedMonth: string;\n  onSelectMonth: (m: string) => void;\n  onNavigate: (view: AppViewId) => void;\n  onSyncOta: () => void;\n  isSyncingOta: boolean;\n  lastOtaSync: string;\n}\n\nexport const ExecutiveDashboard: React.FC<ExecutiveDashboardProps> = ({\n  role,\n  rooms,\n  reservations,\n  pnlReport,\n  selectedMonth,\n  onSelectMonth,\n  onNavigate,\n  onSyncOta,\n  isSyncingOta,\n  lastOtaSync,\n}) => {\n  const availableCount = rooms.filter((r) => r.status === \'Available\').length;\n  const occupiedCount = rooms.filter((r) => r.status === \'Occupied\').length;\n  const dirtyCount = rooms.filter((r) => r.status === \'Dirty\').length;\n  const maintenanceCount = rooms.filter((r) => r.status === \'Maintenance\').length;\n\n  const deluxeCount = rooms.filter((r) => r.physicalCategory === \'Deluxe Room\').length;\n  const standardAcCount = rooms.filter((r) => r.physicalCategory === \'Standard AC\').length;\n  const ekonomiFanCount = rooms.filter(\n    (r) => r.physicalCategory === \'Room Ekonomi Kipas\'\n  ).length;\n\n  const maxChannelGross = Math.max(\n    1,\n    ...pnlReport.channelRows.map((c) => c.grossRevenue)\n  );\n\n  const recentReservations = reservations\n    .filter((r) => r.monthKey === selectedMonth)\n    .slice(0, 6);\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Property Showcase & Action Bar */}\n      <div className=\"bg-white border border-slate-200 rounded-xl p-6\">\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch\">\n          <div className=\"lg:col-span-8 flex flex-col justify-between space-y-4\">\n            <div className=\"space-y-2\">\n              <div className=\"flex flex-wrap items-center gap-2 text-xs text-slate-500\">\n                <span>Single Property HMS & Channel Manager</span>\n                <span aria-hidden=\"true\">\302\267</span>\n                <span>15 Unit Kamar Aktif</span>\n                <span aria-hidden=\"true\">\302\267</span>\n                <span>Sinkronisasi Terakhir: {lastOtaSync}</span>\n              </div>\n              <h1 className=\"text-2xl sm:text-3xl font-bold tracking-tight text-slate-900\">\n                Hotel Putri Sari \342\200\224 Executive Performance\n              </h1>\n              <p className=\"text-sm text-slate-600 max-w-2xl leading-relaxed\">\n                Komposisi fisik properti: {deluxeCount} Deluxe Room (AC & Sprei Hijau),{\' \'}\n                {standardAcCount} Standard AC (Sprei Oranye), dan {ekonomiFanCount} Room\n                Ekonomi Kipas (termasuk 2 unit konfigurasi Family Suite). Terintegrasi\n                otomatis dengan 6 Channel OTA dan Laporan Laba Rugi Bulanan.\n              </p>\n            </div>\n\n            <div className=\"flex flex-wrap items-center gap-3 pt-2\">\n              <div className=\"flex items-center gap-2\">\n                <label\n                  htmlFor=\"dashboard-month-select\"\n                  className=\"text-xs font-medium text-slate-600\"\n                >\n                  Periode Akuntansi:\n                </label>\n                <select\n                  id=\"dashboard-month-select\"\n                  value={selectedMonth}\n                  onChange={(e) => onSelectMonth(e.target.value)}\n                  className=\"px-3 py-2 text-xs font-mono bg-slate-50 border border-slate-300 rounded-lg text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900\"\n                >\n                  <option value=\"2026-10\">Oktober 2026 (Bulan Berjalan)</option>\n                  <option value=\"2026-09\">September 2026</option>\n                </select>\n              </div>\n\n              <button\n                type=\"button\"\n                onClick={onSyncOta}\n                disabled={isSyncingOta}\n                className=\"inline-flex items-center gap-2 px-4 py-2 text-xs font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-lg transition-colors whitespace-nowrap shrink-0 disabled:opacity-60\"\n              >\n                <RefreshCw\n                  className={`w-3.5 h-3.5 ${isSyncingOta ? \'animate-spin\' : \'\'}`}\n                />\n                <span>\n                  {isSyncingOta ? \'Menyinkronkan 6 OTA...\' : \'Sync OTA Availability\'}\n                </span>\n              </button>\n\n              {role !== UserRole.RESEPSIONIS && (\n                <button\n                  type=\"button\"\n                  onClick={() => onNavigate(\'financial_report\')}\n                  className=\"inline-flex items-center gap-2 px-4 py-2 text-xs font-semibold text-slate-800 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors whitespace-nowrap shrink-0\"\n                >\n                  <span>Buka Laporan Profit & Loss</span>\n                  <ArrowRight className=\"w-3.5 h-3.5\" />\n                </button>\n              )}\n            </div>\n          </div>\n\n          <div className=\"lg:col-span-4 relative rounded-lg overflow-hidden border border-slate-200 min-h-[180px] bg-slate-900\">\n            <img\n              src={HOTEL_PHOTOS.exterior}\n              alt=\"Tampak Depan Hotel Putri Sari\"\n              referrerPolicy=\"no-referrer\"\n              className=\"w-full h-full object-cover\"\n            />\n            <div className=\"absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent flex flex-col justify-end p-4 text-white\">\n              <p className=\"text-xs font-mono text-slate-200\">\n                JAJAPIN \302\267 HOTEL PUTRI SARI\n              </p>\n              <p className=\"text-sm font-semibold\">\n                5 Deluxe \302\267 5 Standard AC \302\267 5 Ekonomi Kipas\n              </p>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Primary KPI Grid (6 Key Metrics) */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-4\">\n        <div className=\"bg-white border border-slate-200 rounded-xl p-4\">\n          <p className=\"text-xs text-slate-500\">Occupancy Rate ({selectedMonth})</p>\n          <p\n            data-testid=\"kpi-occupancy-rate\"\n            className=\"text-xl font-bold font-mono tabular-nums text-slate-900 mt-1\"\n          >\n            {pnlReport.occupancyRate.toFixed(1)}%\n          </p>\n          <p className=\"text-xs text-slate-500 mt-1 font-mono tabular-nums\">\n            {pnlReport.totalRoomNightsSold} / {pnlReport.availableRoomNights} malam\n          </p>\n        </div>\n\n        <div className=\"bg-white border border-slate-200 rounded-xl p-4\">\n          <p className=\"text-xs text-slate-500\">Total Gross Revenue</p>\n          <p\n            data-testid=\"kpi-gross-revenue\"\n            className=\"text-xl font-bold font-mono tabular-nums text-slate-900 mt-1\"\n          >\n            {formatIDR(pnlReport.totalGrossRevenue)}\n          </p>\n          <p className=\"text-xs text-slate-500 mt-1 font-mono tabular-nums\">\n            ADR: {formatIDR(pnlReport.adr)}\n          </p>\n        </div>\n\n        <div className=\"bg-white border border-slate-200 rounded-xl p-4\">\n          <p className=\"text-xs text-slate-500\">Potongan Komisi OTA</p>\n          <p\n            data-testid=\"kpi-ota-commission\"\n            className=\"text-xl font-bold font-mono tabular-nums text-amber-700 mt-1\"\n          >\n            -{formatIDR(pnlReport.totalCommissionAmount)}\n          </p>\n          <p className=\"text-xs text-slate-500 mt-1\">\n            6 Sumber Channel Aktif\n          </p>\n        </div>\n\n        <div className=\"bg-white border border-slate-200 rounded-xl p-4\">\n          <p className=\"text-xs text-slate-500\">Net Room Revenue</p>\n          <p\n            data-testid=\"kpi-net-room-revenue\"\n            className=\"text-xl font-bold font-mono tabular-nums text-slate-900 mt-1\"\n          >\n            {formatIDR(pnlReport.totalNetRoomRevenue)}\n          </p>\n          <p className=\"text-xs text-slate-500 mt-1 font-mono tabular-nums\">\n            RevPAR: {formatIDR(pnlReport.revPar)}\n          </p>\n        </div>\n\n        <div className=\"bg-white border border-slate-200 rounded-xl p-4\">\n          <p className=\"text-xs text-slate-500\">Total Biaya Operasional</p>\n          <p\n            data-testid=\"kpi-total-expenses\"\n            className=\"text-xl font-bold font-mono tabular-nums text-rose-700 mt-1\"\n          >\n            {formatIDR(pnlReport.totalOperationalExpenses)}\n          </p>\n          <p className=\"text-xs text-slate-500 mt-1\">\n            7 Kategori Biaya & Depresiasi\n          </p>\n        </div>\n\n        <div className=\"bg-slate-900 text-white border border-slate-900 rounded-xl p-4\">\n          <p className=\"text-xs text-slate-300\">NET PROFIT AKHIR</p>\n          <p\n            data-testid=\"kpi-net-profit\"\n            className=\"text-xl font-bold font-mono tabular-nums text-emerald-400 mt-1\"\n          >\n            {formatIDR(pnlReport.netProfit)}\n          </p>\n          <p className=\"text-xs text-slate-300 mt-1 font-mono tabular-nums\">\n            Margin: {pnlReport.netProfitMargin.toFixed(1)}%\n          </p>\n        </div>\n      </div>\n\n      {/* Middle Split: Channel Performance Chart & Real-Time Housekeeping Status */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n        {/* Perbandingan Pendapatan per Channel OTA */}\n        <div className=\"lg:col-span-7 bg-white border border-slate-200 rounded-xl p-6\">\n          <div className=\"flex flex-wrap items-center justify-between gap-2 pb-4 border-b border-slate-100\">\n            <div>\n              <h2 className=\"text-base font-bold text-slate-900\">\n                Grafik Performa Pendapatan per Channel OTA ({selectedMonth})\n              </h2>\n              <p className=\"text-xs text-slate-500\">\n                Perbandingan Gross Revenue, Potongan Komisi OTA, dan Net Room Revenue\n              </p>\n            </div>\n            <button\n              type=\"button\"\n              onClick={() => onNavigate(\'reservations\')}\n              className=\"text-xs font-semibold text-slate-700 hover:text-slate-900 underline whitespace-nowrap shrink-0\"\n            >\n              Kelola Reservasi & OTA\n            </button>\n          </div>\n\n          <div className=\"space-y-4 mt-5\">\n            {pnlReport.channelRows.map((row) => {\n              const widthPct = Math.max(\n                4,\n                Math.round((row.grossRevenue / maxChannelGross) * 100)\n              );\n              const netRatio =\n                row.grossRevenue > 0\n                  ? Math.round((row.netRevenue / row.grossRevenue) * 100)\n                  : 100;\n\n              return (\n                <div key={row.channel} className=\"space-y-1.5\">\n                  <div className=\"flex items-center justify-between text-xs\">\n                    <div className=\"flex items-center gap-2\">\n                      <span className=\"font-semibold text-slate-900\">\n                        {row.channel}\n                      </span>\n                      <span className=\"text-slate-400\" aria-hidden=\"true\">\n                        \302\267\n                      </span>\n                      <span className=\"text-slate-500 font-mono tabular-nums\">\n                        {row.roomNights} malam ({row.bookingsCount} booking)\n                      </span>\n                      <span className=\"text-slate-400\" aria-hidden=\"true\">\n                        \302\267\n                      </span>\n                      <span className=\"text-slate-500 font-mono tabular-nums\">\n                        Komisi {row.commissionRate}%\n                      </span>\n                    </div>\n                    <div className=\"text-right font-mono tabular-nums\">\n                      <span className=\"text-slate-500\">\n                        Gross {formatIDR(row.grossRevenue)}\n                      </span>\n                      <span className=\"mx-1.5 text-slate-300\">/</span>\n                      <span className=\"font-semibold text-emerald-700\">\n                        Net {formatIDR(row.netRevenue)}\n                      </span>\n                    </div>\n                  </div>\n\n                  <div className=\"w-full h-3 bg-slate-100 rounded overflow-hidden\">\n                    <div\n                      className=\"h-full flex rounded overflow-hidden transition-all duration-200\"\n                      style={{ width: `${widthPct}%` }}\n                    >\n                      <div\n                        className=\"bg-slate-900 h-full\"\n                        style={{ width: `${netRatio}%` }}\n                        title={`Net Revenue: ${formatIDR(row.netRevenue)}`}\n                      />\n                      <div\n                        className=\"bg-amber-500 h-full\"\n                        style={{ width: `${100 - netRatio}%` }}\n                        title={`Potongan Komisi: ${formatIDR(row.commissionAmount)}`}\n                      />\n                    </div>\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n\n          <div className=\"flex items-center gap-6 mt-5 pt-4 border-t border-slate-100 text-xs text-slate-600\">\n            <div className=\"flex items-center gap-2\">\n              <span className=\"inline-block w-3 h-3 rounded-xs bg-slate-900\" />\n              <span>Net Room Revenue (Pendapatan Bersih)</span>\n            </div>\n            <div className=\"flex items-center gap-2\">\n              <span className=\"inline-block w-3 h-3 rounded-xs bg-amber-500\" />\n              <span>Potongan Komisi OTA (14% \342\200\223 18%)</span>\n            </div>\n          </div>\n        </div>\n\n        {/* Status Ketersediaan & Housekeeping 15 Kamar */}\n        <div className=\"lg:col-span-5 bg-white border border-slate-200 rounded-xl p-6 flex flex-col justify-between\">\n          <div>\n            <div className=\"flex items-center justify-between pb-4 border-b border-slate-100\">\n              <div>\n                <h2 className=\"text-base font-bold text-slate-900\">\n                  Status Real-Time 15 Kamar\n                </h2>\n                <p className=\"text-xs text-slate-500\">\n                  Ringkasan ketersediaan & housekeeping hari ini\n                </p>\n              </div>\n              <button\n                type=\"button\"\n                onClick={() => onNavigate(\'calendar\')}\n                className=\"text-xs font-semibold text-slate-700 hover:text-slate-900 underline whitespace-nowrap shrink-0\"\n              >\n                Buka Kalender Kamar\n              </button>\n            </div>\n\n            <div className=\"grid grid-cols-2 gap-3 mt-4\">\n              <div className=\"p-3.5 bg-emerald-50/70 border border-emerald-200 rounded-lg\">\n                <p className=\"text-xs font-medium text-emerald-900\">\n                  Available (Siap Jual)\n                </p>\n                <p className=\"text-2xl font-bold font-mono tabular-nums text-emerald-800 mt-1\">\n                  {availableCount} <span className=\"text-xs font-normal\">unit</span>\n                </p>\n              </div>\n              <div className=\"p-3.5 bg-blue-50/70 border border-blue-200 rounded-lg\">\n                <p className=\"text-xs font-medium text-blue-900\">\n                  Occupied (Terisi Tamu)\n                </p>\n                <p className=\"text-2xl font-bold font-mono tabular-nums text-blue-800 mt-1\">\n                  {occupiedCount} <span className=\"text-xs font-normal\">unit</span>\n                </p>\n              </div>\n              <div className=\"p-3.5 bg-amber-50/70 border border-amber-200 rounded-lg\">\n                <p className=\"text-xs font-medium text-amber-900\">\n                  Dirty (Perlu Dibersihkan)\n                </p>\n                <p className=\"text-2xl font-bold font-mono tabular-nums text-amber-800 mt-1\">\n                  {dirtyCount} <span className=\"text-xs font-normal\">unit</span>\n                </p>\n              </div>\n              <div className=\"p-3.5 bg-rose-50/70 border border-rose-200 rounded-lg\">\n                <p className=\"text-xs font-medium text-rose-900\">\n                  Maintenance (Perbaikan)\n                </p>\n                <p className=\"text-2xl font-bold font-mono tabular-nums text-rose-800 mt-1\">\n                  {maintenanceCount} <span className=\"text-xs font-normal\">unit</span>\n                </p>\n              </div>\n            </div>\n\n            <div className=\"mt-5 pt-4 border-t border-slate-100 space-y-2.5 text-xs\">\n              <p className=\"font-semibold text-slate-900\">\n                Struktur Rate Plan & Unit Properti (Total 15 Kamar):\n              </p>\n              <div className=\"flex items-center justify-between text-slate-600\">\n                <span>Standard Room (8 unit: Standard AC & Ekonomi Kipas)</span>\n                <span className=\"font-mono tabular-nums text-slate-900\">\n                  Rp 300rb / Rp 350rb\n                </span>\n              </div>\n              <div className=\"flex items-center justify-between text-slate-600\">\n                <span>Deluxe Room (5 unit: Include Breakfast)</span>\n                <span className=\"font-mono tabular-nums text-slate-900\">\n                  Rp 450rb / Rp 525rb\n                </span>\n              </div>\n              <div className=\"flex items-center justify-between text-slate-600\">\n                <span>Family Suite (2 unit: All Day Include Breakfast)</span>\n                <span className=\"font-mono tabular-nums text-slate-900\">\n                  Rp 750.000\n                </span>\n              </div>\n            </div>\n          </div>\n\n          <div className=\"mt-5 pt-4 border-t border-slate-100 flex items-center justify-between gap-2\">\n            <button\n              type=\"button\"\n              onClick={() => onNavigate(\'reservations\')}\n              className=\"w-full py-2.5 px-4 text-xs font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-lg transition-colors\"\n            >\n              + Input Reservasi Baru\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* Recent Bookings Ledger */}\n      <div className=\"bg-white border border-slate-200 rounded-xl p-6\">\n        <div className=\"flex flex-wrap items-center justify-between gap-2 pb-4 border-b border-slate-100\">\n          <div>\n            <h2 className=\"text-base font-bold text-slate-900\">\n              Daftar Reservasi Terbaru ({selectedMonth})\n            </h2>\n            <p className=\"text-xs text-slate-500\">\n              Otomatis menghitung Gross Revenue, Potongan Komisi OTA, dan Net Room Revenue\n            </p>\n          </div>\n          <button\n            type=\"button\"\n            onClick={() => onNavigate(\'reservations\')}\n            className=\"text-xs font-semibold text-slate-700 hover:text-slate-900 underline\"\n          >\n            Lihat Semua Reservasi ({reservations.filter((r) => r.monthKey === selectedMonth).length})\n          </button>\n        </div>\n\n        <div className=\"overflow-x-auto mt-4\">\n          <table className=\"w-full text-left border-collapse\">\n            <thead>\n              <tr className=\"border-b border-slate-200 text-xs font-semibold text-slate-500\">\n                <th className=\"py-2.5 pr-4\">Kode & Tamu</th>\n                <th className=\"py-2.5 px-3\">Kamar</th>\n                <th className=\"py-2.5 px-3\">Check-In / Out</th>\n                <th className=\"py-2.5 px-3\">Channel OTA</th>\n                <th className=\"py-2.5 px-3 text-right\">Gross Revenue</th>\n                <th className=\"py-2.5 px-3 text-right\">Potongan Komisi</th>\n                <th className=\"py-2.5 pl-3 text-right\">Net Room Revenue</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-100 text-xs\">\n              {recentReservations.map((res) => (\n                <tr key={res.id} className=\"hover:bg-slate-50\">\n                  <td className=\"py-3 pr-4\">\n                    <div className=\"font-semibold text-slate-900\">{res.guestName}</div>\n                    <div className=\"text-slate-500 font-mono\">\n                      {res.bookingCode} \302\267 {res.status}\n                    </div>\n                  </td>\n                  <td className=\"py-3 px-3\">\n                    <div className=\"font-medium text-slate-900\">\n                      Kamar {res.roomNumber}\n                    </div>\n                    <div className=\"text-slate-500\">{res.roomType}</div>\n                  </td>\n                  <td className=\"py-3 px-3 font-mono tabular-nums text-slate-600\">\n                    {res.checkIn} \342\206\222 {res.checkOut} ({res.nights} mlm)\n                  </td>\n                  <td className=\"py-3 px-3\">\n                    <span className=\"font-medium text-slate-900\">{res.channel}</span>\n                    <span className=\"text-slate-500 font-mono ml-1\">\n                      ({res.commissionRate}%)\n                    </span>\n                  </td>\n                  <td className=\"py-3 px-3 text-right font-mono tabular-nums text-slate-900\">\n                    {formatIDR(res.grossRevenue)}\n                  </td>\n                  <td className=\"py-3 px-3 text-right font-mono tabular-nums text-amber-700\">\n                    -{formatIDR(res.commissionAmount)}\n                  </td>\n                  <td className=\"py-3 pl-3 text-right font-mono tabular-nums font-semibold text-emerald-700\">\n                    {formatIDR(res.netRevenue)}\n                  </td>\n                </tr>\n              ))}\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/ExecutiveDashboard.tsx"
        }
        overwrite: true
      }
