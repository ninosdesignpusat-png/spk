  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport {\n  PhysicalRoomCategory,\n  RatePlanType,\n  ReservationRecord,\n  RoomStatus,\n  RoomUnit,\n} from \'../types/hms\';\nimport { formatIDR } from \'../utils/hotelCalculations\';\nimport { HOTEL_PHOTOS } from \'../data/initialData\';\nimport { Calendar, CheckCircle2, Image, Sparkles, Wrench } from \'lucide-react\';\n\ninterface RoomCalendarAndHousekeepingProps {\n  rooms: RoomUnit[];\n  reservations: ReservationRecord[];\n  onUpdateRoomStatus: (roomId: string, newStatus: RoomStatus) => void;\n  onQuickBookRoom: (roomId: string) => void;\n}\n\nconst OCT_DATES = [\n  \'2026-10-20\',\n  \'2026-10-21\',\n  \'2026-10-22\',\n  \'2026-10-23\',\n  \'2026-10-24\',\n  \'2026-10-25\',\n  \'2026-10-26\',\n  \'2026-10-27\',\n  \'2026-10-28\',\n  \'2026-10-29\',\n  \'2026-10-30\',\n  \'2026-10-31\',\n];\n\nexport const RoomCalendarAndHousekeeping: React.FC<\n  RoomCalendarAndHousekeepingProps\n> = ({ rooms, reservations, onUpdateRoomStatus, onQuickBookRoom }) => {\n  const [filterType, setFilterType] = useState<\'ALL\' | RatePlanType>(\'ALL\');\n  const [filterPhysical, setFilterPhysical] = useState<\n    \'ALL\' | PhysicalRoomCategory\n  >(\'ALL\');\n  const [filterStatus, setFilterStatus] = useState<\'ALL\' | RoomStatus>(\'ALL\');\n  const [showGalleryModal, setShowGalleryModal] = useState(false);\n\n  const filteredRooms = rooms.filter((r) => {\n    if (filterType !== \'ALL\' && r.type !== filterType) return false;\n    if (filterPhysical !== \'ALL\' && r.physicalCategory !== filterPhysical)\n      return false;\n    if (filterStatus !== \'ALL\' && r.status !== filterStatus) return false;\n    return true;\n  });\n\n  const getReservationForRoomOnDate = (roomId: string, dateStr: string) => {\n    return reservations.find(\n      (res) =>\n        res.roomId === roomId &&\n        res.status !== \'Cancelled\' &&\n        res.checkIn <= dateStr &&\n        res.checkOut > dateStr\n    );\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Header & Filter Controls */}\n      <div className=\"bg-white border border-slate-200 rounded-xl p-6\">\n        <div className=\"flex flex-wrap items-start justify-between gap-4\">\n          <div>\n            <h1 className=\"text-xl font-bold text-slate-900\">\n              Kalender Kamar & Status Housekeeping (15 Unit)\n            </h1>\n            <p className=\"text-xs text-slate-500 mt-1\">\n              5 Deluxe Room (AC) \302\267 5 Standard AC \302\267 5 Room Ekonomi Kipas (Skema Rate Plan:\n              8 Standard, 5 Deluxe, 2 Family Suite)\n            </p>\n          </div>\n\n          <button\n            type=\"button\"\n            onClick={() => setShowGalleryModal(!showGalleryModal)}\n            className=\"inline-flex items-center gap-2 px-3.5 py-2 text-xs font-semibold text-slate-800 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors\"\n          >\n            <Image className=\"w-4 h-4\" />\n            <span>\n              {showGalleryModal\n                ? \'Tutup Galeri Foto Asli Properti\'\n                : \'Lihat 9 Foto Asli Hotel Putri Sari\'}\n            </span>\n          </button>\n        </div>\n\n        {/* Authentic Property Photo Strip (Collapsible) */}\n        {showGalleryModal && (\n          <div className=\"mt-5 pt-5 border-t border-slate-200\">\n            <h2 className=\"text-xs font-semibold text-slate-700 mb-3\">\n              Dokumentasi Fisik Kamar & Eksterior Hotel Putri Sari (Jajapin)\n            </h2>\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4\">\n              {[\n                {\n                  src: HOTEL_PHOTOS.exterior,\n                  title: \'Plang & Gerbang Hotel Putri Sari\',\n                  desc: \'Akses jalan utama & area parkir luas\',\n                },\n                {\n                  src: HOTEL_PHOTOS.deluxeMain,\n                  title: \'Deluxe Room (5 Unit \342\200\224 201 s/d 205)\',\n                  desc: \'King Bed Sprei Hijau, AC Split, TV LED, Lemari & Meja Rias\',\n                },\n                {\n                  src: HOTEL_PHOTOS.deluxeWide,\n                  title: \'Interior Deluxe Room (Sudut Lebar)\',\n                  desc: \'Weekday Rp 450.000 \302\267 Weekend Rp 525.000 (Include Breakfast)\',\n                },\n                {\n                  src: HOTEL_PHOTOS.standardAcBalcony,\n                  title: \'Standard AC Room (5 Unit \342\200\224 101 s/d 105)\',\n                  desc: \'Queen Bed Sprei Oranye, AC Split & Akses Balkon\',\n                },\n                {\n                  src: HOTEL_PHOTOS.standardAcRoom,\n                  title: \'Interior Standard AC Room\',\n                  desc: \'Weekday Rp 300.000 \302\267 Weekend Rp 350.000 (Room Only)\',\n                },\n                {\n                  src: HOTEL_PHOTOS.ekonomiFan1,\n                  title: \'Room Ekonomi Kipas (5 Unit \342\200\224 106-108, 301-302)\',\n                  desc: \'Sprei Putih, Kipas Angin Dinding & Kursi Duduk Santai\',\n                },\n                {\n                  src: HOTEL_PHOTOS.ekonomiFan2,\n                  title: \'Kamar Ekonomi Kipas / Family Suite\',\n                  desc: \'Tersedia opsi Standard & Family Suite\',\n                },\n                {\n                  src: HOTEL_PHOTOS.deluxeBed,\n                  title: \'Detail Tempat Tidur Deluxe Room\',\n                  desc: \'Sandaran kulit sintetis hitam & bantal ganda\',\n                },\n                {\n                  src: HOTEL_PHOTOS.bathroom,\n                  title: \'Kamar Mandi Dalam (Shower & Closet Duduk)\',\n                  desc: \'Keramik bersih & fasilitas shower air bersih\',\n                },\n              ].map((item) => (\n                <div\n                  key={item.title}\n                  className=\"border border-slate-200 rounded-lg overflow-hidden bg-slate-50\"\n                >\n                  <img\n                    src={item.src}\n                    alt={item.title}\n                    referrerPolicy=\"no-referrer\"\n                    className=\"w-full h-44 object-cover\"\n                  />\n                  <div className=\"p-3\">\n                    <p className=\"text-xs font-semibold text-slate-900\">\n                      {item.title}\n                    </p>\n                    <p className=\"text-xs text-slate-500 mt-0.5\">{item.desc}</p>\n                  </div>\n                </div>\n              ))}\n            </div>\n          </div>\n        )}\n\n        {/* Filter Bar */}\n        <div className=\"mt-5 pt-4 border-t border-slate-100 flex flex-wrap items-center justify-between gap-4\">\n          <div className=\"flex flex-wrap items-center gap-2\">\n            <span className=\"text-xs font-medium text-slate-500\">\n              Filter Fisik Kamar:\n            </span>\n            {(\n              [\n                { id: \'ALL\', label: \'Semua (15)\' },\n                { id: \'Deluxe Room\', label: \'Deluxe Room (5)\' },\n                { id: \'Standard AC\', label: \'Standard AC (5)\' },\n                { id: \'Room Ekonomi Kipas\', label: \'Ekonomi Kipas (5)\' },\n              ] as const\n            ).map((btn) => (\n              <button\n                key={btn.id}\n                type=\"button\"\n                onClick={() => setFilterPhysical(btn.id)}\n                className={`px-3 py-1.5 text-xs font-medium rounded-md transition-colors whitespace-nowrap shrink-0 ${\n                  filterPhysical === btn.id\n                    ? \'bg-slate-900 text-white\'\n                    : \'bg-slate-100 text-slate-700 hover:bg-slate-200\'\n                }`}\n              >\n                {btn.label}\n              </button>\n            ))}\n          </div>\n\n          <div className=\"flex flex-wrap items-center gap-2\">\n            <span className=\"text-xs font-medium text-slate-500\">\n              Rate Plan:\n            </span>\n            {(\n              [\n                { id: \'ALL\', label: \'Semua Rate\' },\n                { id: \'Standard Room\', label: \'Standard (8)\' },\n                { id: \'Deluxe Room\', label: \'Deluxe (5)\' },\n                { id: \'Family Suite\', label: \'Family Suite (2)\' },\n              ] as const\n            ).map((btn) => (\n              <button\n                key={btn.id}\n                type=\"button\"\n                onClick={() => setFilterType(btn.id)}\n                className={`px-3 py-1.5 text-xs font-medium rounded-md transition-colors whitespace-nowrap shrink-0 ${\n                  filterType === btn.id\n                    ? \'bg-slate-900 text-white\'\n                    : \'bg-slate-100 text-slate-700 hover:bg-slate-200\'\n                }`}\n              >\n                {btn.label}\n              </button>\n            ))}\n          </div>\n\n          <div className=\"flex flex-wrap items-center gap-2\">\n            <span className=\"text-xs font-medium text-slate-500\">Status:</span>\n            {([\'ALL\', \'Available\', \'Occupied\', \'Dirty\', \'Maintenance\'] as const).map(\n              (st) => (\n                <button\n                  key={st}\n                  type=\"button\"\n                  onClick={() => setFilterStatus(st)}\n                  className={`px-2.5 py-1.5 text-xs font-medium rounded-md transition-colors whitespace-nowrap shrink-0 ${\n                    filterStatus === st\n                      ? \'bg-slate-900 text-white\'\n                      : \'bg-slate-100 text-slate-700 hover:bg-slate-200\'\n                  }`}\n                >\n                  {st === \'ALL\' ? \'Semua Status\' : st}\n                </button>\n              )\n            )}\n          </div>\n        </div>\n      </div>\n\n      {/* Interactive Tape Chart / Kalender Ketersediaan Kamar (20 - 31 Oktober 2026) */}\n      <div className=\"bg-white border border-slate-200 rounded-xl p-6\">\n        <div className=\"flex flex-wrap items-center justify-between gap-2 mb-4\">\n          <div>\n            <h2 className=\"text-base font-bold text-slate-900\">\n              Tabel Kalender Okupansi Kamar (20 \342\200\223 31 Oktober 2026)\n            </h2>\n            <p className=\"text-xs text-slate-500\">\n              Pantau jadwal hunian per nomor kamar dan sumber OTA secara visual\n            </p>\n          </div>\n          <div className=\"flex items-center gap-4 text-xs text-slate-600\">\n            <span>Jum & Sab = Tarif Weekend</span>\n            <span aria-hidden=\"true\">\302\267</span>\n            <span>Min\342\200\223Kam = Tarif Weekday</span>\n          </div>\n        </div>\n\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full border-collapse text-xs\">\n            <thead>\n              <tr className=\"border-b border-slate-200 bg-slate-50\">\n                <th className=\"py-2.5 px-3 text-left font-semibold text-slate-700 min-w-[180px]\">\n                  Unit Kamar & Tipe\n                </th>\n                <th className=\"py-2.5 px-2 text-left font-semibold text-slate-700\">\n                  Status HK\n                </th>\n                {OCT_DATES.map((d) => {\n                  const dayNum = d.slice(8, 10);\n                  const dayOfWeek = new Date(`${d}T00:00:00Z`).getUTCDay();\n                  const isWeekend = dayOfWeek === 5 || dayOfWeek === 6;\n                  return (\n                    <th\n                      key={d}\n                      className={`py-2 px-1.5 text-center font-mono ${\n                        isWeekend\n                          ? \'bg-amber-50 text-amber-900 font-bold\'\n                          : \'text-slate-600\'\n                      }`}\n                    >\n                      <div>Okt</div>\n                      <div>{dayNum}</div>\n                    </th>\n                  );\n                })}\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-100\">\n              {filteredRooms.map((room) => (\n                <tr key={room.id} className=\"hover:bg-slate-50/80\">\n                  <td className=\"py-2.5 px-3\">\n                    <div className=\"font-semibold text-slate-900\">\n                      Kamar {room.roomNumber} \302\267 {room.physicalCategory}\n                    </div>\n                    <div className=\"text-slate-500\">\n                      {room.type} \302\267 {formatIDR(room.weekdayRate)}\n                    </div>\n                  </td>\n                  <td className=\"py-2.5 px-2 font-medium text-slate-700\">\n                    {room.status}\n                  </td>\n                  {OCT_DATES.map((d) => {\n                    const activeRes = getReservationForRoomOnDate(room.id, d);\n                    return (\n                      <td\n                        key={d}\n                        className=\"p-1 text-center border-l border-slate-100\"\n                      >\n                        {activeRes ? (\n                          <div\n                            title={`${activeRes.guestName} (${activeRes.channel})`}\n                            className=\"px-1 py-1.5 rounded bg-slate-900 text-white text-[10px] font-medium truncate max-w-[68px] mx-auto\"\n                          >\n                            {activeRes.guestName.split(\' \')[0]}\n                          </div>\n                        ) : (\n                          <button\n                            type=\"button\"\n                            onClick={() => onQuickBookRoom(room.id)}\n                            title={`Input reservasi Kamar ${room.roomNumber} tanggal ${d}`}\n                            className=\"w-full py-1.5 rounded text-[10px] text-slate-400 hover:bg-emerald-50 hover:text-emerald-700 transition-colors\"\n                          >\n                            Kosong\n                          </button>\n                        )}\n                      </td>\n                    );\n                  })}\n                </tr>\n              ))}\n            </tbody>\n          </table>\n        </div>\n      </div>\n\n      {/* 15 Room Cards with Quick Housekeeping Controls */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4\">\n        {filteredRooms.map((room) => (\n          <div\n            key={room.id}\n            data-testid={`room-card-${room.roomNumber}`}\n            className=\"bg-white border border-slate-200 rounded-xl overflow-hidden flex flex-col justify-between\"\n          >\n            <div>\n              <div className=\"relative h-40 bg-slate-900\">\n                <img\n                  src={room.photoUrl}\n                  alt={room.name}\n                  referrerPolicy=\"no-referrer\"\n                  className=\"w-full h-full object-cover\"\n                />\n                <div className=\"absolute inset-0 bg-gradient-to-t from-black/75 via-black/20 to-transparent flex flex-col justify-end p-3.5 text-white\">\n                  <div className=\"flex items-center justify-between\">\n                    <span className=\"text-xs font-mono text-slate-200\">\n                      UNIT {room.roomNumber} \302\267 LANTAI {room.floor}\n                    </span>\n                    <span className=\"text-xs font-semibold\">\n                      Status: {room.status}\n                    </span>\n                  </div>\n                  <h3 className=\"text-base font-bold\">{room.name}</h3>\n                </div>\n              </div>\n\n              <div className=\"p-4 space-y-2.5 text-xs\">\n                <div className=\"flex items-center justify-between text-slate-600\">\n                  <span>Kategori Fisik & Fasilitas</span>\n                  <span className=\"font-medium text-slate-900\">\n                    {room.physicalCategory} \302\267 {room.cooling}\n                  </span>\n                </div>\n                <div className=\"flex items-center justify-between text-slate-600\">\n                  <span>Skema Rate Plan</span>\n                  <span className=\"font-medium text-slate-900\">\n                    {room.type} ({room.includesBreakfast ? \'Include Breakfast\' : \'Room Only\'})\n                  </span>\n                </div>\n                <div className=\"flex items-center justify-between text-slate-600\">\n                  <span>Harga Weekday / Weekend</span>\n                  <span className=\"font-mono tabular-nums font-semibold text-slate-900\">\n                    {formatIDR(room.weekdayRate)} / {formatIDR(room.weekendRate)}\n                  </span>\n                </div>\n                <div className=\"flex items-center justify-between text-slate-600\">\n                  <span>Tamu Saat Ini</span>\n                  <span className=\"font-medium text-slate-900\">\n                    {room.currentGuest || \'Tidak ada tamu\'}\n                  </span>\n                </div>\n              </div>\n            </div>\n\n            <div className=\"p-4 pt-3 border-t border-slate-100 bg-slate-50/60 space-y-2.5\">\n              <div className=\"text-[11px] font-semibold text-slate-500\">\n                Ubah Status Housekeeping Kamar {room.roomNumber}:\n              </div>\n              <div className=\"grid grid-cols-4 gap-1.5\">\n                {(\n                  [\'Available\', \'Occupied\', \'Dirty\', \'Maintenance\'] as RoomStatus[]\n                ).map((st) => (\n                  <button\n                    key={st}\n                    type=\"button\"\n                    aria-label={`Set Kamar ${room.roomNumber} status ${st}`}\n                    onClick={() => onUpdateRoomStatus(room.id, st)}\n                    className={`py-1.5 px-2 text-[11px] font-semibold rounded transition-colors whitespace-nowrap truncate ${\n                      room.status === st\n                        ? \'bg-slate-900 text-white\'\n                        : \'bg-white border border-slate-200 text-slate-700 hover:bg-slate-100\'\n                    }`}\n                  >\n                    {st}\n                  </button>\n                ))}\n              </div>\n            </div>\n          </div>\n        ))}\n      </div>\n    </div>\n  );\n};\n"
