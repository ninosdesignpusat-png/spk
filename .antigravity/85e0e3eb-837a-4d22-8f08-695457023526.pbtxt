      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Ensure single-line formatting and clean zero commission display in ProfitLossStatementView.tsx\", \"EndLine\":166, \"Instruction\":\"Update Bagian A table cells and footer in ProfitLossStatementView.tsx to prevent wrapping and format 0 commission cleanly\", \"ReplacementContent\":\"                  <td className=\\\"py-3 px-4 text-right font-mono tabular-nums text-slate-600 whitespace-nowrap\\\">\\n                    {row.commissionRate}%\\n                  </td>\\n                  <td className=\\\"py-3 px-4 text-right font-mono tabular-nums text-amber-700 whitespace-nowrap\\\">\\n                    {row.commissionAmount > 0\\n                      ? `-${formatIDR(row.commissionAmount)}`\\n                      : formatIDR(0)}\\n                  </td>\\n                  <td className=\\\"py-3 px-4 text-right font-mono tabular-nums font-semibold text-emerald-700 whitespace-nowrap\\\">\\n                    {formatIDR(row.netRevenue)}\\n                  </td>\\n                </tr>\\n              ))}\\n            </tbody>\\n            <tfoot>\\n              <tr className=\\\"bg-slate-900 text-white font-bold text-xs\\\">\\n                <td className=\\\"py-3.5 px-4 whitespace-nowrap\\\">\\n                  TOTAL PENDAPATAN KAMAR (BAGIAN A)\\n                </td>\\n                <td className=\\\"py-3.5 px-4 text-right font-mono tabular-nums whitespace-nowrap\\\">\\n                  {report.totalRoomNightsSold} malam\\n                </td>\\n                <td className=\\\"py-3.5 px-4 text-right font-mono tabular-nums whitespace-nowrap\\\">\\n                  {formatIDR(report.totalGrossRevenue)}\\n                </td>\\n                <td className=\\\"py-3.5 px-4 text-right font-mono tabular-nums whitespace-nowrap\\\">\\n                  Rata-rata{\' \'}\\n                  {report.totalGrossRevenue > 0\\n                    ? (\\n                        (report.totalCommissionAmount /\\n                          report.totalGrossRevenue) *\\n                        100\\n                      ).toFixed(1)\\n                    : \'0.0\'}\\n                  %\\n                </td>\\n                <td className=\\\"py-3.5 px-4 text-right font-mono tabular-nums text-amber-300 whitespace-nowrap\\\">\\n                  -{formatIDR(report.totalCommissionAmount)}\\n                </td>\\n                <td className=\\\"py-3.5 px-4 text-right font-mono tabular-nums text-emerald-400 whitespace-nowrap\\\">\\n                  {formatIDR(report.totalNetRoomRevenue)}\\n                </td>\\n              </tr>\\n            </tfoot>\", \"StartLine\":121, \"TargetContent\":\"                  <td className=\\\"py-3 px-4 text-right font-mono tabular-nums text-slate-600\\\">\\n                    {row.commissionRate}%\\n                  </td>\\n                  <td className=\\\"py-3 px-4 text-right font-mono tabular-nums text-amber-700\\\">\\n                    -{formatIDR(row.commissionAmount)}\\n                  </td>\\n                  <td className=\\\"py-3 px-4 text-right font-mono tabular-nums font-semibold text-emerald-700\\\">\\n                    {formatIDR(row.netRevenue)}\\n                  </td>\\n                </tr>\\n              ))}\\n            </tbody>\\n            <tfoot>\\n              <tr className=\\\"bg-slate-900 text-white font-bold text-xs\\\">\\n                <td className=\\\"py-3.5 px-4\\\">TOTAL PENDAPATAN KAMAR (BAGIAN A)</td>\\n                <td className=\\\"py-3.5 px-4 text-right font-mono tabular-nums\\\">\\n                  {report.totalRoomNightsSold} malam\\n                </td>\\n                <td className=\\\"py-3.5 px-4 text-right font-mono tabular-nums\\\">\\n                  {formatIDR(report.totalGrossRevenue)}\\n                </td>\\n                <td className=\\\"py-3.5 px-4 text-right font-mono tabular-nums\\\">\\n                  {report.totalGrossRevenue > 0\\n