        instruction: "import React from \'react\';\nimport { MonthlyProfitLossReport } from \'../types/hms\';\nimport {\n  exportProfitLossToCsv,\n  formatIDR,\n} from \'../utils/hotelCalculations\';\nimport { Download, Printer } from \'lucide-react\';\n\ninterface ProfitLossStatementViewProps {\n  report: MonthlyProfitLossReport;\n  selectedMonth: string;\n  onSelectMonth: (monthKey: string) => void;\n}\n\nexport const ProfitLossStatementView: React.FC<\n  ProfitLossStatementViewProps\n> = ({ report, selectedMonth, onSelectMonth }) => {\n  const maxGross = Math.max(\n    1,\n    ...report.channelRows.map((c) => c.grossRevenue)\n  );\n\n  const handleDownloadCsv = () => {\n    const csvContent = exportProfitLossToCsv(report);\n    const blob = new Blob([csvContent], { type: \'text/csv;charset=utf-8;\' });\n    const url = URL.createObjectURL(blob);\n    const a = document.createElement(\'a\');\n    a.href = url;\n    a.download = `Laporan-Keuangan-PnL-Hotel-Putri-Sari-${report.monthKey}.csv`;\n    document.body.appendChild(a);\n    a.click();\n    document.body.removeChild(a);\n    URL.revokeObjectURL(url);\n  };\n\n  const handlePrintPdf = () => {\n    window.print();\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Top Action & Filter Header */}\n      <div className=\"bg-white border border-slate-200 rounded-xl p-6 flex flex-wrap items-center justify-between gap-4\">\n        <div>\n          <p className=\"text-xs font-mono text-slate-500\">\n            HOTEL PUTRI SARI (15 KAMAR) \302\267 LAPORAN AKUNTANSI BULANAN OTOMATIS\n          </p>\n          <h1 className=\"text-xl font-bold text-slate-900 mt-0.5\">\n            Laporan Laba Rugi (Profit & Loss Statement) \342\200\224 Periode {selectedMonth}\n          </h1>\n        </div>\n\n        <div className=\"flex flex-wrap items-center gap-3 no-print\">\n          <div className=\"flex items-center gap-2\">\n            <label\n              htmlFor=\"pnl-month-select\"\n              className=\"text-xs font-semibold text-slate-700\"\n            >\n              Filter Bulan & Tahun:\n            </label>\n            <select\n              id=\"pnl-month-select\"\n              value={selectedMonth}\n              onChange={(e) => onSelectMonth(e.target.value)}\n              className=\"px-3 py-2 text-xs font-mono bg-slate-50 border border-slate-300 rounded-lg text-slate-900\"\n            >\n              <option value=\"2026-10\">Oktober 2026</option>\n              <option value=\"2026-09\">September 2026</option>\n            </select>\n          </div>\n\n          <button\n            type=\"button\"\n            onClick={handleDownloadCsv}\n            className=\"inline-flex items-center gap-2 px-4 py-2 text-xs font-semibold text-slate-800 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors whitespace-nowrap shrink-0\"\n          >\n            <Download className=\"w-3.5 h-3.5\" />\n            <span>Export CSV</span>\n          </button>\n\n          <button\n            type=\"button\"\n            onClick={handlePrintPdf}\n            className=\"inline-flex items-center gap-2 px-4 py-2 text-xs font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-lg transition-colors whitespace-nowrap shrink-0\"\n          >\n            <Printer className=\"w-3.5 h-3.5\" />\n            <span>Export PDF / Cetak</span>\n          </button>\n        </div>\n      </div>\n\n      {/* BAGIAN A: PENDAPATAN PER CHANNEL (OTA & DIRECT BOOKING) */}\n      <div className=\"bg-white border border-slate-200 rounded-xl p-6\">\n        <div className=\"pb-4 border-b border-slate-200\">\n          <h2 className=\"text-base font-bold text-slate-900\">\n            Bagian A \342\200\224 Pendapatan Kamar per Channel (Direct Booking & 5 OTA)\n          </h2>\n          <p className=\"text-xs text-slate-500 mt-0.5\">\n            Rincian Malam Terjual (Room Nights), Gross Revenue, Persentase Komisi,\n            Nominal Potongan Komisi, dan Net Room Revenue\n          </p>\n        </div>\n\n        <div className=\"overflow-x-auto mt-4\">\n          <table\n            data-testid=\"pnl-table-bagian-a\"\n            className=\"w-full text-left border-collapse text-xs\"\n          >\n            <thead>\n              <tr className=\"bg-slate-50 border-b border-slate-200 text-slate-600 font-semibold\">\n                <th className=\"py-3 px-4\">Sumber Channel Booking</th>\n                <th className=\"py-3 px-4 text-right\">\n                  Jumlah Malam Terjual (Room Nights)\n                </th>\n                <th className=\"py-3 px-4 text-right\">Gross Revenue (IDR)</th>\n                <th className=\"py-3 px-4 text-right\">Komisi (%)</th>\n                <th className=\"py-3 px-4 text-right\">\n                  Nominal Potongan Komisi (IDR)\n                </th>\n                <th className=\"py-3 px-4 text-right\">\n                  Net Room Revenue (IDR)\n                </th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-200\">\n              {report.channelRows.map((row) => (\n                <tr key={row.channel} className=\"hover:bg-slate-50\">\n                  <td className=\"py-3 px-4 font-semibold text-slate-900\">\n                    {row.channel}\n                    <span className=\"text-slate-400 font-normal ml-1.5\">\n                      ({row.bookingsCount} rsv)\n                    </span>\n                  </td>\n                  <td className=\"py-3 px-4 text-right font-mono tabular-nums text-slate-800\">\n                    {row.roomNights} malam\n                  </td>\n                  <td className=\"py-3 px-4 text-right font-mono tabular-nums text-slate-900\">\n                    {formatIDR(row.grossRevenue)}\n                  </td>\n                  <td className=\"py-3 px-4 text-right font-mono tabular-nums text-slate-600\">\n                    {row.commissionRate}%\n                  </td>\n                  <td className=\"py-3 px-4 text-right font-mono tabular-nums text-amber-700\">\n                    -{formatIDR(row.commissionAmount)}\n                  </td>\n                  <td className=\"py-3 px-4 text-right font-mono tabular-nums font-semibold text-emerald-700\">\n                    {formatIDR(row.netRevenue)}\n                  </td>\n                </tr>\n              ))}\n            </tbody>\n            <tfoot>\n              <tr className=\"bg-slate-900 text-white font-bold text-xs\">\n                <td className=\"py-3.5 px-4\">TOTAL PENDAPATAN KAMAR (BAGIAN A)</td>\n                <td className=\"py-3.5 px-4 text-right font-mono tabular-nums\">\n                  {report.totalRoomNightsSold} malam\n                </td>\n                <td className=\"py-3.5 px-4 text-right font-mono tabular-nums\">\n                  {formatIDR(report.totalGrossRevenue)}\n                </td>\n                <td className=\"py-3.5 px-4 text-right font-mono tabular-nums\">\n                  {report.totalGrossRevenue > 0\n                    ? (\n                        (report.totalCommissionAmount /\n                          report.totalGrossRevenue) *\n                        100\n                      ).toFixed(1)\n                    : \'0.0\'}\n                  % (Rata-rata)\n                </td>\n                <td className=\"py-3.5 px-4 text-right font-mono tabular-nums text-amber-300\">\n                  -{formatIDR(report.totalCommissionAmount)}\n                </td>\n                <td className=\"py-3.5 px-4 text-right font-mono tabular-nums text-emerald-400\">\n                  {formatIDR(report.totalNetRoomRevenue)}\n                </td>\n              </tr>\n            </tfoot>\n          </table>\n        </div>\n      </div>\n\n      {/* BAGIAN B & BAGIAN C SIDE BY SIDE */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n        {/* BAGIAN B: RINCIAN BIAYA OPERASIONAL */}\n        <div className=\"lg:col-span-7 bg-white border border-slate-200 rounded-xl p-6\">\n          <div className=\"pb-4 border-b border-slate-200\">\n            <h2 className=\"text-base font-bold text-slate-900\">\n              Bagian B \342\200\224 Rincian Biaya Operasional (7 Kategori)\n            </h2>\n            <p className=\"text-xs text-slate-500 mt-0.5\">\n              Seluruh beban operasional bulanan termasuk Depresiasi Aset & Peralatan\n            </p>\n          </div>\n\n          <div className=\"overflow-x-auto mt-4\">\n            <table\n              data-testid=\"pnl-table-bagian-b\"\n              className=\"w-full text-left border-collapse text-xs\"\n            >\n              <thead>\n                <tr className=\"bg-slate-50 border-b border-slate-200 text-slate-600 font-semibold\">\n                  <th className=\"py-3 px-4\">Kategori Biaya Operasional</th>\n                  <th className=\"py-3 px-3 text-right\">Porsi (%)</th>\n                  <th className=\"py-3 px-4 text-right\">Total Pengeluaran (IDR)</th>\n                </tr>\n              </thead>\n              <tbody className=\"divide-y divide-slate-200\">\n                {report.expenseRows.map((exp, idx) => (\n                  <tr key={exp.category} className=\"hover:bg-slate-50\">\n                    <td className=\"py-3 px-4 font-medium text-slate-900\">\n                      0{idx + 1}. {exp.category}\n                    </td>\n                    <td className=\"py-3 px-3 text-right font-mono tabular-nums text-slate-500\">\n                      {exp.shareOfTotalExpense.toFixed(1)}%\n                    </td>\n                    <td className=\"py-3 px-4 text-right font-mono tabular-nums font-semibold text-slate-900\">\n                      {formatIDR(exp.amount)}\n                    </td>\n                  </tr>\n                ))}\n              </tbody>\n              <tfoot>\n                <tr className=\"bg-slate-100 border-t-2 border-slate-300 font-bold text-slate-900 text-xs\">\n                  <td className=\"py-3.5 px-4\">\n                    TOTAL BIAYA OPERASIONAL (BAGIAN B)\n                  </td>\n                  <td className=\"py-3.5 px-3 text-right font-mono tabular-nums\">\n                    100.0%\n                  </td>\n                  <td className=\"py-3.5 px-4 text-right font-mono tabular-nums text-rose-700\">\n                    {formatIDR(report.totalOperationalExpenses)}\n                  </td>\n                </tr>\n              </tfoot>\n            </table>\n          </div>\n        </div>\n\n        {/* BAGIAN C: RINGKASAN AKHIR (PROFIT & LOSS SUMMARY) */}\n        <div\n          data-testid=\"pnl-bagian-c-summary\"\n          className=\"lg:col-span-5 bg-white border border-slate-200 rounded-xl p-6 flex flex-col justify-between\"\n        >\n          <div>\n            <div className=\"pb-4 border-b border-slate-200\">\n              <h2 className=\"text-base font-bold text-slate-900\">\n                Bagian C \342\200\224 Ringkasan Akhir Laba Rugi\n              </h2>\n              <p className=\"text-xs text-slate-500 mt-0.5\">\n                Kalkulasi otomatis Net Profit Akhir, Margin & Occupancy Rate\n              </p>\n            </div>\n\n            <div className=\"mt-4 space-y-3 text-xs\">\n              <div className=\"flex items-center justify-between py-2 border-b border-slate-100\">\n                <span className=\"text-slate-600\">Total Gross Revenue</span>\n                <span className=\"font-mono tabular-nums font-semibold text-slate-900\">\n                  {formatIDR(report.totalGrossRevenue)}\n                </span>\n              </div>\n\n              <div className=\"flex items-center justify-between py-2 border-b border-slate-100\">\n                <span className=\"text-slate-600\">\n                  Total Potongan Komisi OTA\n                </span>\n                <span className=\"font-mono tabular-nums font-semibold text-amber-700\">\n                  -{formatIDR(report.totalCommissionAmount)}\n                </span>\n              </div>\n\n              <div className=\"flex items-center justify-between py-2 border-b border-slate-200 bg-slate-50 px-3 rounded\">\n                <span className=\"font-semibold text-slate-900\">\n                  Total Net Room Revenue\n                </span>\n                <span className=\"font-mono tabular-nums font-bold text-slate-900\">\n                  {formatIDR(report.totalNetRoomRevenue)}\n                </span>\n              </div>\n\n              <div className=\"flex items-center justify-between py-2 border-b border-slate-100\">\n                <span className=\"text-slate-600\">\n                  Total Biaya Operasional (7 Kategori)\n                </span>\n                <span className=\"font-mono tabular-nums font-semibold text-rose-700\">\n                  -{formatIDR(report.totalOperationalExpenses)}\n                </span>\n              </div>\n            </div>\n          </div>\n\n          <div className=\"mt-6 p-5 bg-slate-900 text-white rounded-xl space-y-4\">\n            <div>\n              <p className=\"text-xs font-mono text-slate-300\">\n                NET PROFIT AKHIR (Net Room Revenue \342\210\222 Biaya Operasional)\n              </p>\n              <p\n                data-testid=\"pnl-final-net-profit\"\n                className=\"text-2xl sm:text-3xl font-bold font-mono tabular-nums text-emerald-400 mt-1\"\n              >\n                {formatIDR(report.netProfit)}\n              </p>\n            </div>\n\n            <div className=\"grid grid-cols-2 gap-4 pt-3 border-t border-slate-800\">\n              <div>\n                <p className=\"text-xs text-slate-400\">Net Profit Margin (%)</p>\n                <p\n                  data-testid=\"pnl-net-profit-margin\"\n                  className=\"text-lg font-bold font-mono tabular-nums text-white mt-0.5\"\n                >\n                  {report.netProfitMargin.toFixed(2)}%\n                </p>\n              </div>\n              <div>\n                <p className=\"text-xs text-slate-400\">Occupancy Rate (%)</p>\n                <p\n                  data-testid=\"pnl-occupancy-rate\"\n                  className=\"text-lg font-bold font-mono tabular-nums text-white mt-0.5\"\n                >\n                  {report.occupancyRate.toFixed(2)}%\n                </p>\n                <p className=\"text-[11px] text-slate-400 font-mono\">\n                  ({report.totalRoomNightsSold} / {report.availableRoomNights} mlm)\n                </p>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* GRAFIK PERBANDINGAN PENDAPATAN OTA */}\n      <div className=\"bg-white border border-slate-200 rounded-xl p-6\">\n        <h2 className=\"text-base font-bold text-slate-900\">\n          Grafik Perbandingan Pendapatan OTA vs Direct Booking ({selectedMonth})\n        </h2>\n        <p className=\"text-xs text-slate-500 mt-0.5\">\n          Visualisasi kontribusi Gross Revenue dan Net Room Revenue setelah dikurangi\n          komisi masing-masing channel\n        </p>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-6 gap-4 mt-6 items-end pt-4\">\n          {report.channelRows.map((row) => {\n            const barHeightPct = Math.max(\n              8,\n              Math.round((row.grossRevenue / maxGross) * 100)\n            );\n            const netHeightPct = Math.max(\n              6,\n              Math.round((row.netRevenue / maxGross) * 100)\n            );\n\n            return (\n              <div\n                key={row.channel}\n                className=\"flex flex-col items-center p-3 border border-slate-200 rounded-lg bg-slate-50/50\"\n              >\n                <div className=\"w-full h-36 flex items-end justify-center gap-2 px-2 border-b border-slate-200\">\n                  <div\n                    className=\"w-6 bg-slate-400 rounded-t transition-all\"\n                    style={{ height: `${barHeightPct}%` }}\n                    title={`Gross Revenue: ${formatIDR(row.grossRevenue)}`}\n                  />\n                  <div\n                    className=\"w-6 bg-emerald-600 rounded-t transition-all\"\n                    style={{ height: `${netHeightPct}%` }}\n                    title={`Net Revenue: ${formatIDR(row.netRevenue)}`}\n                  />\n                </div>\n                <p className=\"text-xs font-bold text-slate-900 mt-2.5 text-center\">\n                  {row.channel}\n                </p>\n                <p className=\"text-[11px] font-mono tabular-nums text-slate-500\">\n                  Komisi {row.commissionRate}%\n                </p>\n                <p className=\"text-xs font-mono tabular-nums font-semibold text-emerald-700 mt-1\">\n                  {formatIDR(row.netRevenue)}\n                </p>\n              </div>\n            );\n          })}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/ProfitLossStatementView.tsx"
        }
        overwrite: true
      }
    }
