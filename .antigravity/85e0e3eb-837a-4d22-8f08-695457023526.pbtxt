  code_action {
    action_spec {
      create_file {
        instruction: "import {\n  AppViewId,\n  BookingChannel,\n  ChannelPnlRow,\n  ExpenseCategory,\n  ExpenseCategorySummary,\n  ExpenseRecord,\n  MonthlyProfitLossReport,\n  PropertySettingsConfig,\n  RatePlanType,\n  ReservationRecord,\n  UserRole,\n} from \'../types/hms\';\n\nexport const ALL_BOOKING_CHANNELS: BookingChannel[] = [\n  \'Direct Booking\',\n  \'Traveloka\',\n  \'Tiket.com\',\n  \'Agoda\',\n  \'Booking.com\',\n  \'Airbnb\',\n];\n\nexport const ALL_EXPENSE_CATEGORIES: ExpenseCategory[] = [\n  \'Gaji Staf & Operasional SDM\',\n  \'Listrik, Air, WiFi & Gas (Utilities)\',\n  \'Housekeeping, Laundry & Amenities\',\n  \'Bahan Baku Sarapan (F&B Cost)\',\n  \'Maintenance & Perbaikan Rutin\',\n  \'Marketing & Promosi\',\n  \'Depresiasi Aset & Peralatan\',\n];\n\nexport function formatIDR(amount: number): string {\n  const rounded = Math.round(amount || 0);\n  const absFormatted = Math.abs(rounded).toLocaleString(\'id-ID\');\n  return rounded < 0 ? `-Rp ${absFormatted}` : `Rp ${absFormatted}`;\n}\n\nexport function getChannelCommissionRate(\n  channel: BookingChannel,\n  settings: Pick<\n    PropertySettingsConfig,\n    \'commDirect\' | \'commAirbnb\' | \'commTraveloka\' | \'commTiket\' | \'commAgoda\' | \'commBooking\'\n  >\n): number {\n  switch (channel) {\n    case \'Direct Booking\':\n      return settings.commDirect ?? 0;\n    case \'Airbnb\':\n      return settings.commAirbnb ?? 14;\n    case \'Traveloka\':\n      return settings.commTraveloka ?? 15;\n    case \'Tiket.com\':\n      return settings.commTiket ?? 15;\n    case \'Agoda\':\n      return settings.commAgoda ?? 17;\n    case \'Booking.com\':\n      return settings.commBooking ?? 18;\n    default:\n      return 0;\n  }\n}\n\nexport function getRateForRoomType(\n  roomType: RatePlanType,\n  settings: Pick<\n    PropertySettingsConfig,\n    | \'standardWeekday\'\n    | \'standardWeekend\'\n    | \'deluxeWeekday\'\n    | \'deluxeWeekend\'\n    | \'familySuiteRate\'\n  >\n): { weekdayRate: number; weekendRate: number; includesBreakfast: boolean } {\n  switch (roomType) {\n    case \'Standard Room\':\n      return {\n        weekdayRate: settings.standardWeekday,\n        weekendRate: settings.standardWeekend,\n        includesBreakfast: false,\n      };\n    case \'Deluxe Room\':\n      return {\n        weekdayRate: settings.deluxeWeekday,\n        weekendRate: settings.deluxeWeekend,\n        includesBreakfast: true,\n      };\n    case \'Family Suite\':\n      return {\n        weekdayRate: settings.familySuiteRate,\n        weekendRate: settings.familySuiteRate,\n        includesBreakfast: true,\n      };\n  }\n}\n\n/**\n * Calculates how many weekday nights vs weekend nights fall between checkIn and checkOut.\n * Friday (day 5) and Saturday (day 6) nights are counted as Weekend nights;\n * Sunday\342\200\223Thursday nights are counted as Weekday nights.\n */\nexport function calculateStayBreakdown(\n  checkIn: string,\n  checkOut: string,\n  weekdayRate: number,\n  weekendRate: number\n): {\n  nights: number;\n  weekdayNights: number;\n  weekendNights: number;\n  grossRevenue: number;\n} {\n  const start = new Date(`${checkIn}T00:00:00Z`);\n  const end = new Date(`${checkOut}T00:00:00Z`);\n  if (isNaN(start.getTime()) || isNaN(end.getTime()) || end <= start) {\n    return {\n      nights: 0,\n      weekdayNights: 0,\n      weekendNights: 0,\n      grossRevenue: 0,\n    };\n  }\n\n  let weekdayNights = 0;\n  let weekendNights = 0;\n  const cursor = new Date(start);\n  while (cursor < end) {\n    const dayOfWeek = cursor.getUTCDay(); // 0=Sun, 5=Fri, 6=Sat\n    if (dayOfWeek === 5 || dayOfWeek === 6) {\n      weekendNights += 1;\n    } else {\n      weekdayNights += 1;\n    }\n    cursor.setUTCDate(cursor.getUTCDate() + 1);\n  }\n\n  const nights = weekdayNights + weekendNights;\n  const grossRevenue = weekdayNights * weekdayRate + weekendNights * weekendRate;\n\n  return {\n    nights,\n    weekdayNights,\n    weekendNights,\n    grossRevenue,\n  };\n}\n\nexport function calculateOtaFinancials(\n  grossRevenue: number,\n  commissionRate: number\n): {\n  grossRevenue: number;\n  commissionRate: number;\n  commissionAmount: number;\n  netRevenue: number;\n} {\n  const safeGross = Math.max(0, Math.round(grossRevenue));\n  const safeRate = Math.max(0, Math.min(100, commissionRate));\n  const commissionAmount = Math.round(safeGross * (safeRate / 100));\n  const netRevenue = safeGross - commissionAmount;\n\n  return {\n    grossRevenue: safeGross,\n    commissionRate: safeRate,\n    commissionAmount,\n    netRevenue,\n  };\n}\n\nexport function getDaysInMonth(monthKey: string): number {\n  const [yearStr, monthStr] = monthKey.split(\'-\');\n  const year = Number(yearStr);\n  const month = Number(monthStr);\n  if (!year || !month || month < 1 || month > 12) return 30;\n  return new Date(Date.UTC(year, month, 0)).getUTCDate();\n}\n\nexport function generateMonthlyProfitLoss(\n  reservations: ReservationRecord[],\n  expenses: ExpenseRecord[],\n  monthKey: string,\n  totalRoomsCount: number,\n  settings: Pick<\n    PropertySettingsConfig,\n    \'commDirect\' | \'commAirbnb\' | \'commTraveloka\' | \'commTiket\' | \'commAgoda\' | \'commBooking\'\n  >\n): MonthlyProfitLossReport {\n  const daysInMonth = getDaysInMonth(monthKey);\n  const availableRoomNights = totalRoomsCount * daysInMonth;\n\n  const activeMonthReservations = reservations.filter(\n    (r) => r.monthKey === monthKey && r.status !== \'Cancelled\'\n  );\n  const monthExpenses = expenses.filter((e) => e.monthKey === monthKey);\n\n  const totalGrossRevenue = activeMonthReservations.reduce(\n    (sum, r) => sum + r.grossRevenue,\n    0\n  );\n\n  // Bagian A: Pendapatan per Channel\n  const channelRows: ChannelPnlRow[] = ALL_BOOKING_CHANNELS.map((channel) => {\n    const channelBookings = activeMonthReservations.filter(\n      (r) => r.channel === channel\n    );\n    const bookingsCount = channelBookings.length;\n    const roomNights = channelBookings.reduce((sum, r) => sum + r.nights, 0);\n    const grossRevenue = channelBookings.reduce(\n      (sum, r) => sum + r.grossRevenue,\n      0\n    );\n    const commissionRate = getChannelCommissionRate(channel, settings);\n    const commissionAmount = channelBookings.reduce(\n      (sum, r) => sum + r.commissionAmount,\n      0\n    );\n    const netRevenue = channelBookings.reduce(\n      (sum, r) => sum + r.netRevenue,\n      0\n    );\n    const shareOfGross =\n      totalGrossRevenue > 0 ? (grossRevenue / totalGrossRevenue) * 100 : 0;\n\n    return {\n      channel,\n      bookingsCount,\n      roomNights,\n      grossRevenue,\n      commissionRate,\n      commissionAmount,\n      netRevenue,\n      shareOfGross,\n    };\n  });\n\n  const totalOperationalExpenses = monthExpenses.reduce(\n    (sum, e) => sum + e.amount,\n    0\n  );\n\n  // Bagian B: Rincian Biaya Operasional (7 Kategori)\n  const expenseRows: ExpenseCategorySummary[] = ALL_EXPENSE_CATEGORIES.map(\n    (category) => {\n      const catExpenses = monthExpenses.filter((e) => e.category === category);\n      const amount = catExpenses.reduce((sum, e) => sum + e.amount, 0);\n      const transactionsCount = catExpenses.length;\n      const shareOfTotalExpense =\n        totalOperationalExpenses > 0\n          ? (amount / totalOperationalExpenses) * 100\n          : 0;\n      return {\n        category,\n        amount,\n        transactionsCount,\n        shareOfTotalExpense,\n      };\n    }\n  );\n\n  // Bagian C: Ringkasan Akhir\n  const totalRoomNightsSold = channelRows.reduce(\n    (sum, r) => sum + r.roomNights,\n    0\n  );\n  const totalCommissionAmount = channelRows.reduce(\n    (sum, r) => sum + r.commissionAmount,\n    0\n  );\n  const totalNetRoomRevenue = channelRows.reduce(\n    (sum, r) => sum + r.netRevenue,\n    0\n  );\n  const netProfit = totalNetRoomRevenue - totalOperationalExpenses;\n  const netProfitMargin =\n    totalNetRoomRevenue > 0 ? (netProfit / totalNetRoomRevenue) * 100 : 0;\n  const occupancyRate =\n    availableRoomNights > 0\n      ? Math.min(100, (totalRoomNightsSold / availableRoomNights) * 100)\n      : 0;\n  const adr =\n    totalRoomNightsSold > 0 ? totalGrossRevenue / totalRoomNightsSold : 0;\n  const revPar =\n    availableRoomNights > 0 ? totalNetRoomRevenue / availableRoomNights : 0;\n\n  return {\n    monthKey,\n    totalRoomsCount,\n    daysInMonth,\n    availableRoomNights,\n    channelRows,\n    expenseRows,\n    totalRoomNightsSold,\n    occupancyRate,\n    totalGrossRevenue,\n    totalCommissionAmount,\n    totalNetRoomRevenue,\n    totalOperationalExpenses,\n    netProfit,\n    netProfitMargin,\n    adr,\n    revPar,\n  };\n}\n\n/**\n * Role-Based Access Control (RBAC) enforcement:\n * - OWNER: Full access to Dashboard, Calendar/Rooms, Reservations, Housekeeping, Rate Plan, Expenses, Financial Report (P&L), AI Hub\n * - ADMIN: Full access to Rate Plan, OTA Commissions, Operational Expenses, Financial Report (P&L), Calendar, Reservations, AI Hub\n * - RESEPSIONIS: Access ONLY to Room Calendar, Check-in/Check-out & Reservations, Housekeeping Status, and Receptionist Quick Assist.\n *   Financial Report and Operational Expenses are strictly hidden and restricted for RESEPSIONIS.\n */\nexport function canRoleAccessView(role: UserRole, view: AppViewId): boolean {\n  if (role === UserRole.OWNER || role === UserRole.ADMIN) {\n    return true;\n  }\n  if (role === UserRole.RESEPSIONIS) {\n    return (\n      view === \'calendar\' ||\n      view === \'reservations\' ||\n      view === \'housekeeping\' ||\n      view === \'ai_hub\'\n    );\n  }\n  return false;\n}\n\nexport function exportProfitLossToCsv(report: MonthlyProfitLossReport): string {\n  const lines: string[] = [];\n  lines.push(`LAPORAN LABA RUGI (PROFIT & LOSS STATEMENT) - HOTEL PUTRI SARI`);\n  lines.push(`Periode Bulan,${report.monthKey}`);\n  lines.push(`Total Kamar,${report.totalRoomsCount}`);\n  lines.push(`Kapasitas Malam Kamar,${report.availableRoomNights}`);\n  lines.push(\'\');\n\n  lines.push(\'BAGIAN A: PENDAPATAN KAMAR PER CHANNEL (OTA & DIRECT)\');\n  lines.push(\n    \'Sumber Booking,Jumlah Reservasi,Malam Terjual (Room Nights),Gross Revenue (IDR),Komisi (%),Potongan Komisi (IDR),Net Room Revenue (IDR)\'\n  );\n  for (const row of report.channelRows) {\n    lines.push(\n      `\"${row.channel}\",${row.bookingsCount},${row.roomNights},${row.grossRevenue},${row.commissionRate}%,${row.commissionAmount},${row.netRevenue}`\n    );\n  }\n  lines.push(\n    `\"TOTAL PENDAPATAN KAMAR\",${report.channelRows.reduce((s, r) => s + r.bookingsCount, 0)},${report.totalRoomNightsSold},${report.totalGrossRevenue},-,${report.totalCommissionAmount},${report.totalNetRoomRevenue}`\n  );\n  lines.push(\'\');\n\n  lines.push(\'BAGIAN B: RINCIAN BIAYA OPERASIONAL BULANAN\');\n  lines.push(\'Kategori Biaya,Jumlah Transaksi,Total Pengeluaran (IDR),Porsi Biaya (%)\');\n  for (const exp of report.expenseRows) {\n    lines.push(\n      `\"${exp.category}\",${exp.transactionsCount},${exp.amount},${exp.shareOfTotalExpense.toFixed(1)}%`\n    );\n  }\n  lines.push(\n    `\"TOTAL BIAYA OPERASIONAL\",${report.expenseRows.reduce((s, e) => s + e.transactionsCount, 0)},${report.totalOperationalExpenses},100.0%`\n  );\n  lines.push(\'\');\n\n  lines.push(\'BAGIAN C: RINGKASAN AKHIR (EXECUTIVE SUMMARY)\');\n  lines.push(`Total Gross Revenue,${report.totalGrossRevenue}`);\n  lines.push(`Total Potongan Komisi OTA,${report.totalCommissionAmount}`);\n  lines.push(`Total Net Room Revenue,${report.totalNetRoomRevenue}`);\n  lines.push(`Total Biaya Operasional,${report.totalOperationalExpenses}`);\n  lines.push(`NET PROFIT AKHIR,${report.netProfit}`);\n  lines.push(`Net Profit Margin (%),${report.netProfitMargin.toFixed(2)}%`);\n  lines.push(`Occupancy Rate (%),${report.occupancyRate.toFixed(2)}%`);\n\n  return lines.join(\'\\n\');\n}\n"
        path {
          absolute_uri: "file:///src/utils/hotelCalculations.ts"
        }
        overwrite: true
      }
    }
