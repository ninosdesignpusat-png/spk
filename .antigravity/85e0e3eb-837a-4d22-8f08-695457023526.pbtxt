      create_file {
        instruction: "rules_version = \'2\';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    match /{document=**} {\n      allow read, write: if false;\n    }\n\n    function isValidId(id) {\n      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches(\'^[a-zA-Z0-9_\\\\-]+$\');\n    }\n\n    function incoming() {\n      return request.resource.data;\n    }\n\n    function existing() {\n      return resource.data;\n    }\n\n    function isSignedIn() {\n      return request.auth != null && request.auth.token.email_verified == true;\n    }\n\n    function isAdmin() {\n      return isSignedIn() && (\n        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||\n        request.auth.token.email == \'jajapintravel@gmail.com\'\n      );\n    }\n\n    function isValidRoom(data) {\n      return data.keys().hasAll([\n        \'ownerId\', \'roomNumber\', \'name\', \'type\', \'physicalCategory\',\n        \'status\', \'weekdayRate\', \'weekendRate\', \'includesBreakfast\', \'updatedAt\'\n      ]) &&\n      data.keys().hasOnly([\n        \'ownerId\', \'roomNumber\', \'name\', \'type\', \'physicalCategory\',\n        \'status\', \'weekdayRate\', \'weekendRate\', \'includesBreakfast\', \'updatedAt\'\n      ]) &&\n      data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&\n      data.ownerId.matches(\'^[a-zA-Z0-9_\\\\-]+$\') &&\n      data.ownerId == request.auth.uid &&\n      data.roomNumber is string && data.roomNumber.size() >= 1 && data.roomNumber.size() <= 16 &&\n      data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&\n      data.type is string && data.type.size() <= 40 &&\n      data.type in [\'Standard Room\', \'Deluxe Room\', \'Family Suite\'] &&\n      data.physicalCategory is string && data.physicalCategory.size() <= 40 &&\n      data.physicalCategory in [\'Deluxe Room\', \'Standard AC\', \'Room Ekonomi Kipas\'] &&\n      data.status is string && data.status.size() <= 20 &&\n      data.status in [\'Available\', \'Occupied\', \'Dirty\', \'Maintenance\'] &&\n      data.weekdayRate is number && data.weekdayRate >= 0 && data.weekdayRate <= 100000000 &&\n      data.weekendRate is number && data.weekendRate >= 0 && data.weekendRate <= 100000000 &&\n      data.includesBreakfast is bool &&\n      data.updatedAt is timestamp && data.updatedAt == request.time;\n    }\n\n    function isValidReservation(data) {\n      return data.keys().hasAll([\n        \'ownerId\', \'bookingCode\', \'guestName\', \'roomId\', \'roomNumber\', \'roomType\',\n        \'checkIn\', \'checkOut\', \'nights\', \'channel\', \'grossRevenue\', \'commissionRate\',\n        \'commissionAmount\', \'netRevenue\', \'status\', \'monthKey\', \'createdAt\', \'updatedAt\'\n      ]) &&\n      data.keys().hasOnly([\n        \'ownerId\', \'bookingCode\', \'guestName\', \'roomId\', \'roomNumber\', \'roomType\',\n        \'checkIn\', \'checkOut\', \'nights\', \'channel\', \'grossRevenue\', \'commissionRate\',\n        \'commissionAmount\', \'netRevenue\', \'status\', \'monthKey\', \'createdAt\', \'updatedAt\'\n      ]) &&\n      data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&\n      data.ownerId.matches(\'^[a-zA-Z0-9_\\\\-]+$\') &&\n      data.ownerId == request.auth.uid &&\n      data.bookingCode is string && data.bookingCode.size() >= 1 && data.bookingCode.size() <= 40 &&\n      data.guestName is string && data.guestName.size() >= 1 && data.guestName.size() <= 120 &&\n      data.roomId is string && data.roomId.size() >= 1 && data.roomId.size() <= 64 &&\n      data.roomNumber is string && data.roomNumber.size() >= 1 && data.roomNumber.size() <= 16 &&\n      data.roomType is string && data.roomType.size() <= 40 &&\n      data.roomType in [\'Standard Room\', \'Deluxe Room\', \'Family Suite\'] &&\n      data.checkIn is string && data.checkIn.size() >= 10 && data.checkIn.size() <= 20 &&\n      data.checkOut is string && data.checkOut.size() >= 10 && data.checkOut.size() <= 20 &&\n      data.nights is number && data.nights >= 1 && data.nights <= 365 &&\n      data.channel is string && data.channel.size() <= 40 &&\n      data.channel in [\'Direct Booking\', \'Airbnb\', \'Traveloka\', \'Tiket.com\', \'Agoda\', \'Booking.com\'] &&\n      data.grossRevenue is number && data.grossRevenue >= 0 && data.grossRevenue <= 1000000000 &&\n      data.commissionRate is number && data.commissionRate >= 0 && data.commissionRate <= 100 &&\n      data.commissionAmount is number && data.commissionAmount >= 0 && data.commissionAmount <= 1000000000 &&\n      data.netRevenue is number && data.netRevenue >= 0 && data.netRevenue <= 1000000000 &&\n      data.status is string && data.status.size() <= 20 &&\n      data.status in [\'Confirmed\', \'Checked-In\', \'Checked-Out\', \'Cancelled\'] &&\n      data.monthKey is string && data.monthKey.size() >= 7 && data.monthKey.size() <= 10 &&\n      data.createdAt is timestamp &&\n      data.updatedAt is timestamp && data.updatedAt == request.time;\n    }\n\n    function isValidExpense(data) {\n      return data.keys().hasAll([\n        \'ownerId\', \'category\', \'description\', \'amount\', \'date\', \'monthKey\', \'createdAt\', \'updatedAt\'\n      ]) &&\n      data.keys().hasOnly([\n        \'ownerId\', \'category\', \'description\', \'amount\', \'date\', \'monthKey\', \'createdAt\', \'updatedAt\'\n      ]) &&\n      data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&\n      data.ownerId.matches(\'^[a-zA-Z0-9_\\\\-]+$\') &&\n      data.ownerId == request.auth.uid &&\n      data.category is string && data.category.size() <= 80 &&\n      data.category in [\n        \'Gaji Staf & Operasional SDM\',\n        \'Listrik, Air, WiFi & Gas (Utilities)\',\n        \'Housekeeping, Laundry & Amenities\',\n        \'Bahan Baku Sarapan (F&B Cost)\',\n        \'Maintenance & Perbaikan Rutin\',\n        \'Marketing & Promosi\',\n        \'Depresiasi Aset & Peralatan\'\n      ] &&\n      data.description is string && data.description.size() >= 1 && data.description.size() <= 200 &&\n      data.amount is number && data.amount >= 0 && data.amount <= 1000000000 &&\n      data.date is string && data.date.size() >= 10 && data.date.size() <= 20 &&\n      data.monthKey is string && data.monthKey.size() >= 7 && data.monthKey.size() <= 10 &&\n      data.createdAt is timestamp &&\n      data.updatedAt is timestamp && data.updatedAt == request.time;\n    }\n\n    function isValidSettings(data) {\n      return data.keys().hasAll([\n        \'ownerId\', \'standardWeekday\', \'standardWeekend\', \'deluxeWeekday\', \'deluxeWeekend\',\n        \'familySuiteRate\', \'commAirbnb\', \'commTraveloka\', \'commTiket\', \'commAgoda\',\n        \'commBooking\', \'lastOtaSync\', \'updatedAt\'\n      ]) &&\n      data.keys().hasOnly([\n        \'ownerId\', \'standardWeekday\', \'standardWeekend\', \'deluxeWeekday\', \'deluxeWeekend\',\n        \'familySuiteRate\', \'commAirbnb\', \'commTraveloka\', \'commTiket\', \'commAgoda\',\n        \'commBooking\', \'lastOtaSync\', \'updatedAt\'\n      ]) &&\n      data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&\n      data.ownerId.matches(\'^[a-zA-Z0-9_\\\\-]+$\') &&\n      data.ownerId == request.auth.uid &&\n      data.standardWeekday is number && data.standardWeekday >= 0 && data.standardWeekday <= 100000000 &&\n      data.standardWeekend is number && data.standardWeekend >= 0 && data.standardWeekend <= 100000000 &&\n      data.deluxeWeekday is number && data.deluxeWeekday >= 0 && data.deluxeWeekday <= 100000000 &&\n      data.deluxeWeekend is number && data.deluxeWeekend >= 0 && data.deluxeWeekend <= 100000000 &&\n      data.familySuiteRate is number && data.familySuiteRate >= 0 && data.familySuiteRate <= 100000000 &&\n      data.commAirbnb is number && data.commAirbnb >= 0 && data.commAirbnb <= 100 &&\n      data.commTraveloka is number && data.commTraveloka >= 0 && data.commTraveloka <= 100 &&\n      data.commTiket is number && data.commTiket >= 0 && data.commTiket <= 100 &&\n      data.commAgoda is number && data.commAgoda >= 0 && data.commAgoda <= 100 &&\n      data.commBooking is number && data.commBooking >= 0 && data.commBooking <= 100 &&\n      data.lastOtaSync is string && data.lastOtaSync.size() >= 1 && data.lastOtaSync.size() <= 64 &&\n      data.updatedAt is timestamp && data.updatedAt == request.time;\n    }\n\n    match /rooms/{roomId} {\n      allow get: if isSignedIn() && isValidId(roomId) && (existing().ownerId == request.auth.uid || isAdmin());\n      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());\n      allow create: if isSignedIn() && isValidId(roomId) && isValidRoom(incoming());\n      allow update: if isSignedIn() && isValidId(roomId) && isValidRoom(incoming()) &&\n        incoming().ownerId == existing().ownerId && (\n          isAdmin() ||\n          (existing().ownerId == request.auth.uid &&\n            incoming().diff(existing()).affectedKeys().hasOnly([\n              \'status\', \'weekdayRate\', \'weekendRate\', \'type\', \'physicalCategory\', \'name\', \'includesBreakfast\', \'updatedAt\'\n            ])\n          )\n        );\n      allow delete: if isSignedIn() && isValidId(roomId) && (existing().ownerId == request.auth.uid || isAdmin());\n    }\n\n    match /reservations/{reservationId} {\n      allow get: if isSignedIn() && isValidId(reservationId) && (existing().ownerId == request.auth.uid || isAdmin());\n      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());\n      allow create: if isSignedIn() && isValidId(reservationId) && isValidReservation(incoming()) &&\n        incoming().createdAt == request.time;\n      allow update: if isSignedIn() && isValidId(reservationId) && isValidReservation(incoming()) &&\n        incoming().ownerId == existing().ownerId &&\n        incoming().createdAt == existing().createdAt && (\n          isAdmin() ||\n          (existing().ownerId == request.auth.uid &&\n            existing().status != \'Cancelled\' &&\n            incoming().diff(existing()).affectedKeys().hasOnly([\n              \'status\', \'guestName\', \'checkIn\', \'checkOut\', \'nights\', \'channel\',\n              \'grossRevenue\', \'commissionRate\', \'commissionAmount\', \'netRevenue\', \'updatedAt\'\n            ])\n          )\n        );\n      allow delete: if isSignedIn() && isValidId(reservationId) && (existing().ownerId == request.auth.uid || isAdmin());\n    }\n\n    match /expenses/{expenseId} {\n      allow get: if isSignedIn() && isValidId(expenseId) && (existing().ownerId == request.auth.uid || isAdmin());\n      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());\n      allow create: if isSignedIn() && isValidId(expenseId) && isValidExpense(incoming()) &&\n        incoming().createdAt == request.time;\n      allow update: if isSignedIn() && isValidId(expenseId) && isValidExpense(incoming()) &&\n        incoming().ownerId == existing().ownerId &&\n        incoming().createdAt == existing().createdAt && (\n          isAdmin() ||\n          (existing().ownerId == request.auth.uid &&\n            incoming().diff(existing()).affectedKeys().hasOnly([\n              \'category\', \'description\', \'amount\', \'date\', \'monthKey\', \'updatedAt\'\n            ])\n          )\n        );\n      allow delete: if isSignedIn() && isValidId(expenseId) && (existing().ownerId == request.auth.uid || isAdmin());\n    }\n\n    match /settings/{settingId} {\n      allow get: if isSignedIn() && isValidId(settingId) && (existing().ownerId == request.auth.uid || isAdmin());\n      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());\n      allow create: if isSignedIn() && isValidId(settingId) && isValidSettings(incoming());\n      allow update: if isSignedIn() && isValidId(settingId) && isValidSettings(incoming()) &&\n        incoming().ownerId == existing().ownerId && (\n          isAdmin() ||\n          (existing().ownerId == request.auth.uid &&\n            incoming().diff(existing()).affectedKeys().hasOnly([\n              \'standardWeekday\', \'standardWeekend\', \'deluxeWeekday\', \'deluxeWeekend\',\n              \'familySuiteRate\', \'commAirbnb\', \'commTraveloka\', \'commTiket\', \'commAgoda\',\n              \'commBooking\', \'lastOtaSync\', \'updatedAt\'\n            ])\n          )\n        );\n      allow delete: if isSignedIn() && isValidId(settingId) && (existing().ownerId == request.auth.uid || isAdmin());\n    }\n  }\n}\n"
        path {
          absolute_uri: "file:///firestore.rules"
        }
        overwrite: true
      }
    }
