    tool_calls {
      id: "call_2346504"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"{\\n  \\\"entities\\\": {\\n    \\\"Room\\\": {\\n      \\\"title\\\": \\\"Room\\\",\\n      \\\"description\\\": \\\"Single hotel room unit with status and pricing configuration\\\",\\n      \\\"type\\\": \\\"object\\\",\\n      \\\"properties\\\": {\\n        \\\"ownerId\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"description\\\": \\\"Authenticated user UID owning this record\\\",\\n          \\\"minLength\\\": 1,\\n          \\\"maxLength\\\": 128,\\n          \\\"pattern\\\": \\\"^[a-zA-Z0-9_\\\\\\\\-]+$\\\"\\n        },\\n        \\\"roomNumber\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"description\\\": \\\"Room unit number (e.g., 101, 201)\\\",\\n          \\\"minLength\\\": 1,\\n          \\\"maxLength\\\": 16\\n        },\\n        \\\"name\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"description\\\": \\\"Display name of the room\\\",\\n          \\\"minLength\\\": 1,\\n          \\\"maxLength\\\": 100\\n        },\\n        \\\"type\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"description\\\": \\\"Rate plan room type\\\",\\n          \\\"enum\\\": [\\\"Standard Room\\\", \\\"Deluxe Room\\\", \\\"Family Suite\\\"],\\n          \\\"maxLength\\\": 40\\n        },\\n        \\\"physicalCategory\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"description\\\": \\\"Physical configuration category\\\",\\n          \\\"enum\\\": [\\\"Deluxe Room\\\", \\\"Standard AC\\\", \\\"Room Ekonomi Kipas\\\"],\\n          \\\"maxLength\\\": 40\\n        },\\n        \\\"status\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"description\\\": \\\"Housekeeping & availability status\\\",\\n          \\\"enum\\\": [\\\"Available\\\", \\\"Occupied\\\", \\\"Dirty\\\", \\\"Maintenance\\\"],\\n          \\\"maxLength\\\": 20\\n        },\\n        \\\"weekdayRate\\\": {\\n          \\\"type\\\": \\\"number\\\",\\n          \\\"description\\\": \\\"Weekday nightly price in IDR\\\"\\n        },\\n        \\\"weekendRate\\\": {\\n          \\\"type\\\": \\\"number\\\",\\n          \\\"description\\\": \\\"Weekend nightly price in IDR\\\"\\n        },\\n        \\\"includesBreakfast\\\": {\\n          \\\"type\\\": \\\"boolean\\\",\\n          \\\"description\\\": \\\"Whether room rate includes breakfast\\\"\\n        },\\n        \\\"updatedAt\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"format\\\": \\\"date-time\\\",\\n          \\\"description\\\": \\\"Server timestamp of last modification\\\"\\n        }\\n      },\\n      \\\"required\\\": [\\n        \\\"ownerId\\\",\\n        \\\"roomNumber\\\",\\n        \\\"name\\\",\\n        \\\"type\\\",\\n        \\\"physicalCategory\\\",\\n        \\\"status\\\",\\n        \\\"weekdayRate\\\",\\n        \\\"weekendRate\\\",\\n        \\\"includesBreakfast\\\",\\n        \\\"updatedAt\\\"\\n      ]\\n    },\\n    \\\"Reservation\\\": {\\n      \\\"title\\\": \\\"Reservation\\\",\\n      \\\"description\\\": \\\"Guest reservation record with automatic OTA commission breakdown\\\",\\n      \\\"type\\\": \\\"object\\\",\\n      \\\"properties\\\": {\\n        \\\"ownerId\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"description\\\": \\\"Authenticated user UID owning this record\\\",\\n          \\\"minLength\\\": 1,\\n          \\\"maxLength\\\": 128,\\n          \\\"pattern\\\": \\\"^[a-zA-Z0-9_\\\\\\\\-]+$\\\"\\n        },\\n        \\\"bookingCode\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"description\\\": \\\"Unique booking reference code\\\",\\n          \\\"minLength\\\": 1,\\n          \\\"maxLength\\\": 40\\n        },\\n        \\\"guestName\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"description\\\": \\\"Full name of the guest\\\",\\n          \\\"minLength\\\": 1,\\n          \\\"maxLength\\\": 120\\n        },\\n        \\\"roomId\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"description\\\": \\\"ID of the booked room unit\\\",\\n          \\\"minLength\\\": 1,\\n          \\\"maxLength\\\": 64\\n        },\\n        \\\"roomNumber\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"description\\\": \\\"Room number string\\\",\\n          \\\"minLength\\\": 1,\\n          \\\"maxLength\\\": 16\\n        },\\n        \\\"roomType\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"description\\\": \\\"Room rate plan category\\\",\\n          \\\"enum\\\": [\\\"Standard Room\\\", \\\"Deluxe Room\\\", \\\"Family Suite\\\"],\\n          \\\"maxLength\\\": 40\\n        },\\n        \\\"checkIn\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"description\\\": \\\"Check-in ISO date string YYYY-MM-DD\\\",\\n          \\\"minLength\\\": 10,\\n          \\\"maxLength\\\": 20\\n        },\\n        \\\"checkOut\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"description\\\": \\\"Check-out ISO date string YYYY-MM-DD\\\",\\n          \\\"minLength\\\": 10,\\n          \\\"maxLength\\\": 20\\n        },\\n        \\\"nights\\\": {\\n          \\\"type\\\": \\\"number\\\",\\n          \\\"description\\\": \\\"Total room nights booked\\\"\\n        },\\n        \\\"channel\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"description\\\": \\\"Booking source / OTA channel\\\",\\n          \\\"enum\\\": [\\n            \\\"Direct Booking\\\",\\n            \\\"Airbnb\\\",\\n            \\\"Traveloka\\\",\\n            \\\"Tiket.com\\\",\\n            \\\"Agoda\\\",\\n            \\\"Booking.com\\\"\\n          ],\\n          \\\"maxLength\\\": 40\\n        },\\n        \\\"grossRevenue\\\": {\\n          \\\"type\\\": \\\"number\\\",\\n          \\\"description\\\": \\\"Total gross room revenue before OTA commission\\\"\\n        },\\n        \\\"commissionRate\\\": {\\n          \\\"type\\\": \\\"number\\\",\\n          \\\"description\\\": \\\"OTA commission percentage (0 to 100)\\\"\\n        },\\n        \\\"commissionAmount\\\": {\\n          \\\"type\\\": \\\"number\\\",\\n          \\\"description\\\": \\\"Nominal OTA commission deduction in IDR\\\"\\n        },\\n        \\\"netRevenue\\\": {\\n          \\\"type\\\": \\\"number\\\",\\n          \\\"description\\\": \\\"Net room revenue after commission deduction\\\"\\n        },\\n        \\\"status\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"description\\\": \\\"Reservation lifecycle status\\\",\\n          \\\"enum\\\": [\\\"Confirmed\\\", \\\"Checked-In\\\", \\\"Checked-Out\\\", \\\"Cancelled\\\"],\\n          \\\"maxLength\\\": 20\\n        },\\n        \\\"monthKey\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"description\\\": \\\"Accounting month key YYYY-MM\\\",\\n          \\\"minLength\\\": 7,\\n          \\\"maxLength\\\": 10\\n        },\\n        \\\"createdAt\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"format\\\": \\\"date-time\\\",\\n          \\\"description\\\": \\\"Server creation timestamp\\\"\\n        },\\n        \\\"updatedAt\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"format\\\": \\\"date-time\\\",\\n          \\\"description\\\": \\\"Server update timestamp\\\"\\n        }\\n      },\\n      \\\"required\\\": [\\n        \\\"ownerId\\\",\\n        \\\"bookingCode\\\",\\n        \\\"guestName\\\",\\n        \\\"roomId\\\",\\n        \\\"roomNumber\\\",\\n        \\\"roomType\\\",\\n        \\\"checkIn\\\",\\n        \\\"checkOut\\\",\\n        \\\"nights\\\",\\n        \\\"channel\\\",\\n        \\\"grossRevenue\\\",\\n        \\\"commissionRate\\\",\\n        \\\"commissionAmount\\\",\\n        \\\"netRevenue\\\",\\n        \\\"status\\\",\\n        \\\"monthKey\\\",\\n        \\\"createdAt\\\",\\n        \\\"updatedAt\\\"\\n      ]\\n    },\\n    \\\"Expense\\\": {\\n      \\\"title\\\": \\\"Expense\\\",\\n      \\\"description\\\": \\\"Monthly operational expense entry across 7 accounting categories\\\",\\n      \\\"type\\\": \\\"object\\\",\\n      \\\"properties\\\": {\\n        \\\"ownerId\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"description\\\": \\\"Authenticated user UID owning this record\\\",\\n          \\\"minLength\\\": 1,\\n          \\\"maxLength\\\": 128,\\n          \\\"pattern\\\": \\\"^[a-zA-Z0-9_\\\\\\\\-]+$\\\"\\n        },\\n        \\\"category\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"description\\\": \\\"Expense category\\\",\\n          \\\"enum\\\": [\\n            \\\"Gaji Staf & Operasional SDM\\\",\\n            \\\"Listrik, Air, WiFi & Gas (Utilities)\\\",\\n            \\\"Housekeeping, Laundry & Amenities\\\",\\n            \\\"Bahan Baku Sarapan (F&B Cost)\\\",\\n            \\\"Maintenance & Perbaikan Rutin\\\",\\n            \\\"Marketing & Promosi\\\",\\n            \\\"Depresiasi Aset & Peralatan\\\"\\n          ],\\n          \\\"maxLength\\\": 80\\n        },\\n        \\\"description\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"description\\\": \\\"Expense item description\\\",\\n          \\\"minLength\\\": 1,\\n          \\\"maxLength\\\": 200\\n        },\\n        \\\"amount\\\": {\\n          \\\"type\\\": \\\"number\\\",\\n          \\\"description\\\": \\\"Expense amount in IDR\\\"\\n        },\\n        \\\"date\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"description\\\": \\\"Transaction date YYYY-MM-DD\\\",\\n          \\\"minLength\\\": 10,\\n          \\\"maxLength\\\": 20\\n        },\\n        \\\"monthKey\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"description\\\": \\\"Accounting month key YYYY-MM\\\",\\n          \\\"minLength\\\": 7,\\n          \\\"maxLength\\\": 10\\n        },\\n        \\\"createdAt\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"format\\\": \\\"date-time\\\",\\n          \\\"description\\\": \\\"Server creation timestamp\\\"\\n        },\\n        \\\"updatedAt\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"format\\\": \\\"date-time\\\",\\n          \\\"description\\\": \\\"Server update timestamp\\\"\\n        }\\n      },\\n      \\\"required\\\": [\\n        \\\"ownerId\\\",\\n        \\\"category\\\",\\n        \\\"description\\\",\\n        \\\"amount\\\",\\n        \\\"date\\\",\\n        \\\"monthKey\\\",\\n        \\\"createdAt\\\",\\n        \\\"updatedAt\\\"\\n      ]\\n    },\\n    \\\"PropertySettings\\\": {\\n      \\\"title\\\": \\\"PropertySettings\\\",\\n      \\\"description\\\": \\\"Rate plan and OTA commission percentage configuration\\\",\\n      \\\"type\\\": \\\"object\\\",\\n      \\\"properties\\\": {\\n        \\\"ownerId\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"description\\\": \\\"Authenticated user UID owning this configuration\\\",\\n          \\\"minLength\\\": 1,\\n          \\\"maxLength\\\": 128,\\n          \\\"pattern\\\": \\\"^[a-zA-Z0-9_\\\\\\\\-]+$\\\"\\n        },\\n        \\\"standardWeekday\\\": {\\n          \\\"type\\\": \\\"number\\\",\\n          \\\"description\\\": \\\"Standard room weekday price\\\"\\n        },\\n        \\\"standardWeekend\\\": {\\n          \\\"type\\\": \\\"number\\\",\\n          \\\"description\\\": \\\"Standard room weekend price\\\"\\n        },\\n        \\\"deluxeWeekday\\\": {\\n          \\\"type\\\": \\\"number\\\",\\n          \\\"description\\\": \\\"Deluxe room weekday price\\\"\\n        },\\n        \\\"deluxeWeekend\\\": {\\n          \\\"type\\\": \\\"number\\\",\\n          \\\"description\\\": \\\"Deluxe room weekend price\\\"\\n        },\\n        \\\"familySuiteRate\\\": {\\n          \\\"type\\\": \\\"number\\\",\\n          \\\"description\\\": \\\"Family suite all-day price\\\"\\n        },\\n        \\\"commAirbnb\\\": {\\n          \\\"type\\\": \\\"number\\\",\\n          \\\"description\\\": \\\"Airbnb commission percentage\\\"\\n        },\\n        \\\"commTraveloka\\\": {\\n          \\\"type\\\": \\\"number\\\",\\n          \\\"description\\\": \\\"Traveloka commission percentage\\\"\\n        },\\n        \\\"commTiket\\\": {\\n          \\\"type\\\": \\\"number\\\",\\n          \\\"description\\\": \\\"Tiket.com commission percentage\\\"\\n        },\\n        \\\"commAgoda\\\": {\\n          \\\"type\\\": \\\"number\\\",\\n          \\\"description\\\": \\\"Agoda commission percentage\\\"\\n        },\\n        \\\"commBooking\\\": {\\n          \\\"type\\\": \\\"number\\\",\\n          \\\"description\\\": \\\"Booking.com commission percentage\\\"\\n        },\\n        \\\"lastOtaSync\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"description\\\": \\\"ISO timestamp of last OTA availability sync\\\",\\n          \\\"minLength\\\": 1,\\n          \\\"maxLength\\\": 64\\n        },\\n        \\\"updatedAt\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"format\\\": \\\"date-time\\\",\\n          \\\"description\\\": \\\"Server update timestamp\\\"\\n        }\\n      },\\n      \\\"required\\\": [\\n        \\\"ownerId\\\",\\n        \\\"standardWeekday\\\",\\n        \\\"standardWeekend\\\",\\n        \\\"deluxeWeekday\\\",\\n        \\\"deluxeWeekend\\\",\\n        \\\"familySuiteRate\\\",\\n        \\\"commAirbnb\\\",\\n        \\\"commTraveloka\\\",\\n        \\\"commTiket\\\",\\n        \\\"commAgoda\\\",\\n        \\\"commBooking\\\",\\n        \\\"lastOtaSync\\\",\\n        \\\"updatedAt\\\"\\n      ]\\n    }\\n  },\\n  \\\"firestore\\\": {\\n    \\\"/rooms/{roomId}\\\": {\\n      \\\"schema\\\": { \\\"$ref\\\": \\\"#/entities/Room\\\" },\\n      \\\"description\\\": \\\"Stores room units and housekeeping status for the property\\\"\\n    },\\n    \\\"/reservations/{reservationId}\\\": {\\n      \\\"schema\\\": { \\\"$ref\\\": \\\"#/entities/Reservation\\\" },\\n      \\\"description\\\": \\\"Stores guest reservations and OTA revenue calculations\\\"\\n    },\\n    \\\"/expenses/{expenseId}\\\": {\\n      \\\"schema\\\": { \\\"$ref\\\": \\\"#/entities/Expense\\\" },\\n      \\\"description\\\": \\\"Stores monthly operational expenses across 7 categories\\\"\\n    },\\n    \\\"/settings/{settingId}\\\": {\\n      \\\"schema\\\": { \\\"$ref\\\": \\\"#/entities/PropertySettings\\\" },\\n      \\\"description\\\": \\\"Stores rate plan prices and OTA commission settings\\\"\\n    }\\n  }\\n}\\n\", \"Description\":\"Create firebase-blueprint.json defining Room, Reservation, Expense, and PropertySettings schemas\", \"Overwrite\":true, \"TargetFile\":\"/firebase-blueprint.json\", \"toolAction\":\"Creating firebase-blueprint.json\", \"toolSummary\":\"Create firebase-blueprint.json\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_2346720"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"# Security Specification \342\200\224 Hotel Putri Sari HMS & Channel Manager\\n\\n## 1. Data Invariants\\n1. **Identity Ownership Invariant**: Every document in `/rooms/{roomId}`, `/reservations/{reservationId}`, `/expenses/{expenseId}`, and `/settings/{settingId}` must have `ownerId == request.auth.uid` and require `request.auth.token.email_verified == true` (or bootstrapped admin `jajapintravel@gmail.com` with `email_verified == true`).\\n2. **Immutable Ownership & Creation Time**: `ownerId` and `createdAt` can never be mutated during an `update` operation (`incoming().ownerId == existing().ownerId` and `incoming().createdAt == existing().createdAt`).\\n3. **Server Timestamp Integrity**: Every `create` operation must set `createdAt == request.time` (where present) and `updatedAt == request.time`. Every `update` operation must set `updatedAt == request.time`.\\n4. **Strict Key & Enum Enforcement**: Every collection enforces exact `hasAll` and `hasOnly` key sets on creation, and explicit action-based `affectedKeys().hasOnly(...)` on update wrapped inside `isValid[Entity](incoming())`.\\n5. **Path ID Hardening**: All single-document operations (`get`, `create`, `update`, `delete`) validate document IDs using `isValidId(id)` matching `^[a-zA-Z0-9_\\\\-]+$` with length `<= 128`.\\n6. **Query Enforcer on List**: All `allow list` rules explicitly validate `resource.data.ownerId == request.auth.uid` (or `isAdmin()`).\\n\\n## 2. The \\\"Dirty Dozen\\\" Payloads\\n1. **Unverified Admin Email Spoof**: `{ auth: { uid: \\\"spoof\\\", token: { email: \\\"jajapintravel@gmail.com\\\", email_verified: false } } }` -> Rejected (`PERMISSION_DENIED`).\\n2. **Shadow Field Injection on Room Create**: `{ ...validRoom, isSuperRoom: true }` -> Rejected by `data.keys().hasOnly(...)` (`PERMISSION_DENIED`).\\n3. **Cross-Tenant Owner Spoofing on Reservation Create**: `{ ...validReservation, ownerId: \\\"other_user_uid\\\" }` -> Rejected by `data.ownerId == request.auth.uid` (`PERMISSION_DENIED`).\\n4. **Update-Gap Value Poisoning on Room Update**: Updating `status` to `\\\"HackedStatus\\\"` -> Rejected because `isValidRoom(incoming())` wraps the `allow update` rule (`PERMISSION_DENIED`).\\n5. **Immutable Field Mutation on Reservation Update**: Changing `createdAt` or `ownerId` during `update` -> Rejected by immutability guard (`PERMISSION_DENIED`).\\n6. **Client Timestamp Forgery**: Setting `updatedAt` to a past/future timestamp instead of `request.time` -> Rejected (`PERMISSION_DENIED`).\\n7. **ID Poisoning Attack**: Creating `/rooms/invalid$id!with*spaces` -> Rejected by `isValidId(roomId)` (`PERMISSION_DENIED`).\\n8. **Denial-of-Wallet Oversized String**: Creating an Expense with a 5,000-character `description` -> Rejected by `data.description.size() <= 200` (`PERMISSION_DENIED`).\\n9. **Negative Revenue/Expense Injection**: Creating an Expense with `amount: -500000` -> Rejected by `data.amount >= 0` (`PERMISSION_DENIED`).\\n10. **Invalid OTA Channel Enum**: Creating a Reservation with `channel: \\\"UnknownOTA\\\"` -> Rejected by enum allowlist (`PERMISSION_DENIED`).\\n11. **Unauthorized Blanket List Query**: Listing `/reservations` without filtering by `ownerId == request.auth.uid` -> Rejected by `resource.data.ownerId == request.auth.uid` (`PERMISSION_DENIED`).\\n12. **Unauthorised Field Update on Room Housekeeping**: Modifying `roomNumber` during a status update action -> Rejected by `affectedKeys().hasOnly(...)` (`PERMISSION_DENIED`).\\n\\n## 3. Red Team Conflict Report\\n- **Identity Spoofing**: Blocked on all 4 collections via `data.ownerId == request.auth.uid` and `request.auth.token.email_verified == true`.\\n- **State Shortcutting**: Room and Reservation statuses are strictly constrained to valid enums (`Available`, `Occupied`, `Dirty`, `Maintenance` and `Confirmed`, `Checked-In`, `Checked-Out`, `Cancelled`).\\n- **Resource Poisoning**: All strings have explicit `.size()` upper bounds matching `firebase-blueprint.json`, and all path IDs require `isValidId()`.\\n- **Value Poisoning on Update**: Every `allow update` block begins with `isValid[Entity](incoming())` before checking `affectedKeys().hasOnly(...)`.\\n\", \"Description\":\"Create security_spec.md documenting invariants, Dirty Dozen payloads, and Red Team audit\", \"Overwrite\":true, \"TargetFile\":\"/security_spec.md\", \"toolAction\":\"Creating security_spec.md\", \"toolSummary\":\"Create security_spec.md\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_2346735"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import firebaseRulesPlugin from \'@firebase/eslint-plugin-security-rules\';\\n\\nexport default [\\n  {\\n    ignores: [\'dist/**/*\', \'node_modules/**/*\']\\n  },\\n  firebaseRulesPlugin.configs[\'flat/recommended\']\\n];\\n\", \"Description\":\"Create eslint.config.mjs for Firestore security rules linting\", \"Overwrite\":true, \"TargetFile\":\"/eslint.config.mjs\", \"toolAction\":\"Creating eslint.config.mjs\", \"toolSummary\":\"Create eslint.config.mjs\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_2347148"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"rules_version = \'2\';\\nservice cloud.firestore {\\n  match /databases/{database}/documents {\\n    match /{document=**} {\\n      allow read, write: if false;\\n    }\\n\\n    function isValidId(id) {\\n      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches(\'^[a-zA-Z0-9_\\\\\\\\-]+$\');\\n    }\\n\\n    function incoming() {\\n      return request.resource.data;\\n    }\\n\\n    function existing() {\\n      return resource.data;\\n    }\\n\\n    function isSignedIn() {\\n      return request.auth != null && request.auth.token.email_verified == true;\\n    }\\n\\n    function isAdmin() {\\n      return isSignedIn() && (\\n        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||\\n        request.auth.token.email == \'jajapintravel@gmail.com\'\\n      );\\n    }\\n\\n    function isValidRoom(data) {\\n      return data.keys().hasAll([\\n        \'ownerId\', \'roomNumber\', \'name\', \'type\', \'physicalCategory\',\\n        \'status\', \'weekdayRate\', \'weekendRate\', \'includesBreakfast\', \'updatedAt\'\\n      ]) &&\\n      data.keys().hasOnly([\\n        \'ownerId\', \'roomNumber\', \'name\', \'type\', \'physicalCategory\',\\n        \'status\', \'weekdayRate\', \'weekendRate\', \'includesBreakfast\', \'updatedAt\'\\n      ]) &&\\n      data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&\\n      data.ownerId.matches(\'^[a-zA-Z0-9_\\\\\\\\-]+$\') &&\\n      data.ownerId == request.auth.uid &&\\n      data.roomNumber is string && data.roomNumber.size() >= 1 && data.roomNumber.size() <= 16 &&\\n      data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&\\n      data.type is string && data.type.size() <= 40 &&\\n      data.type in [\'Standard Room\', \'Deluxe Room\', \'Family Suite\'] &&\\n      data.physicalCategory is string && data.physicalCategory.size() <= 40 &&\\n      data.physicalCategory in [\'Deluxe Room\', \'Standard AC\', \'Room Ekonomi Kipas\'] &&\\n      data.status is string && data.status.size() <= 20 &&\\n      data.status in [\'Available\', \'Occupied\', \'Dirty\', \'Maintenance\'] &&\\n      data.weekdayRate is number && data.weekdayRate >= 0 && data.weekdayRate <= 100000000 &&\\n      data.weekendRate is number && data.weekendRate >= 0 && data.weekendRate <= 100000000 &&\\n      data.includesBreakfast is bool &&\\n      data.updatedAt is timestamp && data.updatedAt == request.time;\\n    }\\n\\n    function isValidReservation(data) {\\n      return data.keys().hasAll([\\n        \'ownerId\', \'bookingCode\', \'guestName\', \'roomId\', \'roomNumber\', \'roomType\',\\n        \'checkIn\', \'checkOut\', \'nights\', \'channel\', \'grossRevenue\', \'commissionRate\',\\n        \'commissionAmount\', \'netRevenue\', \'status\', \'monthKey\', \'createdAt\', \'updatedAt\'\\n      ]) &&\\n      data.keys().hasOnly([\\n        \'ownerId\', \'bookingCode\', \'guestName\', \'roomId\', \'roomNumber\', \'roomType\',\\n        \'checkIn\', \'checkOut\', \'nights\', \'channel\', \'grossRevenue\', \'commissionRate\',\\n        \'commissionAmount\', \'netRevenue\', \'status\', \'monthKey\', \'createdAt\', \'updatedAt\'\\n      ]) &&\\n      data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&\\n      data.ownerId.matches(\'^[a-zA-Z0-9_\\\\\\\\-]+$\') &&\\n      data.ownerId == request.auth.uid &&\\n      data.bookingCode is string && data.bookingCode.size() >= 1 && data.bookingCode.size() <= 40 &&\\n      data.guestName is string && data.guestName.size() >= 1 && data.guestName.size() <= 120 &&\\n      data.roomId is string && data.roomId.size() >= 1 && data.roomId.size() <= 64 &&\\n      data.roomNumber is string && data.roomNumber.size() >= 1 && data.roomNumber.size() <= 16 &&\\n      data.roomType is string && data.roomType.size() <= 40 &&\\n      data.roomType in [\'Standard Room\', \'Deluxe Room\', \'Family Suite\'] &&\\n      data.checkIn is string && data.checkIn.size() >= 10 && data.checkIn.size() <= 20 &&\\n      data.checkOut is string && data.checkOut.size() >= 10 && data.checkOut.size() <= 20 &&\\n      data.nights is number && data.nights >= 1 && data.nights <= 365 &&\\n      data.channel is string && data.channel.size() <= 40 &&\\n      data.channel in [\'Direct Booking\', \'Airbnb\', \'Traveloka\', \'Tiket.com\', \'Agoda\', \'Booking.com\'] &&\\n      data.grossRevenue is number && data.grossRevenue >= 0 && data.grossRevenue <= 1000000000 &&\\n      data.commissionRate is number && data.commissionRate >= 0 && data.commissionRate <= 100 &&\\n      data.commissionAmount is number && data.commissionAmount >= 0 && data.commissionAmount <= 1000000000 &&\\n      data.netRevenue is number && data.netRevenue >= 0 && data.netRevenue <= 1000000000 &&\\n      data.status is string && data.status.size() <= 20 &&\\n      data.status in [\'Confirmed\', \'Checked-In\', \'Checked-Out\', \'Cancelled\'] &&\\n      data.monthKey is string && data.monthKey.size() >= 7 && data.monthKey.size() <= 10 &&\\n      data.createdAt is timestamp &&\\n      data.updatedAt is timestamp && data.updatedAt == request.time;\\n    }\\n\\n    function isValidExpense(data) {\\n      return data.keys().hasAll([\\n        \'ownerId\', \'category\', \'description\', \'amount\', \'date\', \'monthKey\', \'createdAt\', \'updatedAt\'\\n      ]) &&\\n      data.keys().hasOnly([\\n        \'ownerId\', \'category\', \'description\', \'amount\', \'date\', \'monthKey\', \'createdAt\', \'updatedAt\'\\n      ]) &&\\n      data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&\\n      data.ownerId.matches(\'^[a-zA-Z0-9_\\\\\\\\-]+$\') &&\\n      data.ownerId == request.auth.uid &&\\n      data.category is string && data.category.size() <= 80 &&\\n      data.category in [\\n        \'Gaji Staf & Operasional SDM\',\\n        \'Listrik, Air, WiFi & Gas (Utilities)\',\\n        \'Housekeeping, Laundry & Amenities\',\\n        \'Bahan Baku Sarapan (F&B Cost)\',\\n        \'Maintenance & Perbaikan Rutin\',\\n        \'Marketing & Promosi\',\\n        \'Depresiasi Aset & Peralatan\'\\n      ] &&\\n      data.description is string && data.description.size() >= 1 && data.description.size() <= 200 &&\\n      data.amount is number && data.amount >= 0 && data.amount <= 1000000000 &&\\n      data.date is string && data.date.size() >= 10 && data.date.size() <= 20 &&\\n      data.monthKey is string && data.monthKey.size() >= 7 && data.monthKey.size() <= 10 &&\\n      data.createdAt is timestamp &&\\n      data.updatedAt is timestamp && data.updatedAt == request.time;\\n    }\\n\\n    function isValidSettings(data) {\\n      return data.keys().hasAll([\\n        \'ownerId\', \'standardWeekday\', \'standardWeekend\', \'deluxeWeekday\', \'deluxeWeekend\',\\n        \'familySuiteRate\', \'commAirbnb\', \'commTraveloka\', \'commTiket\', \'commAgoda\',\\n        \'commBooking\', \'lastOtaSync\', \'updatedAt\'\\n      ]) &&\\n      data.keys().hasOnly([\\n        \'ownerId\', \'standardWeekday\', \'standardWeekend\', \'deluxeWeekday\', \'deluxeWeekend\',\\n        \'familySuiteRate\', \'commAirbnb\', \'commTraveloka\', \'commTiket\', \'commAgoda\',\\n        \'commBooking\', \'lastOtaSync\', \'updatedAt\'\\n      ]) &&\\n      data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&\\n      data.ownerId.matches(\'^[a-zA-Z0-9_\\\\\\\\-]+$\') &&\\n      data.ownerId == request.auth.uid &&\\n      data.standardWeekday is number && data.standardWeekday >= 0 && data.standardWeekday <= 100000000 &&\\n      data.standardWeekend is number && data.standardWeekend >= 0 && data.standardWeekend <= 100000000 &&\\n      data.deluxeWeekday is number && data.deluxeWeekday >= 0 && data.deluxeWeekday <= 100000000 &&\\n      data.deluxeWeekend is number && data.deluxeWeekend >= 0 && data.deluxeWeekend <= 100000000 &&\\n      data.familySuiteRate is number && data.familySuiteRate >= 0 && data.familySuiteRate <= 100000000 &&\\n      data.commAirbnb is number && data.commAirbnb >= 0 && data.commAirbnb <= 100 &&\\n      data.commTraveloka is number && data.commTraveloka >= 0 && data.commTraveloka <= 100 &&\\n      data.commTiket is number && data.commTiket >= 0 && data.commTiket <= 100 &&\\n      data.commAgoda is number && data.commAgoda >= 0 && data.commAgoda <= 100 &&\\n      data.commBooking is number && data.commBooking >= 0 && data.commBooking <= 100 &&\\n      data.lastOtaSync is string && data.lastOtaSync.size() >= 1 && data.lastOtaSync.size() <= 64 &&\\n      data.updatedAt is timestamp && data.updatedAt == request.time;\\n    }\\n\\n    match /rooms/{roomId} {\\n      allow get: if isSignedIn() && isValidId(roomId) && (existing().ownerId == request.auth.uid || isAdmin());\\n      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());\\n      allow create: if isSignedIn() && isValidId(roomId) && isValidRoom(incoming());\\n      allow update: if isSignedIn() && isValidId(roomId) && isValidRoom(incoming()) &&\\n        incoming().ownerId == existing().ownerId && (\\n          isAdmin() ||\\n          (existing().ownerId == request.auth.uid &&\\n            incoming().diff(existing()).affectedKeys().hasOnly([\\n              \'status\', \'weekdayRate\', \'weekendRate\', \'type\', \'physicalCategory\', \'name\', \'includesBreakfast\', \'updatedAt\'\\n            ])\\n          )\\n        );\\n      allow delete: if isSignedIn() && isValidId(roomId) && (existing().ownerId == request.auth.uid || isAdmin());\\n    }\\n\\n    match /reservations/{reservationId} {\\n      allow get: if isSignedIn() && isValidId(reservationId) && (existing().ownerId == request.auth.uid || isAdmin());\\n      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());\\n      allow create: if isSignedIn() && isValidId(reservationId) && isValidReservation(incoming()) &&\\n        incoming().createdAt == request.time;\\n      allow update: if isSignedIn() && isValidId(reservationId) && isValidReservation(incoming()) &&\\n        incoming().ownerId == existing().ownerId &&\\n        incoming().createdAt == existing().createdAt && (\\n          isAdmin() ||\\n          (existing().ownerId == request.auth.uid &&\\n            existing().status != \'Cancelled\' &&\\n            incoming().diff(existing()).affectedKeys().hasOnly([\\n              \'status\', \'guestName\', \'checkIn\', \'checkOut\', \'nights\', \'channel\',\\n              \'grossRevenue\', \'commissionRate\', \'commissionAmount\', \'netRevenue\', \'updatedAt\'\\n            ])\\n          )\\n        );\\n      allow delete: if isSignedIn() && isValidId(reservationId) && (existing().ownerId == request.auth.uid || isAdmin());\\n    }\\n\\n    match /expenses/{expenseId} {\\n      allow get: if isSignedIn() && isValidId(expenseId) && (existing().ownerId == request.auth.uid || isAdmin());\\n      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());\\n      allow create: if isSignedIn() && isValidId(expenseId) && isValidExpense(incoming()) &&\\n        incoming().createdAt == request.time;\\n      allow update: if isSignedIn() && isValidId(expenseId) && isValidExpense(incoming()) &&\\n        incoming().ownerId == existing().ownerId &&\\n        incoming().createdAt == existing().createdAt && (\\n          isAdmin() ||\\n          (existing().ownerId == request.auth.uid &&\\n            incoming().diff(existing()).affectedKeys().hasOnly([\\n              \'category\', \'description\', \'amount\', \'date\', \'monthKey\', \'updatedAt\'\\n            ])\\n          )\\n        );\\n      allow delete: if isSignedIn() && isValidId(expenseId) && (existing().ownerId == request.auth.uid || isAdmin());\\n    }\\n\\n    match /settings/{settingId} {\\n      allow get: if isSignedIn() && isValidId(settingId) && (existing().ownerId == request.auth.uid || isAdmin());\\n      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());\\n      allow create: if isSignedIn() && isValidId(settingId) && isValidSettings(incoming());\\n      allow update: if isSignedIn() && isValidId(settingId) && isValidSettings(incoming()) &&\\n        incoming().ownerId == existing().ownerId && (\\n          isAdmin() ||\\n          (existing().ownerId == request.auth.uid &&\\n            incoming().diff(existing()).affectedKeys().hasOnly([\\n              \'standardWeekday\', \'standardWeekend\', \'deluxeWeekday\', \'deluxeWeekend\',\\n              \'familySuiteRate\', \'commAirbnb\', \'commTraveloka\', \'commTiket\', \'commAgoda\',\\n              \'commBooking\', \'lastOtaSync\', \'updatedAt\'\\n            ])\\n          )\\n        );\\n      allow delete: if isSignedIn() && isValidId(settingId) && (existing().ownerId == request.auth.uid || isAdmin());\\n    }\\n  }\\n}\\n\", \"Description\":\"Create DRAFT_firestore.rules with hardened validation helpers and 8-pillar compliance\", \"Overwrite\":true, \"TargetFile\":\"/DRAFT_firestore.rules\", \"toolAction\":\"Creating DRAFT_firestore.rules\", \"toolSummary\":\"Create DRAFT_firestore.rules\"}"
      original_name: "write_to_file"
