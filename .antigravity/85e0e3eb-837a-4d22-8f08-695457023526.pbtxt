      arguments_json: "{\"CodeContent\":\"import React from \'react\';\\nimport {\\n  AppViewId,\\n  MonthlyProfitLossReport,\\n  ReservationRecord,\\n  RoomUnit,\\n  UserRole,\\n} from \'../types/hms\';\\nimport { formatIDR } from \'../utils/hotelCalculations\';\\nimport { HOTEL_PHOTOS } from \'../data/initialData\';\\nimport {\\n  ArrowRight,\\n  BedDouble,\\n  CalendarCheck,\\n  RefreshCw,\\n  TrendingUp,\\n  Wallet,\\n} from \'lucide-react\';\\n\\ninterface ExecutiveDashboardProps {\\n  role: UserRole;\\n  rooms: RoomUnit[];\\n  reservations: ReservationRecord[];\\n  pnlReport: MonthlyProfitLossReport;\\n  selectedMonth: string;\\n  onSelectMonth: (m: string) => void;\\n  onNavigate: (view: AppViewId) => void;\\n  onSyncOta: () => void;\\n  isSyncingOta: boolean;\\n  lastOtaSync: string;\\n}\\n\\nexport const ExecutiveDashboard: React.FC<ExecutiveDashboardProps> = ({\\n  role,\\n  rooms,\\n  reservations,\\n  pnlReport,\\n  selectedMonth,\\n  onSelectMonth,\\n  onNavigate,\\n  onSyncOta,\\n  isSyncingOta,\\n  lastOtaSync,\\n}) => {\\n  const availableCount = rooms.filter((r) => r.status === \'Available\').length;\\n  const occupiedCount = rooms.filter((r) => r.status === \'Occupied\').length;\\n  const dirtyCount = rooms.filter((r) => r.status === \'Dirty\').length;\\n  const maintenanceCount = rooms.filter((r) => r.status === \'Maintenance\').length;\\n\\n  const deluxeCount = rooms.filter((r) => r.physicalCategory === \'Deluxe Room\').length;\\n  const standardAcCount = rooms.filter((r) => r.physicalCategory === \'Standard AC\').length;\\n  const ekonomiFanCount = rooms.filter(\\n    (r) => r.physicalCategory === \'Room Ekonomi Kipas\'\\n  ).length;\\n\\n  const maxChannelGross = Math.max(\\n    1,\\n    ...pnlReport.channelRows.map((c) => c.grossRevenue)\\n  );\\n\\n  const recentReservations = reservations\\n    .filter((r) => r.monthKey === selectedMonth)\\n    .slice(0, 6);\\n\\n  return (\\n    <div className=\\\"space-y-6\\\">\\n      {/* Property Showcase & Action Bar */}\\n      <div className=\\\"bg-white border border-slate-200 rounded-xl p-6\\\">\\n        <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch\\\">\\n          <div className=\\\"lg:col-span-8 flex flex-col justify-between space-y-4\\\">\\n            <div className=\\\"space-y-2\\\">\\n              <div className=\\\"flex flex-wrap items-center gap-2 text-xs text-slate-500\\\">\\n                <span>Single Property HMS & Channel Manager</span>\\n                <span aria-hidden=\\\"true\\\">\302\267</span>\\n                <span>15 Unit Kamar Aktif</span>\\n                <span aria-hidden=\\\"true\\\">\302\267</span>\\n                <span>Sinkronisasi Terakhir: {lastOtaSync}</span>\\n              </div>\\n              <h1 className=\\\"text-2xl sm:text-3xl font-bold tracking-tight text-slate-900\\\">\\n                Hotel Putri Sari \342\200\224 Executive Performance\\n              </h1>\\n              <p className=\\\"text-sm text-slate-600 max-w-2xl leading-relaxed\\\">\\n                Komposisi fisik properti: {deluxeCount} Deluxe Room (AC & Sprei Hijau),{\' \'}\\n                {standardAcCount} Standard AC (Sprei Oranye), dan {ekonomiFanCount} Room\\n                Ekonomi Kipas (termasuk 2 unit konfigurasi Family Suite). Terintegrasi\\n                otomatis dengan 6 Channel OTA dan Laporan Laba Rugi Bulanan.\\n              </p>\\n            </div>\\n\\n            <div className=\\\"flex flex-wrap items-center gap-3 pt-2\\\">\\n              <div className=\\\"flex items-center gap-2\\\">\\n                <label\\n                  htmlFor=\\\"dashboard-month-select\\\"\\n                  className=\\\"text-xs font-medium text-slate-600\\\"\\n                >\\n                  Periode Akuntansi:\\n                </label>\\n                <select\\n                  id=\\\"dashboard-month-select\\\"\\n                  value={selectedMonth}\\n                  onChange={(e) => onSelectMonth(e.target.value)}\\n                  className=\\\"px-3 py-2 text-xs font-mono bg-slate-50 border border-slate-300 rounded-lg text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900\\\"\\n                >\\n                  <option value=\\\"2026-10\\\">Oktober 2026 (Bulan Berjalan)</option>\\n                  <option value=\\\"2026-09\\\">September 2026</option>\\n                </select>\\n              </div>\\n\\n              <button\\n                type=\\\"button\\\"\\n                onClick={onSyncOta}\\n                disabled={isSyncingOta}\\n                className=\\\"inline-flex items-center gap-2 px-4 py-2 text-xs font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-lg transition-colors whitespace-nowrap shrink-0 disabled:opacity-60\\\"\\n              >\\n                <RefreshCw\\n                  className={`w-3.5 h-3.5 ${isSyncingOta ? \'animate-spin\' : \'\'}`}\\n                />\\n                <span>\\n                  {isSyncingOta ? \'Menyinkronkan 6 OTA...\' : \'Sync OTA Availability\'}\\n                </span>\\n              </button>\\n\\n              {role !== UserRole.RESEPSIONIS && (\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => onNavigate(\'financial_report\')}\\n                  className=\\\"inline-flex items-center gap-2 px-4 py-2 text-xs font-semibold text-slate-800 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors whitespace-nowrap shrink-0\\\"\\n                >\\n                  <span>Buka Laporan Profit & Loss</span>\\n                  <ArrowRight className=\\\"w-3.5 h-3.5\\\" />\\n                </button>\\n              )}\\n            </div>\\n          </div>\\n\\n          <div className=\\\"lg:col-span-4 relative rounded-lg overflow-hidden border border-slate-200 min-h-[180px] bg-slate-900\\\">\\n            <img\\n              src={HOTEL_PHOTOS.exterior}\\n              alt=\\\"Tampak Depan Hotel Putri Sari\\\"\\n              referrerPolicy=\\\"no-referrer\\\"\\n              className=\\\"w-full h-full object-cover\\\"\\n            />\\n            <div className=\\\"absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent flex flex-col justify-end p-4 text-white\\\">\\n              <p className=\\\"text-xs font-mono text-slate-200\\\">\\n                JAJAPIN \302\267 HOTEL PUTRI SARI\\n              </p>\\n              <p className=\\\"text-sm font-semibold\\\">\\n                5 Deluxe \302\267 5 Standard AC \302\267 5 Ekonomi Kipas\\n              </p>\\n            </div>\\n          </div>\\n        </div>\\n      </div>\\n\\n      {/* Primary KPI Grid (6 Key Metrics) */}\\n      <div className=\\\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-4\\\">\\n        <div className=\\\"bg-white border border-slate-200 rounded-xl p-4\\\">\\n          <p className=\\\"text-xs text-slate-500\\\">Occupancy Rate ({selectedMonth})</p>\\n          <p\\n            data-testid=\\\"kpi-occupancy-rate\\\"\\n            className=\\\"text-xl font-bold font-mono tabular-nums text-slate-900 mt-1\\\"\\n          >\\n            {pnlReport.occupancyRate.toFixed(1)}%\\n          </p>\\n          <p className=\\\"text-xs text-slate-500 mt-1 font-mono tabular-nums\\\">\\n            {pnlReport.totalRoomNightsSold} / {pnlReport.availableRoomNights} malam\\n          </p>\\n        </div>\\n\\n        <div className=\\\"bg-white border border-slate-200 rounded-xl p-4\\\">\\n          <p className=\\\"text-xs text-slate-500\\\">Total Gross Revenue</p>\\n          <p\\n            data-testid=\\\"kpi-gross-revenue\\\"\\n            className=\\\"text-xl font-bold font-mono tabular-nums text-slate-900 mt-1\\\"\\n          >\\n            {formatIDR(pnlReport.totalGrossRevenue)}\\n          </p>\\n          <p className=\\\"text-xs text-slate-500 mt-1 font-mono tabular-nums\\\">\\n            ADR: {formatIDR(pnlReport.adr)}\\n          </p>\\n        </div>\\n\\n        <div className=\\\"bg-white border border-slate-200 rounded-xl p-4\\\">\\n          <p className=\\\"text-xs text-slate-500\\\">Potongan Komisi OTA</p>\\n          <p\\n            data-testid=\\\"kpi-ota-commission\\\"\\n            className=\\\"text-xl font-bold font-mono tabular-nums text-amber-700 mt-1\\\"\\n          >\\n            -{formatIDR(pnlReport.totalCommissionAmount)}\\n          </p>\\n          <p className=\\\"text-xs text-slate-500 mt-1\\\">\\n            6 Sumber Channel Aktif\\n          </p>\\n        </div>\\n\\n        <div className=\\\"bg-white border border-slate-200 rounded-xl p-4\\\">\\n          <p className=\\\"text-xs text-slate-500\\\">Net Room Revenue</p>\\n          <p\\n            data-testid=\\\"kpi-net-room-revenue\\\"\\n            className=\\\"text-xl font-bold font-mono tabular-nums text-slate-900 mt-1\\\"\\n          >\\n            {formatIDR(pnlReport.totalNetRoomRevenue)}\\n          </p>\\n          <p className=\\\"text-xs text-slate-500 mt-1 font-mono tabular-nums\\\">\\n            RevPAR: {formatIDR(pnlReport.revPar)}\\n          </p>\\n        </div>\\n\\n        <div className=\\\"bg-white border border-slate-200 rounded-xl p-4\\\">\\n          <p className=\\\"text-xs text-slate-500\\\">Total Biaya Operasional</p>\\n          <p\\n            data-testid=\\\"kpi-total-expenses\\\"\\n            className=\\\"text-xl font-bold font-mono tabular-nums text-rose-700 mt-1\\\"\\n          >\\n            {formatIDR(pnlReport.totalOperationalExpenses)}\\n          </p>\\n          <p className=\\\"text-xs text-slate-500 mt-1\\\">\\n            7 Kategori Biaya & Depresiasi\\n          </p>\\n        </div>\\n\\n        <div className=\\\"bg-slate-900 text-white border border-slate-900 rounded-xl p-4\\\">\\n          <p className=\\\"text-xs text-slate-300\\\">NET PROFIT AKHIR</p>\\n          <p\\n            data-testid=\\\"kpi-net-profit\\\"\\n            className=\\\"text-xl font-bold font-mono tabular-nums text-emerald-400 mt-1\\\"\\n          >\\n            {formatIDR(pnlReport.netProfit)}\\n          </p>\\n          <p className=\\\"text-xs text-slate-300 mt-1 font-mono tabular-nums\\\">\\n            Margin: {pnlReport.netProfitMargin.toFixed(1)}%\\n          </p>\\n        </div>\\n      </div>\\n\\n      {/* Middle Split: Channel Performance Chart & Real-Time Housekeeping Status */}\\n      <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6\\\">\\n        {/* Perbandingan Pendapatan per Channel OTA */}\\n        <div className=\\\"lg:col-span-7 bg-white border border-slate-200 rounded-xl p-6\\\">\\n          <div className=\\\"flex flex-wrap items-center justify-between gap-2 pb-4 border-b border-slate-100\\\">\\n            <div>\\n              <h2 className=\\\"text-base font-bold text-slate-900\\\">\\n                Grafik Performa Pendapatan per Channel OTA ({selectedMonth})\\n              </h2>\\n              <p className=\\\"text-xs text-slate-500\\\">\\n                Perbandingan Gross Revenue, Potongan Komisi OTA, dan Net Room Revenue\\n              </p>\\n            </div>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => onNavigate(\'reservations\')}\\n              className=\\\"text-xs font-semibold text-slate-700 hover:text-slate-900 underline whitespace-nowrap shrink-0\\\"\\n            >\\n              Kelola Reservasi & OTA\\n            </button>\\n          </div>\\n\\n          <div className=\\\"space-y-4 mt-5\\\">\\n            {pnlReport.channelRows.map((row) => {\\n              const widthPct = Math.max(\\n                4,\\n                Math.round((row.grossRevenue / maxChannelGross) * 100)\\n              );\\n              const netRatio =\\n                row.grossRevenue > 0\\n                  ? Math.round((row.netRevenue / row.grossRevenue) * 100)\\n                  : 100;\\n\\n              return (\\n                <div key={row.channel} className=\\\"space-y-1.5\\\">\\n                  <div className=\\\"flex items-center justify-between text-xs\\\">\\n                    <div className=\\\"flex items-center gap-2\\\">\\n                      <span className=\\\"font-semibold text-slate-900\\\">\\n                        {row.channel}\\n                      </span>\\n                      <span className=\\\"text-slate-400\\\" aria-hidden=\\\"true\\\">\\n                        \302\267\\n                      </span>\\n                      <span className=\\\"text-slate-500 font-mono tabular-nums\\\">\\n                        {row.roomNights} malam ({row.bookingsCount} booking)\\n                      </span>\\n                      <span className=\\\"text-slate-400\\\" aria-hidden=\\\"true\\\">\\n                        \302\267\\n                      </span>\\n                      <span className=\\\"text-slate-500 font-mono tabular-nums\\\">\\n                        Komisi {row.commissionRate}%\\n                      </span>\\n                    </div>\\n                    <div className=\\\"text-right font-mono tabular-nums\\\">\\n                      <span className=\\\"text-slate-500\\\">\\n                        Gross {formatIDR(row.grossRevenue)}\\n                      </span>\\n                      <span className=\\\"mx-1.5 text-slate-300\\\">/</span>\\n                      <span className=\\\"font-semibold text-emerald-700\\\">\\n                        Net {formatIDR(row.netRevenue)}\\n                      </span>\\n                    </div>\\n                  </div>\\n\\n                  <div className=\\\"w-full h-3 bg-slate-100 rounded overflow-hidden\\\">\\n                    <div\\n                      className=\\\"h-full flex rounded overflow-hidden transition-all duration-200\\\"\\n                      style={{ width: `${widthPct}%` }}\\n                    >\\n                      <div\\n                        className=\\\"bg-slate-900 h-full\\\"\\n                        style={{ width: `${netRatio}%` }}\\n                        title={`Net Revenue: ${formatIDR(row.netRevenue)}`}\\n                      />\\n                      <div\\n                        className=\\\"bg-amber-500 h-full\\\"\\n                        style={{ width: `${100 - netRatio}%` }}\\n                        title={`Potongan Komisi: ${formatIDR(row.commissionAmount)}`}\\n                      />\\n                    </div>\\n                  </div>\\n                </div>\\n              );\\n            })}\\n          </div>\\n\\n          <div className=\\\"flex items-center gap-6 mt-5 pt-4 border-t border-slate-100 text-xs text-slate-600\\\">\\n            <div className=\\\"flex items-center gap-2\\\">\\n              <span className=\\\"inline-block w-3 h-3 rounded-xs bg-slate-900\\\" />\\n              <span>Net Room Revenue (Pendapatan Bersih)</span>\\n            </div>\\n            <div className=\\\"flex items-center gap-2\\\">\\n              <span className=\\\"inline-block w-3 h-3 rounded-xs bg-amber-500\\\" />\\n              <span>Potongan Komisi OTA (14% \342\200\223 18%)</span>\\n            </div>\\n          </div>\\n        </div>\\n\\n        {/* Status Ketersediaan & Housekeeping 15 Kamar */}\\n        <div className=\\\"lg:col-span-5 bg-white border border-slate-200 rounded-xl p-6 flex flex-col justify-between\\\">\\n          <div>\\n            <div className=\\\"flex items-center justify-between pb-4 border-b border-slate-100\\\">\\n              <div>\\n                <h2 className=\\\"text-base font-bold text-slate-900\\\">\\n                  Status Real-Time 15 Kamar\\n                </h2>\\n                <p className=\\\"text-xs text-slate-500\\\">\\n                  Ringkasan ketersediaan & housekeeping hari ini\\n                </p>\\n              </div>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => onNavigate(\'calendar\')}\\n                className=\\\"text-xs font-semibold text-slate-700 hover:text-slate-900 underline whitespace-nowrap shrink-0\\\"\\n              >\\n                Buka Kalender Kamar\\n              </button>\\n            </div>\\n\\n            <div className=\\\"grid grid-cols-2 gap-3 mt-4\\\">\\n              <div className=\\\"p-3.5 bg-emerald-50/70 border border-emerald-200 rounded-lg\\\">\\n                <p className=\\\"text-xs font-medium text-emerald-900\\\">\\n                  Available (Siap Jual)\\n                </p>\\n                <p className=\\\"text-2xl font-bold font-mono tabular-nums text-emerald-800 mt-1\\\">\\n                  {availableCount} <span className=\\\"text-xs font-normal\\\">unit</span>\\n                </p>\\n              </div>\\n              <div className=\\\"p-3.5 bg-blue-50/70 border border-blue-200 rounded-lg\\\">\\n                <p className=\\\"text-xs font-medium text-blue-900\\\">\\n                  Occupied (Terisi Tamu)\\n                </p>\\n                <p className=\\\"text-2xl font-bold font-mono tabular-nums text-blue-800 mt-1\\\">\\n                  {occupiedCount} <span className=\\\"text-xs font-normal\\\">unit</span>\\n                </p>\\n              </div>\\n              <div className=\\\"p-3.5 bg-amber-50/70 border border-amber-200 rounded-lg\\\">\\n                <p className=\\\"text-xs font-medium text-amber-900\\\">\\n                  Dirty (Perlu Dibersihkan)\\n                </p>\\n                <p className=\\\"text-2xl font-bold font-mono tabular-nums text-amber-800 mt-1\\\">\\n                  {dirtyCount} <span className=\\\"text-xs font-normal\\\">unit</span>\\n                </p>\\n              </div>\\n              <div className=\\\"p-3.5 bg-rose-50/70 border border-rose-200 rounded-lg\\\">\\n                <p className=\\\"text-xs font-medium text-rose-900\\\">\\n                  Maintenance (Perbaikan)\\n                </p>\\n                <p className=\\\"text-2xl font-bold font-mono tabular-nums text-rose-800 mt-1\\\">\\n                  {maintenanceCount} <span className=\\\"text-xs font-normal\\\">unit</span>\\n                </p>\\n              </div>\\n            </div>\\n\\n            <div className=\\\"mt-5 pt-4 border-t border-slate-100 space-y-2.5 text-xs\\\">\\n              <p className=\\\"font-semibold text-slate-900\\\">\\n                Struktur Rate Plan & Unit Properti (Total 15 Kamar):\\n              </p>\\n              <div className=\\\"flex items-center justify-between text-slate-600\\\">\\n                <span>Standard Room (8 unit: Standard AC & Ekonomi Kipas)</span>\\n                <span className=\\\"font-mono tabular-nums text-slate-900\\\">\\n                  Rp 300rb / Rp 350rb\\n                </span>\\n              </div>\\n              <div className=\\\"flex items-center justify-between text-slate-600\\\">\\n                <span>Deluxe Room (5 unit: Include Breakfast)</span>\\n                <span className=\\\"font-mono tabular-nums text-slate-900\\\">\\n                  Rp 450rb / Rp 525rb\\n                </span>\\n              </div>\\n              <div className=\\\"flex items-center justify-between text-slate-600\\\">\\n                <span>Family Suite (2 unit: All Day Include Breakfast)</span>\\n                <span className=\\\"font-mono tabular-nums text-slate-900\\\">\\n                  Rp 750.000\\n                </span>\\n              </div>\\n            </div>\\n          </div>\\n\\n          <div className=\\\"mt-5 pt-4 border-t border-slate-100 flex items-center justify-between gap-2\\\">\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => onNavigate(\'reservations\')}\\n              className=\\\"w-full py-2.5 px-4 text-xs font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-lg transition-colors\\\"\\n            >\\n              + Input Reservasi Baru\\n            </button>\\n          </div>\\n        </div>\\n      </div>\\n\\n      {/* Recent Bookings Ledger */}\\n      <div className=\\\"bg-white border border-slate-200 rounded-xl p-6\\\">\\n        <div className=\\\"flex flex-wrap items-center justify-between gap-2 pb-4 border-b border-slate-100\\\">\\n          <div>\\n            <h2 className=\\\"text-base font-bold text-slate-900\\\">\\n              Daftar Reservasi Terbaru ({selectedMonth})\\n            </h2>\\n            <p className=\\\"text-xs text-slate-500\\\">\\n              Otomatis menghitung Gross Revenue, Potongan Komisi OTA, dan Net Room Revenue\\n            </p>\\n          </div>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => onNavigate(\'reservations\')}\\n            className=\\\"text-xs font-semibold text-slate-700 hover:text-slate-900 underline\\\"\\n          >\\n            Lihat Semua Reservasi ({reservations.filter((r) => r.monthKey === selectedMonth).length})\\n          </button>\\n        </div>\\n\\n        <div className=\\\"overflow-x-auto mt-4\\\">\\n          <table className=\\\"w-full text-left border-collapse\\\">\\n            <thead>\\n              <tr className=\\\"border-b border-slate-200 text-xs font-semibold text-slate-500\\\">\\n                <th className=\\\"py-2.5 pr-4\\\">Kode & Tamu</th>\\n                <th className=\\\"py-2.5 px-3\\\">Kamar</th>\\n                <th className=\\\"py-2.5 px-3\\\">Check-In / Out</th>\\n                <th className=\\\"py-2.5 px-3\\\">Channel OTA</th>\\n                <th className=\\\"py-2.5 px-3 text-right\\\">Gross Revenue</th>\\n                <th className=\\\"py-2.5 px-3 text-right\\\">Potongan Komisi</th>\\n                <th className=\\\"py-2.5 pl-3 text-right\\\">Net Room Revenue</th>\\n              </tr>\\n            </thead>\\n            <tbody className=\\\"divide-y divide-slate-100 text-xs\\\">\\n              {recentReservations.map((res) => (\\n                <tr key={res.id} className=\\\"hover:bg-slate-50\\\">\\n                  <td className=\\\"py-3 pr-4\\\">\\n                    <div className=\\\"font-semibold text-slate-900\\\">{res.guestName}</div>\\n                    <div className=\\\"text-slate-500 font-mono\\\">\\n                      {res.bookingCode} \302\267 {res.status}\\n                    </div>\\n                  </td>\\n                  <td className=\\\"py-3 px-3\\\">\\n                    <div className=\\\"font-medium text-slate-900\\\">\\n                      Kamar {res.roomNumber}\\n                    </div>\\n                    <div className=\\\"text-slate-500\\\">{res.roomType}</div>\\n                  </td>\\n                  <td className=\\\"py-3 px-3 font-mono tabular-nums text-slate-600\\\">\\n                    {res.checkIn} \342\206\222 {res.checkOut} ({res.nights} mlm)\\n                  </td>\\n                  <td className=\\\"py-3 px-3\\\">\\n                    <span className=\\\"font-medium text-slate-900\\\">{res.channel}</span>\\n                    <span className=\\\"text-slate-500 font-mono ml-1\\\">\\n                      ({res.commissionRate}%)\\n                    </span>\\n                  </td>\\n                  <td className=\\\"py-3 px-3 text-right font-mono tabular-nums text-slate-900\\\">\\n                    {formatIDR(res.grossRevenue)}\\n                  </td>\\n                  <td className=\\\"py-3 px-3 text-right font-mono tabular-nums text-amber-700\\\">\\n                    -{formatIDR(res.commissionAmount)}\\n                  </td>\\n                  <td className=\\\"py-3 pl-3 text-right font-mono tabular-nums font-semibold text-emerald-700\\\">\\n                    {formatIDR(res.netRevenue)}\\n                  </td>\\n                </tr>\\n              ))}\\n            </tbody>\\n          </table>\\n        </div>\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create ExecutiveDashboard.tsx displaying KPIs, OTA revenue chart, real-time room summary, and recent bookings\", \"Overwrite\":true, \"TargetFile\":\"/src/components/ExecutiveDashboard.tsx\", \"toolAction\":\"Creating ExecutiveDashboard.tsx\", \"toolSummary\":\"Create ExecutiveDashboard.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_1357257"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport {\\n  PhysicalRoomCategory,\\n  RatePlanType,\\n  ReservationRecord,\\n  RoomStatus,\\n  RoomUnit,\\n} from \'../types/hms\';\\nimport { formatIDR } from \'../utils/hotelCalculations\';\\nimport { HOTEL_PHOTOS } from \'../data/initialData\';\\nimport { Calendar, CheckCircle2, Image, Sparkles, Wrench } from \'lucide-react\';\\n\\ninterface RoomCalendarAndHousekeepingProps {\\n  rooms: RoomUnit[];\\n  reservations: ReservationRecord[];\\n  onUpdateRoomStatus: (roomId: string, newStatus: RoomStatus) => void;\\n  onQuickBookRoom: (roomId: string) => void;\\n}\\n\\nconst OCT_DATES = [\\n  \'2026-10-20\',\\n  \'2026-10-21\',\\n  \'2026-10-22\',\\n  \'2026-10-23\',\\n  \'2026-10-24\',\\n  \'2026-10-25\',\\n  \'2026-10-26\',\\n  \'2026-10-27\',\\n  \'2026-10-28\',\\n  \'2026-10-29\',\\n  \'2026-10-30\',\\n  \'2026-10-31\',\\n];\\n\\nexport const RoomCalendarAndHousekeeping: React.FC<\\n  RoomCalendarAndHousekeepingProps\\n> = ({ rooms, reservations, onUpdateRoomStatus, onQuickBookRoom }) => {\\n  const [filterType, setFilterType] = useState<\'ALL\' | RatePlanType>(\'ALL\');\\n  const [filterPhysical, setFilterPhysical] = useState<\\n    \'ALL\' | PhysicalRoomCategory\\n  >(\'ALL\');\\n  const [filterStatus, setFilterStatus] = useState<\'ALL\' | RoomStatus>(\'ALL\');\\n  const [showGalleryModal, setShowGalleryModal] = useState(false);\\n\\n  const filteredRooms = rooms.filter((r) => {\\n    if (filterType !== \'ALL\' && r.type !== filterType) return false;\\n    if (filterPhysical !== \'ALL\' && r.physicalCategory !== filterPhysical)\\n      return false;\\n    if (filterStatus !== \'ALL\' && r.status !== filterStatus) return false;\\n    return true;\\n  });\\n\\n  const getReservationForRoomOnDate = (roomId: string, dateStr: string) => {\\n    return reservations.find(\\n      (res) =>\\n        res.roomId === roomId &&\\n        res.status !== \'Cancelled\' &&\\n        res.checkIn <= dateStr &&\\n        res.checkOut > dateStr\\n    );\\n  };\\n\\n  return (\\n    <div className=\\\"space-y-6\\\">\\n      {/* Header & Filter Controls */}\\n      <div className=\\\"bg-white border border-slate-200 rounded-xl p-6\\\">\\n        <div className=\\\"flex flex-wrap items-start justify-between gap-4\\\">\\n          <div>\\n            <h1 className=\\\"text-xl font-bold text-slate-900\\\">\\n              Kalender Kamar & Status Housekeeping (15 Unit)\\n            </h1>\\n            <p className=\\\"text-xs text-slate-500 mt-1\\\">\\n              5 Deluxe Room (AC) \302\267 5 Standard AC \302\267 5 Room Ekonomi Kipas (Skema Rate Plan:\\n              8 Standard, 5 Deluxe, 2 Family Suite)\\n            </p>\\n          </div>\\n\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => setShowGalleryModal(!showGalleryModal)}\\n            className=\\\"inline-flex items-center gap-2 px-3.5 py-2 text-xs font-semibold text-slate-800 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors\\\"\\n          >\\n            <Image className=\\\"w-4 h-4\\\" />\\n            <span>\\n              {showGalleryModal\\n                ? \'Tutup Galeri Foto Asli Properti\'\\n                : \'Lihat 9 Foto Asli Hotel Putri Sari\'}\\n            </span>\\n          </button>\\n        </div>\\n\\n        {/* Authentic Property Photo Strip (Collapsible) */}\\n        {showGalleryModal && (\\n          <div className=\\\"mt-5 pt-5 border-t border-slate-200\\\">\\n            <h2 className=\\\"text-xs font-semibold text-slate-700 mb-3\\\">\\n              Dokumentasi Fisik Kamar & Eksterior Hotel Putri Sari (Jajapin)\\n            </h2>\\n            <div className=\\\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4\\\">\\n              {[\\n                {\\n                  src: HOTEL_PHOTOS.exterior,\\n                  title: \'Plang & Gerbang Hotel Putri Sari\',\\n                  desc: \'Akses jalan utama & area parkir luas\',\\n                },\\n                {\\n                  src: HOTEL_PHOTOS.deluxeMain,\\n                  title: \'Deluxe Room (5 Unit \342\200\224 201 s/d 205)\',\\n                  desc: \'King Bed Sprei Hijau, AC Split, TV LED, Lemari & Meja Rias\',\\n                },\\n                {\\n                  src: HOTEL_PHOTOS.deluxeWide,\\n                  title: \'Interior Deluxe Room (Sudut Lebar)\',\\n                  desc: \'Weekday Rp 450.000 \302\267 Weekend Rp 525.000 (Include Breakfast)\',\\n                },\\n                {\\n                  src: HOTEL_PHOTOS.standardAcBalcony,\\n                  title: \'Standard AC Room (5 Unit \342\200\224 101 s/d 105)\',\\n                  desc: \'Queen Bed Sprei Oranye, AC Split & Akses Balkon\',\\n                },\\n                {\\n                  src: HOTEL_PHOTOS.standardAcRoom,\\n                  title: \'Interior Standard AC Room\',\\n                  desc: \'Weekday Rp 300.000 \302\267 Weekend Rp 350.000 (Room Only)\',\\n                },\\n                {\\n                  src: HOTEL_PHOTOS.ekonomiFan1,\\n                  title: \'Room Ekonomi Kipas (5 Unit \342\200\224 106-108, 301-302)\',\\n                  desc: \'Sprei Putih, Kipas Angin Dinding & Kursi Duduk Santai\',\\n                },\\n                {\\n                  src: HOTEL_PHOTOS.ekonomiFan2,\\n                  title: \'Kamar Ekonomi Kipas / Family Suite\',\\n                  desc: \'Tersedia opsi Standard & Family Suite\',\\n                },\\n                {\\n                  src: HOTEL_PHOTOS.deluxeBed,\\n                  title: \'Detail Tempat Tidur Deluxe Room\',\\n                  desc: \'Sandaran kulit sintetis hitam & bantal ganda\',\\n                },\\n                {\\n                  src: HOTEL_PHOTOS.bathroom,\\n                  title: \'Kamar Mandi Dalam (Shower & Closet Duduk)\',\\n                  desc: \'Keramik bersih & fasilitas shower air bersih\',\\n                },\\n              ].map((item) => (\\n                <div\\n                  key={item.title}\\n                  className=\\\"border border-slate-200 rounded-lg overflow-hidden bg-slate-50\\\"\\n                >\\n                  <img\\n                    src={item.src}\\n                    alt={item.title}\\n                    referrerPolicy=\\\"no-referrer\\\"\\n                    className=\\\"w-full h-44 object-cover\\\"\\n                  />\\n                  <div className=\\\"p-3\\\">\\n                    <p className=\\\"text-xs font-semibold text-slate-900\\\">\\n                      {item.title}\\n                    </p>\\n                    <p className=\\\"text-xs text-slate-500 mt-0.5\\\">{item.desc}</p>\\n                  </div>\\n                </div>\\n              ))}\\n            </div>\\n          </div>\\n        )}\\n\\n        {/* Filter Bar */}\\n        <div className=\\\"mt-5 pt-4 border-t border-slate-100 flex flex-wrap items-center justify-between gap-4\\\">\\n          <div className=\\\"flex flex-wrap items-center gap-2\\\">\\n            <span className=\\\"text-xs font-medium text-slate-500\\\">\\n              Filter Fisik Kamar:\\n            </span>\\n            {(\\n              [\\n                { id: \'ALL\', label: \'Semua (15)\' },\\n                { id: \'Deluxe Room\', label: \'Deluxe Room (5)\' },\\n                { id: \'Standard AC\', label: \'Standard AC (5)\' },\\n                { id: \'Room Ekonomi Kipas\', label: \'Ekonomi Kipas (5)\' },\\n              ] as const\\n            ).map((btn) => (\\n              <button\\n                key={btn.id}\\n                type=\\\"button\\\"\\n                onClick={() => setFilterPhysical(btn.id)}\\n                className={`px-3 py-1.5 text-xs font-medium rounded-md transition-colors whitespace-nowrap shrink-0 ${\\n                  filterPhysical === btn.id\\n                    ? \'bg-slate-900 text-white\'\\n                    : \'bg-slate-100 text-slate-700 hover:bg-slate-200\'\\n                }`}\\n              >\\n                {btn.label}\\n              </button>\\n            ))}\\n          </div>\\n\\n          <div className=\\\"flex flex-wrap items-center gap-2\\\">\\n            <span className=\\\"text-xs font-medium text-slate-500\\\">\\n              Rate Plan:\\n            </span>\\n            {(\\n              [\\n                { id: \'ALL\', label: \'Semua Rate\' },\\n                { id: \'Standard Room\', label: \'Standard (8)\' },\\n                { id: \'Deluxe Room\', label: \'Deluxe (5)\' },\\n                { id: \'Family Suite\', label: \'Family Suite (2)\' },\\n              ] as const\\n            ).map((btn) => (\\n              <button\\n                key={btn.id}\\n                type=\\\"button\\\"\\n                onClick={() => setFilterType(btn.id)}\\n                className={`px-3 py-1.5 text-xs font-medium rounded-md transition-colors whitespace-nowrap shrink-0 ${\\n                  filterType === btn.id\\n                    ? \'bg-slate-900 text-white\'\\n                    : \'bg-slate-100 text-slate-700 hover:bg-slate-200\'\\n                }`}\\n              >\\n                {btn.label}\\n              </button>\\n            ))}\\n          </div>\\n\\n          <div className=\\\"flex flex-wrap items-center gap-2\\\">\\n            <span className=\\\"text-xs font-medium text-slate-500\\\">Status:</span>\\n            {([\'ALL\', \'Available\', \'Occupied\', \'Dirty\', \'Maintenance\'] as const).map(\\n              (st) => (\\n                <button\\n                  key={st}\\n                  type=\\\"button\\\"\\n                  onClick={() => setFilterStatus(st)}\\n                  className={`px-2.5 py-1.5 text-xs font-medium rounded-md transition-colors whitespace-nowrap shrink-0 ${\\n                    filterStatus === st\\n                      ? \'bg-slate-900 text-white\'\\n                      : \'bg-slate-100 text-slate-700 hover:bg-slate-200\'\\n                  }`}\\n                >\\n                  {st === \'ALL\' ? \'Semua Status\' : st}\\n                </button>\\n              )\\n            )}\\n          </div>\\n        </div>\\n      </div>\\n\\n      {/* Interactive Tape Chart / Kalender Ketersediaan Kamar (20 - 31 Oktober 2026) */}\\n      <div className=\\\"bg-white border border-slate-200 rounded-xl p-6\\\">\\n        <div className=\\\"flex flex-wrap items-center justify-between gap-2 mb-4\\\">\\n          <div>\\n            <h2 className=\\\"text-base font-bold text-slate-900\\\">\\n              Tabel Kalender Okupansi Kamar (20 \342\200\223 31 Oktober 2026)\\n            </h2>\\n            <p className=\\\"text-xs text-slate-500\\\">\\n              Pantau jadwal hunian per nomor kamar dan sumber OTA secara visual\\n            </p>\\n          </div>\\n          <div className=\\\"flex items-center gap-4 text-xs text-slate-600\\\">\\n            <span>Jum & Sab = Tarif Weekend</span>\\n            <span aria-hidden=\\\"true\\\">\302\267</span>\\n            <span>Min\342\200\223Kam = Tarif Weekday</span>\\n          </div>\\n        </div>\\n\\n        <div className=\\\"overflow-x-auto\\\">\\n          <table className=\\\"w-full border-collapse text-xs\\\">\\n            <thead>\\n              <tr className=\\\"border-b border-slate-200 bg-slate-50\\\">\\n                <th className=\\\"py-2.5 px-3 text-left font-semibold text-slate-700 min-w-[180px]\\\">\\n                  Unit Kamar & Tipe\\n                </th>\\n                <th className=\\\"py-2.5 px-2 text-left font-semibold text-slate-700\\\">\\n                  Status HK\\n                </th>\\n                {OCT_DATES.map((d) => {\\n                  const dayNum = d.slice(8, 10);\\n                  const dayOfWeek = new Date(`${d}T00:00:00Z`).getUTCDay();\\n                  const isWeekend = dayOfWeek === 5 || dayOfWeek === 6;\\n                  return (\\n                    <th\\n                      key={d}\\n                      className={`py-2 px-1.5 text-center font-mono ${\\n                        isWeekend\\n                          ? \'bg-amber-50 text-amber-900 font-bold\'\\n                          : \'text-slate-600\'\\n                      }`}\\n                    >\\n                      <div>Okt</div>\\n                      <div>{dayNum}</div>\\n                    </th>\\n                  );\\n                })}\\n              </tr>\\n            </thead>\\n            <tbody className=\\\"divide-y divide-slate-100\\\">\\n              {filteredRooms.map((room) => (\\n                <tr key={room.id} className=\\\"hover:bg-slate-50/80\\\">\\n                  <td className=\\\"py-2.5 px-3\\\">\\n                    <div className=\\\"font-semibold text-slate-900\\\">\\n                      Kamar {room.roomNumber} \302\267 {room.physicalCategory}\\n                    </div>\\n                    <div className=\\\"text-slate-500\\\">\\n                      {room.type} \302\267 {formatIDR(room.weekdayRate)}\\n                    </div>\\n                  </td>\\n                  <td className=\\\"py-2.5 px-2 font-medium text-slate-700\\\">\\n                    {room.status}\\n                  </td>\\n                  {OCT_DATES.map((d) => {\\n                    const activeRes = getReservationForRoomOnDate(room.id, d);\\n                    return (\\n                      <td\\n                        key={d}\\n                        className=\\\"p-1 text-center border-l border-slate-100\\\"\\n                      >\\n                        {activeRes ? (\\n                          <div\\n                            title={`${activeRes.guestName} (${activeRes.channel})`}\\n                            className=\\\"px-1 py-1.5 rounded bg-slate-900 text-white text-[10px] font-medium truncate max-w-[68px] mx-auto\\\"\\n                          >\\n                            {activeRes.guestName.split(\' \')[0]}\\n                          </div>\\n                        ) : (\\n                          <button\\n                            type=\\\"button\\\"\\n                            onClick={() => onQuickBookRoom(room.id)}\\n                            title={`Input reservasi Kamar ${room.roomNumber} tanggal ${d}`}\\n                            className=\\\"w-full py-1.5 rounded text-[10px] text-slate-400 hover:bg-emerald-50 hover:text-emerald-700 transition-colors\\\"\\n                          >\\n                            Kosong\\n                          </button>\\n                        )}\\n                      </td>\\n                    );\\n                  })}\\n                </tr>\\n              ))}\\n            </tbody>\\n          </table>\\n        </div>\\n      </div>\\n\\n      {/* 15 Room Cards with Quick Housekeeping Controls */}\\n      <div className=\\\"grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4\\\">\\n        {filteredRooms.map((room) => (\\n          <div\\n            key={room.id}\\n            data-testid={`room-card-${room.roomNumber}`}\\n            className=\\\"bg-white border border-slate-200 rounded-xl overflow-hidden flex flex-col justify-between\\\"\\n          >\\n            <div>\\n              <div className=\\\"relative h-40 bg-slate-900\\\">\\n                <img\\n                  src={room.photoUrl}\\n                  alt={room.name}\\n                  referrerPolicy=\\\"no-referrer\\\"\\n                  className=\\\"w-full h-full object-cover\\\"\\n                />\\n                <div className=\\\"absolute inset-0 bg-gradient-to-t from-black/75 via-black/20 to-transparent flex flex-col justify-end p-3.5 text-white\\\">\\n                  <div className=\\\"flex items-center justify-between\\\">\\n                    <span className=\\\"text-xs font-mono text-slate-200\\\">\\n                      UNIT {room.roomNumber} \302\267 LANTAI {room.floor}\\n                    </span>\\n                    <span className=\\\"text-xs font-semibold\\\">\\n                      Status: {room.status}\\n                    </span>\\n                  </div>\\n                  <h3 className=\\\"text-base font-bold\\\">{room.name}</h3>\\n                </div>\\n              </div>\\n\\n              <div className=\\\"p-4 space-y-2.5 text-xs\\\">\\n                <div className=\\\"flex items-center justify-between text-slate-600\\\">\\n                  <span>Kategori Fisik & Fasilitas</span>\\n                  <span className=\\\"font-medium text-slate-900\\\">\\n                    {room.physicalCategory} \302\267 {room.cooling}\\n                  </span>\\n                </div>\\n                <div className=\\\"flex items-center justify-between text-slate-600\\\">\\n                  <span>Skema Rate Plan</span>\\n                  <span className=\\\"font-medium text-slate-900\\\">\\n                    {room.type} ({room.includesBreakfast ? \'Include Breakfast\' : \'Room Only\'})\\n                  </span>\\n                </div>\\n                <div className=\\\"flex items-center justify-between text-slate-600\\\">\\n                  <span>Harga Weekday / Weekend</span>\\n                  <span className=\\\"font-mono tabular-nums font-semibold text-slate-900\\\">\\n                    {formatIDR(room.weekdayRate)} / {formatIDR(room.weekendRate)}\\n                  </span>\\n                </div>\\n                <div className=\\\"flex items-center justify-between text-slate-600\\\">\\n                  <span>Tamu Saat Ini</span>\\n                  <span className=\\\"font-medium text-slate-900\\\">\\n                    {room.currentGuest || \'Tidak ada tamu\'}\\n                  </span>\\n                </div>\\n              </div>\\n            </div>\\n\\n            <div className=\\\"p-4 pt-3 border-t border-slate-100 bg-slate-50/60 space-y-2.5\\\">\\n              <div className=\\\"text-[11px] font-semibold text-slate-500\\\">\\n                Ubah Status Housekeeping Kamar {room.roomNumber}:\\n              </div>\\n              <div className=\\\"grid grid-cols-4 gap-1.5\\\">\\n                {(\\n                  [\'Available\', \'Occupied\', \'Dirty\', \'Maintenance\'] as RoomStatus[]\\n                ).map((st) => (\\n                  <button\\n                    key={st}\\n                    type=\\\"button\\\"\\n                    aria-label={`Set Kamar ${room.roomNumber} status ${st}`}\\n                    onClick={() => onUpdateRoomStatus(room.id, st)}\\n                    className={`py-1.5 px-2 text-[11px] font-semibold rounded transition-colors whitespace-nowrap truncate ${\\n                      room.status === st\\n                        ? \'bg-slate-900 text-white\'\\n                        : \'bg-white border border-slate-200 text-slate-700 hover:bg-slate-100\'\\n                    }`}\\n                  >\\n                    {st}\\n                  </button>\\n                ))}\\n              </div>\\n            </div>\\n          </div>\\n        ))}\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create RoomCalendarAndHousekeeping.tsx with 15-room grid, tape chart calendar, and authentic Hotel Putri Sari photo gallery\", \"Overwrite\":true, \"TargetFile\":\"/src/components/RoomCalendarAndHousekeeping.tsx\", \"toolAction\":\"Creating RoomCalendarAndHousekeeping.tsx\", \"toolSummary\":\"Create RoomCalendarAndHousekeeping.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_1357781"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport {\\n  BookingChannel,\\n  PropertySettingsConfig,\\n  ReservationRecord,\\n  ReservationStatus,\\n  RoomUnit,\\n} from \'../types/hms\';\\nimport {\\n  ALL_BOOKING_CHANNELS,\\n  calculateOtaFinancials,\\n  calculateStayBreakdown,\\n  formatIDR,\\n  getChannelCommissionRate,\\n} from \'../utils/hotelCalculations\';\\nimport { Check, Plus, RefreshCw, Search } from \'lucide-react\';\\n\\ninterface ReservationsAndOtaManagerProps {\\n  rooms: RoomUnit[];\\n  reservations: ReservationRecord[];\\n  settings: PropertySettingsConfig;\\n  selectedRoomIdForQuickBook?: string | null;\\n  onAddReservation: (\\n    newRes: Omit<ReservationRecord, \'id\' | \'ownerId\'>\\n  ) => void;\\n  onUpdateReservationStatus: (\\n    reservationId: string,\\n    newStatus: ReservationStatus\\n  ) => void;\\n  onSyncOta: () => void;\\n  isSyncingOta: boolean;\\n  lastOtaSync: string;\\n}\\n\\nexport const ReservationsAndOtaManager: React.FC<\\n  ReservationsAndOtaManagerProps\\n> = ({\\n  rooms,\\n  reservations,\\n  settings,\\n  selectedRoomIdForQuickBook,\\n  onAddReservation,\\n  onUpdateReservationStatus,\\n  onSyncOta,\\n  isSyncingOta,\\n  lastOtaSync,\\n}) => {\\n  const [guestName, setGuestName] = useState(\'\');\\n  const [guestPhone, setGuestPhone] = useState(\'\');\\n  const [roomId, setRoomId] = useState(\\n    selectedRoomIdForQuickBook || rooms[0]?.id || \'room-101\'\\n  );\\n  const [channel, setChannel] = useState<BookingChannel>(\'Traveloka\');\\n  const [checkIn, setCheckIn] = useState(\'2026-10-25\');\\n  const [checkOut, setCheckOut] = useState(\'2026-10-27\');\\n  const [notes, setNotes] = useState(\'\');\\n  const [formError, setFormError] = useState(\'\');\\n  const [formSuccess, setFormSuccess] = useState(\'\');\\n\\n  const [filterChannel, setFilterChannel] = useState<\'ALL\' | BookingChannel>(\'ALL\');\\n  const [searchQuery, setSearchQuery] = useState(\'\');\\n\\n  const selectedRoom = rooms.find((r) => r.id === roomId) || rooms[0];\\n  const stayCalc = calculateStayBreakdown(\\n    checkIn,\\n    checkOut,\\n    selectedRoom?.weekdayRate || 300000,\\n    selectedRoom?.weekendRate || 350000\\n  );\\n  const commRate = getChannelCommissionRate(channel, settings);\\n  const otaFinancials = calculateOtaFinancials(stayCalc.grossRevenue, commRate);\\n\\n  const handleSubmit = (e: React.FormEvent) => {\\n    e.preventDefault();\\n    setFormError(\'\');\\n    setFormSuccess(\'\');\\n\\n    if (!guestName.trim()) {\\n      setFormError(\'Nama lengkap tamu wajib diisi.\');\\n      return;\\n    }\\n    if (stayCalc.nights <= 0) {\\n      setFormError(\'Tanggal Check-Out harus lebih besar dari tanggal Check-In.\');\\n      return;\\n    }\\n    if (!selectedRoom) {\\n      setFormError(\'Pilih unit kamar terlebih dahulu.\');\\n      return;\\n    }\\n\\n    const prefixMap: Record<BookingChannel, string> = {\\n      \'Direct Booking\': \'DIR\',\\n      Airbnb: \'ABB\',\\n      Traveloka: \'TVL\',\\n      \'Tiket.com\': \'TKT\',\\n      Agoda: \'AGD\',\\n      \'Booking.com\': \'BKG\',\\n    };\\n\\n    const randomDigits = Math.floor(1000 + Math.random() * 9000);\\n    const bookingCode = `${prefixMap[channel]}-${randomDigits}`;\\n    const monthKey = checkIn.slice(0, 7);\\n\\n    onAddReservation({\\n      bookingCode,\\n      guestName: guestName.trim(),\\n      guestPhone: guestPhone.trim() || \'-\',\\n      roomId: selectedRoom.id,\\n      roomNumber: selectedRoom.roomNumber,\\n      roomType: selectedRoom.type,\\n      physicalCategory: selectedRoom.physicalCategory,\\n      checkIn,\\n      checkOut,\\n      nights: stayCalc.nights,\\n      weekdayNights: stayCalc.weekdayNights,\\n      weekendNights: stayCalc.weekendNights,\\n      channel,\\n      grossRevenue: otaFinancials.grossRevenue,\\n      commissionRate: otaFinancials.commissionRate,\\n      commissionAmount: otaFinancials.commissionAmount,\\n      netRevenue: otaFinancials.netRevenue,\\n      status: \'Confirmed\',\\n      monthKey,\\n      notes: notes.trim(),\\n    });\\n\\n    setGuestName(\'\');\\n    setGuestPhone(\'\');\\n    setNotes(\'\');\\n    setFormSuccess(\\n      `Reservasi ${bookingCode} (${guestName.trim()}) berhasil disimpan. Net Room Revenue: ${formatIDR(otaFinancials.netRevenue)}.`\\n    );\\n  };\\n\\n  const filteredReservations = reservations.filter((r) => {\\n    if (filterChannel !== \'ALL\' && r.channel !== filterChannel) return false;\\n    if (\\n      searchQuery.trim() &&\\n      !r.guestName.toLowerCase().includes(searchQuery.toLowerCase()) &&\\n      !r.bookingCode.toLowerCase().includes(searchQuery.toLowerCase()) &&\\n      !r.roomNumber.includes(searchQuery)\\n    ) {\\n      return false;\\n    }\\n    return true;\\n  });\\n\\n  return (\\n    <div className=\\\"space-y-6\\\">\\n      {/* 6 OTA Channel Manager Status Header */}\\n      <div className=\\\"bg-white border border-slate-200 rounded-xl p-6\\\">\\n        <div className=\\\"flex flex-wrap items-center justify-between gap-4 pb-5 border-b border-slate-100\\\">\\n          <div>\\n            <h1 className=\\\"text-xl font-bold text-slate-900\\\">\\n              Channel Manager 6 OTA & Input Reservasi\\n            </h1>\\n            <p className=\\\"text-xs text-slate-500 mt-1\\\">\\n              Ketersediaan 15 kamar terhubung dengan 6 sumber booking \302\267 Terakhir\\n              disinkronkan: <span className=\\\"font-mono\\\">{lastOtaSync}</span>\\n            </p>\\n          </div>\\n\\n          <button\\n            type=\\\"button\\\"\\n            onClick={onSyncOta}\\n            disabled={isSyncingOta}\\n            className=\\\"inline-flex items-center gap-2 px-4 py-2.5 text-xs font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-lg transition-colors whitespace-nowrap shrink-0 disabled:opacity-60\\\"\\n          >\\n            <RefreshCw\\n              className={`w-4 h-4 ${isSyncingOta ? \'animate-spin\' : \'\'}`}\\n            />\\n            <span>\\n              {isSyncingOta\\n                ? \'Menyinkronkan Stok Kamar ke 6 OTA...\'\\n                : \'Sync OTA Availability\'}\\n            </span>\\n          </button>\\n        </div>\\n\\n        {/* 6 Connected OTA Channel Cards */}\\n        <div className=\\\"grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 mt-5\\\">\\n          {ALL_BOOKING_CHANNELS.map((ch) => {\\n            const rate = getChannelCommissionRate(ch, settings);\\n            return (\\n              <div\\n                key={ch}\\n                className=\\\"p-3.5 border border-slate-200 rounded-lg bg-slate-50/60 flex flex-col justify-between\\\"\\n              >\\n                <div className=\\\"flex items-center justify-between text-xs\\\">\\n                  <span className=\\\"font-bold text-slate-900\\\">{ch}</span>\\n                </div>\\n                <div className=\\\"mt-2 flex items-center justify-between text-xs\\\">\\n                  <span className=\\\"text-slate-500\\\">Komisi:</span>\\n                  <span className=\\\"font-mono tabular-nums font-semibold text-slate-900\\\">\\n                    {rate}%\\n                  </span>\\n                </div>\\n                <div className=\\\"mt-1.5 text-[11px] text-emerald-700 font-medium flex items-center gap-1\\\">\\n                  <Check className=\\\"w-3 h-3\\\" />\\n                  <span>Terkoneksi (2-Way XML)</span>\\n                </div>\\n              </div>\\n            );\\n          })}\\n        </div>\\n      </div>\\n\\n      {/* Input Reservasi Baru & Kalkulator Komisi Otomatis */}\\n      <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6\\\">\\n        <form\\n          onSubmit={handleSubmit}\\n          className=\\\"lg:col-span-7 bg-white border border-slate-200 rounded-xl p-6 space-y-4\\\"\\n        >\\n          <div>\\n            <h2 className=\\\"text-base font-bold text-slate-900\\\">\\n              Form Input Reservasi Baru (Walk-in / OTA Masuk)\\n            </h2>\\n            <p className=\\\"text-xs text-slate-500\\\">\\n              Sistem otomatis menghitung tarif Weekday/Weekend, potongan komisi OTA,\\n              dan Net Room Revenue\\n            </p>\\n          </div>\\n\\n          {formError && (\\n            <div\\n              role=\\\"alert\\\"\\n              className=\\\"p-3 text-xs font-medium text-rose-800 bg-rose-50 border border-rose-200 rounded-lg\\\"\\n            >\\n              {formError}\\n            </div>\\n          )}\\n\\n          {formSuccess && (\\n            <div\\n              role=\\\"status\\\"\\n              className=\\\"p-3 text-xs font-medium text-emerald-800 bg-emerald-50 border border-emerald-200 rounded-lg\\\"\\n            >\\n              {formSuccess}\\n            </div>\\n          )}\\n\\n          <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-4\\\">\\n            <div>\\n              <label\\n                htmlFor=\\\"res-guest-name\\\"\\n                className=\\\"block text-xs font-semibold text-slate-700 mb-1\\\"\\n              >\\n                Nama Lengkap Tamu *\\n              </label>\\n              <input\\n                id=\\\"res-guest-name\\\"\\n                type=\\\"text\\\"\\n                value={guestName}\\n                onChange={(e) => setGuestName(e.target.value)}\\n                placeholder=\\\"Contoh: Budi Santoso\\\"\\n                className=\\\"w-full px-3 py-2 text-xs bg-white border border-slate-300 rounded-lg text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900\\\"\\n              />\\n            </div>\\n\\n            <div>\\n              <label\\n                htmlFor=\\\"res-guest-phone\\\"\\n                className=\\\"block text-xs font-semibold text-slate-700 mb-1\\\"\\n              >\\n                Nomor WhatsApp / Telepon\\n              </label>\\n              <input\\n                id=\\\"res-guest-phone\\\"\\n                type=\\\"text\\\"\\n                value={guestPhone}\\n                onChange={(e) => setGuestPhone(e.target.value)}\\n                placeholder=\\\"0812-xxxx-xxxx\\\"\\n                className=\\\"w-full px-3 py-2 text-xs bg-white border border-slate-300 rounded-lg text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900\\\"\\n              />\\n            </div>\\n\\n            <div>\\n              <label\\n                htmlFor=\\\"res-room-select\\\"\\n                className=\\\"block text-xs font-semibold text-slate-700 mb-1\\\"\\n              >\\n                Pilih Unit Kamar (15 Kamar) *\\n              </label>\\n              <select\\n                id=\\\"res-room-select\\\"\\n                value={roomId}\\n                onChange={(e) => setRoomId(e.target.value)}\\n                className=\\\"w-full px-3 py-2 text-xs bg-white border border-slate-300 rounded-lg text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900\\\"\\n              >\\n                {rooms.map((r) => (\\n                  <option key={r.id} value={r.id}>\\n                    Kamar {r.roomNumber} \342\200\224 {r.physicalCategory} ({r.type}:{\' \'}\\n                    {formatIDR(r.weekdayRate)}) [{r.status}]\\n                  </option>\\n                ))}\\n              </select>\\n            </div>\\n\\n            <div>\\n              <label\\n                htmlFor=\\\"res-channel-select\\\"\\n                className=\\\"block text-xs font-semibold text-slate-700 mb-1\\\"\\n              >\\n                Sumber Booking / Channel OTA *\\n              </label>\\n              <select\\n                id=\\\"res-channel-select\\\"\\n                value={channel}\\n                onChange={(e) => setChannel(e.target.value as BookingChannel)}\\n                className=\\\"w-full px-3 py-2 text-xs bg-white border border-slate-300 rounded-lg text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900\\\"\\n              >\\n                {ALL_BOOKING_CHANNELS.map((ch) => (\\n                  <option key={ch} value={ch}>\\n                    {ch} (Komisi {getChannelCommissionRate(ch, settings)}%)\\n                  </option>\\n                ))}\\n              </select>\\n            </div>\\n\\n            <div>\\n              <label\\n                htmlFor=\\\"res-checkin\\\"\\n                className=\\\"block text-xs font-semibold text-slate-700 mb-1\\\"\\n              >\\n                Tanggal Check-In *\\n              </label>\\n              <input\\n                id=\\\"res-checkin\\\"\\n                type=\\\"date\\\"\\n                value={checkIn}\\n                onChange={(e) => setCheckIn(e.target.value)}\\n                className=\\\"w-full px-3 py-2 text-xs font-mono bg-white border border-slate-300 rounded-lg text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900\\\"\\n              />\\n            </div>\\n\\n            <div>\\n              <label\\n                htmlFor=\\\"res-checkout\\\"\\n                className=\\\"block text-xs font-semibold text-slate-700 mb-1\\\"\\n              >\\n                Tanggal Check-Out *\\n              </label>\\n              <input\\n                id=\\\"res-checkout\\\"\\n                type=\\\"date\\\"\\n                value={checkOut}\\n                onChange={(e) => setCheckOut(e.target.value)}\\n                className=\\\"w-full px-3 py-2 text-xs font-mono bg-white border border-slate-300 rounded-lg text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900\\\"\\n              />\\n            </div>\\n          </div>\\n\\n          <div>\\n            <label\\n              htmlFor=\\\"res-notes\\\"\\n              className=\\\"block text-xs font-semibold text-slate-700 mb-1\\\"\\n            >\\n              Catatan Tambahan (Permintaan Khusus / Sarapan)\\n            </label>\\n            <input\\n              id=\\\"res-notes\\\"\\n              type=\\\"text\\\"\\n              value={notes}\\n              onChange={(e) => setNotes(e.target.value)}\\n              placeholder=\\\"Contoh: Check-in malam pukul 20:00 WIB\\\"\\n              className=\\\"w-full px-3 py-2 text-xs bg-white border border-slate-300 rounded-lg text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900\\\"\\n            />\\n          </div>\\n\\n          <button\\n            type=\\\"submit\\\"\\n            className=\\\"w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-2.5 text-xs font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-lg transition-colors\\\"\\n          >\\n            <Plus className=\\\"w-4 h-4\\\" />\\n            <span>Simpan Reservasi & Hitung Komisi Otomatis</span>\\n          </button>\\n        </form>\\n\\n        {/* Live Automatic Commission & Net Revenue Preview Panel */}\\n        <div className=\\\"lg:col-span-5 bg-slate-900 text-white rounded-xl p-6 flex flex-col justify-between\\\">\\n          <div className=\\\"space-y-4\\\">\\n            <div>\\n              <p className=\\\"text-xs font-mono text-slate-400\\\">\\n                KALKULATOR PENDAPATAN KAMAR & KOMISI OTA\\n              </p>\\n              <h3 className=\\\"text-lg font-bold mt-1\\\">\\n                Kamar {selectedRoom?.roomNumber} \342\200\224 {selectedRoom?.name}\\n              </h3>\\n              <p className=\\\"text-xs text-slate-300 mt-0.5\\\">\\n                Rate Plan: {selectedRoom?.type} (\\n                {selectedRoom?.includesBreakfast\\n                  ? \'Include Breakfast\'\\n                  : \'Room Only\'}\\n                )\\n              </p>\\n            </div>\\n\\n            <div className=\\\"space-y-2.5 pt-3 border-t border-slate-800 text-xs\\\">\\n              <div className=\\\"flex items-center justify-between\\\">\\n                <span className=\\\"text-slate-300\\\">Durasi Menginap:</span>\\n                <span className=\\\"font-mono tabular-nums font-semibold\\\">\\n                  {stayCalc.nights} Malam ({stayCalc.weekdayNights} Weekday,{\' \'}\\n                  {stayCalc.weekendNights} Weekend)\\n                </span>\\n              </div>\\n              <div className=\\\"flex items-center justify-between\\\">\\n                <span className=\\\"text-slate-300\\\">Harga Kamar Weekday:</span>\\n                <span className=\\\"font-mono tabular-nums\\\">\\n                  {formatIDR(selectedRoom?.weekdayRate || 0)} / malam\\n                </span>\\n              </div>\\n              <div className=\\\"flex items-center justify-between\\\">\\n                <span className=\\\"text-slate-300\\\">Harga Kamar Weekend:</span>\\n                <span className=\\\"font-mono tabular-nums\\\">\\n                  {formatIDR(selectedRoom?.weekendRate || 0)} / malam\\n                </span>\\n              </div>\\n              <div className=\\\"flex items-center justify-between pt-2 border-t border-slate-800\\\">\\n                <span className=\\\"text-slate-200 font-semibold\\\">\\n                  Gross Revenue (Harga \303\227 Malam):\\n                </span>\\n                <span\\n                  data-testid=\\\"calc-preview-gross\\\"\\n                  className=\\\"font-mono tabular-nums text-base font-bold text-white\\\"\\n                >\\n                  {formatIDR(otaFinancials.grossRevenue)}\\n                </span>\\n              </div>\\n              <div className=\\\"flex items-center justify-between\\\">\\n                <span className=\\\"text-amber-300\\\">\\n                  Potongan Komisi {channel} ({otaFinancials.commissionRate}%):\\n                </span>\\n                <span\\n                  data-testid=\\\"calc-preview-commission\\\"\\n                  className=\\\"font-mono tabular-nums font-semibold text-amber-300\\\"\\n                >\\n                  -{formatIDR(otaFinancials.commissionAmount)}\\n                </span>\\n              </div>\\n            </div>\\n          </div>\\n\\n          <div className=\\\"pt-4 mt-4 border-t border-slate-800\\\">\\n            <div className=\\\"flex items-baseline justify-between\\\">\\n              <span className=\\\"text-xs font-semibold text-slate-300\\\">\\n                NET ROOM REVENUE (Pendapatan Bersih):\\n              </span>\\n              <span\\n                data-testid=\\\"calc-preview-net\\\"\\n                className=\\\"text-2xl font-bold font-mono tabular-nums text-emerald-400\\\"\\n              >\\n                {formatIDR(otaFinancials.netRevenue)}\\n              </span>\\n            </div>\\n            <p className=\\\"text-[11px] text-slate-400 mt-1\\\">\\n              Otomatis masuk ke Bagian A & Bagian C Laporan Keuangan Bulanan (P&L)\\n            </p>\\n          </div>\\n        </div>\\n      </div>\\n\\n      {/* Reservations List & Check-in / Check-out Management */}\\n      <div className=\\\"bg-white border border-slate-200 rounded-xl p-6\\\">\\n        <div className=\\\"flex flex-wrap items-center justify-between gap-4 pb-4 border-b border-slate-100\\\">\\n          <div>\\n            <h2 className=\\\"text-base font-bold text-slate-900\\\">\\n              Daftar Seluruh Reservasi & Tindakan Check-In / Check-Out\\n            </h2>\\n            <p className=\\\"text-xs text-slate-500\\\">\\n              Klik Check-In saat tamu tiba atau Check-Out saat tamu meninggalkan kamar\\n            </p>\\n          </div>\\n\\n          <div className=\\\"flex flex-wrap items-center gap-3\\\">\\n            <div className=\\\"relative\\\">\\n              <Search className=\\\"w-3.5 h-3.5 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2\\\" />\\n              <input\\n                type=\\\"text\\\"\\n                aria-label=\\\"Cari nama tamu atau kode booking\\\"\\n                value={searchQuery}\\n                onChange={(e) => setSearchQuery(e.target.value)}\\n                placeholder=\\\"Cari tamu / kode / kamar...\\\"\\n                className=\\\"pl-8 pr-3 py-1.5 text-xs bg-slate-50 border border-slate-300 rounded-lg text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900\\\"\\n              />\\n            </div>\\n\\n            <select\\n              aria-label=\\\"Filter sumber channel OTA\\\"\\n              value={filterChannel}\\n              onChange={(e) =>\\n                setFilterChannel(e.target.value as \'ALL\' | BookingChannel)\\n              }\\n              className=\\\"px-3 py-1.5 text-xs bg-slate-50 border border-slate-300 rounded-lg text-slate-900\\\"\\n            >\\n              <option value=\\\"ALL\\\">Semua Channel (6 OTA)</option>\\n              {ALL_BOOKING_CHANNELS.map((ch) => (\\n                <option key={ch} value={ch}>\\n                  {ch}\\n                </option>\\n              ))}\\n            </select>\\n          </div>\\n        </div>\\n\\n        <div className=\\\"overflow-x-auto mt-4\\\">\\n          <table className=\\\"w-full text-left border-collapse\\\">\\n            <thead>\\n              <tr className=\\\"border-b border-slate-200 text-xs font-semibold text-slate-500\\\">\\n                <th className=\\\"py-2.5 pr-3\\\">Kode & Tamu</th>\\n                <th className=\\\"py-2.5 px-3\\\">Unit Kamar</th>\\n                <th className=\\\"py-2.5 px-3\\\">Check-In / Out</th>\\n                <th className=\\\"py-2.5 px-3\\\">Sumber OTA</th>\\n                <th className=\\\"py-2.5 px-3 text-right\\\">Gross</th>\\n                <th className=\\\"py-2.5 px-3 text-right\\\">Komisi OTA</th>\\n                <th className=\\\"py-2.5 px-3 text-right\\\">Net Revenue</th>\\n                <th className=\\\"py-2.5 px-3\\\">Status</th>\\n                <th className=\\\"py-2.5 pl-3 text-right\\\">Aksi Resepsionis</th>\\n              </tr>\\n            </thead>\\n            <tbody className=\\\"divide-y divide-slate-100 text-xs\\\">\\n              {filteredReservations.map((res) => (\\n                <tr key={res.id} className=\\\"hover:bg-slate-50\\\">\\n                  <td className=\\\"py-3 pr-3\\\">\\n                    <div className=\\\"font-semibold text-slate-900\\\">\\n                      {res.guestName}\\n                    </div>\\n                    <div className=\\\"text-slate-500 font-mono\\\">\\n                      {res.bookingCode} \302\267 {res.guestPhone || \'-\'}\\n                    </div>\\n                  </td>\\n                  <td className=\\\"py-3 px-3\\\">\\n                    <div className=\\\"font-medium text-slate-900\\\">\\n                      Kamar {res.roomNumber}\\n                    </div>\\n                    <div className=\\\"text-slate-500\\\">{res.roomType}</div>\\n                  </td>\\n                  <td className=\\\"py-3 px-3 font-mono tabular-nums text-slate-600\\\">\\n                    <div>\\n                      {res.checkIn} \342\206\222 {res.checkOut}\\n                    </div>\\n                    <div className=\\\"text-slate-400\\\">{res.nights} malam</div>\\n                  </td>\\n                  <td className=\\\"py-3 px-3\\\">\\n                    <span className=\\\"font-semibold text-slate-900\\\">\\n                      {res.channel}\\n                    </span>\\n                    <span className=\\\"text-slate-500 font-mono ml-1\\\">\\n                      ({res.commissionRate}%)\\n                    </span>\\n                  </td>\\n                  <td className=\\\"py-3 px-3 text-right font-mono tabular-nums text-slate-900\\\">\\n                    {formatIDR(res.grossRevenue)}\\n                  </td>\\n                  <td className=\\\"py-3 px-3 text-right font-mono tabular-nums text-amber-700\\\">\\n                    -{formatIDR(res.commissionAmount)}\\n                  </td>\\n                  <td className=\\\"py-3 px-3 text-right font-mono tabular-nums font-semibold text-emerald-700\\\">\\n                    {formatIDR(res.netRevenue)}\\n                  </td>\\n                  <td className=\\\"py-3 px-3 font-medium text-slate-800\\\">\\n                    {res.status}\\n                  </td>\\n                  <td className=\\\"py-3 pl-3 text-right\\\">\\n                    <div className=\\\"inline-flex items-center gap-1.5\\\">\\n                      {res.status === \'Confirmed\' && (\\n                        <button\\n                          type=\\\"button\\\"\\n                          onClick={() =>\\n                            onUpdateReservationStatus(res.id, \'Checked-In\')\\n                          }\\n                          className=\\\"px-2.5 py-1 text-[11px] font-semibold bg-slate-900 text-white rounded hover:bg-slate-800 transition-colors whitespace-nowrap\\\"\\n                        >\\n                          Check-In\\n                        </button>\\n                      )}\\n                      {res.status === \'Checked-In\' && (\\n                        <button\\n                          type=\\\"button\\\"\\n                          onClick={() =>\\n                            onUpdateReservationStatus(res.id, \'Checked-Out\')\\n                          }\\n                          className=\\\"px-2.5 py-1 text-[11px] font-semibold bg-emerald-700 text-white rounded hover:bg-emerald-800 transition-colors whitespace-nowrap\\\"\\n                        >\\n                          Check-Out\\n                        </button>\\n                      )}\\n                      {res.status !== \'Checked-Out\' &&\\n                        res.status !== \'Cancelled\' && (\\n                          <button\\n                            type=\\\"button\\\"\\n                            onClick={() =>\\n                              onUpdateReservationStatus(res.id, \'Cancelled\')\\n                            }\\n                            className=\\\"px-2 py-1 text-[11px] font-medium text-rose-700 hover:bg-rose-50 rounded transition-colors whitespace-nowrap\\\"\\n                          >\\n                            Batal\\n                          </button>\\n                        )}\\n                    </div>\\n                  </td>\\n                </tr>\\n              ))}\\n            </tbody>\\n          </table>\\n        </div>\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create ReservationsAndOtaManager.tsx with 6 OTA channel sync status, new booking calculator, and check-in/check-out actions\", \"Overwrite\":true, \"TargetFile\":\"/src/components/ReservationsAndOtaManager.tsx\", \"toolAction\":\"Creating ReservationsAndOtaManager.tsx\", \"toolSummary\":\"Create ReservationsAndOtaManager.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_1358035"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport { PropertySettingsConfig, RoomUnit } from \'../types/hms\';\\nimport { formatIDR } from \'../utils/hotelCalculations\';\\nimport { Save } from \'lucide-react\';\\n\\ninterface RatePlanAndOtaConfigProps {\\n  settings: PropertySettingsConfig;\\n  rooms: RoomUnit[];\\n  onSaveSettings: (updated: PropertySettingsConfig) => void;\\n}\\n\\nexport const RatePlanAndOtaConfig: React.FC<RatePlanAndOtaConfigProps> = ({\\n  settings,\\n  rooms,\\n  onSaveSettings,\\n}) => {\\n  const [formState, setFormState] = useState<PropertySettingsConfig>(settings);\\n  const [savedNotice, setSavedNotice] = useState(\'\');\\n\\n  const handleSave = (e: React.FormEvent) => {\\n    e.preventDefault();\\n    onSaveSettings(formState);\\n    setSavedNotice(\\n      \'Pengaturan Rate Plan (Weekday/Weekend) & Persentase Komisi 6 OTA berhasil diperbarui.\'\\n    );\\n  };\\n\\n  return (\\n    <div className=\\\"space-y-6\\\">\\n      <div className=\\\"bg-white border border-slate-200 rounded-xl p-6\\\">\\n        <h1 className=\\\"text-xl font-bold text-slate-900\\\">\\n          Struktur Kamar, Rate Plan & Pengaturan Komisi OTA\\n        </h1>\\n        <p className=\\\"text-xs text-slate-500 mt-1\\\">\\n          Kelola harga Weekday & Weekend untuk 15 unit kamar serta persentase potongan\\n          komisi 6 Channel OTA\\n        </p>\\n\\n        {savedNotice && (\\n          <div\\n            role=\\\"status\\\"\\n            className=\\\"mt-4 p-3 text-xs font-medium text-emerald-800 bg-emerald-50 border border-emerald-200 rounded-lg\\\"\\n          >\\n            {savedNotice}\\n          </div>\\n        )}\\n\\n        <form onSubmit={handleSave} className=\\\"mt-6 space-y-6\\\">\\n          {/* Rate Plan Table */}\\n          <div>\\n            <h2 className=\\\"text-sm font-bold text-slate-900 mb-3\\\">\\n              1. Skema Harga Kamar (Weekday vs Weekend) \342\200\224 Total 15 Unit\\n            </h2>\\n            <div className=\\\"overflow-x-auto border border-slate-200 rounded-xl\\\">\\n              <table className=\\\"w-full text-left border-collapse text-xs\\\">\\n                <thead>\\n                  <tr className=\\\"bg-slate-50 border-b border-slate-200 text-slate-600 font-semibold\\\">\\n                    <th className=\\\"py-3 px-4\\\">Tipe Rate Plan & Alokasi Unit</th>\\n                    <th className=\\\"py-3 px-4\\\">Konfigurasi Fisik</th>\\n                    <th className=\\\"py-3 px-4\\\">Fasilitas Makan Pagi</th>\\n                    <th className=\\\"py-3 px-4\\\">Tarif Weekday (IDR)</th>\\n                    <th className=\\\"py-3 px-4\\\">Tarif Weekend (IDR)</th>\\n                  </tr>\\n                </thead>\\n                <tbody className=\\\"divide-y divide-slate-200\\\">\\n                  <tr>\\n                    <td className=\\\"py-3.5 px-4\\\">\\n                      <div className=\\\"font-bold text-slate-900\\\">\\n                        Standard Room (8 Unit)\\n                      </div>\\n                      <div className=\\\"text-slate-500\\\">\\n                        Unit 101 \342\200\223 108 (5 Standard AC + 3 Ekonomi Kipas)\\n                      </div>\\n                    </td>\\n                    <td className=\\\"py-3.5 px-4 text-slate-700\\\">\\n                      Standard AC & Ekonomi Kipas\\n                    </td>\\n                    <td className=\\\"py-3.5 px-4 text-slate-700\\\">Room Only</td>\\n                    <td className=\\\"py-3.5 px-4\\\">\\n                      <input\\n                        type=\\\"number\\\"\\n                        aria-label=\\\"Standard Room Weekday Rate\\\"\\n                        value={formState.standardWeekday}\\n                        onChange={(e) =>\\n                          setFormState({\\n                            ...formState,\\n                            standardWeekday: Number(e.target.value),\\n                          })\\n                        }\\n                        className=\\\"w-36 px-3 py-1.5 font-mono bg-white border border-slate-300 rounded-lg text-slate-900\\\"\\n                      />\\n                    </td>\\n                    <td className=\\\"py-3.5 px-4\\\">\\n                      <input\\n                        type=\\\"number\\\"\\n                        aria-label=\\\"Standard Room Weekend Rate\\\"\\n                        value={formState.standardWeekend}\\n                        onChange={(e) =>\\n                          setFormState({\\n                            ...formState,\\n                            standardWeekend: Number(e.target.value),\\n                          })\\n                        }\\n                        className=\\\"w-36 px-3 py-1.5 font-mono bg-white border border-slate-300 rounded-lg text-slate-900\\\"\\n                      />\\n                    </td>\\n                  </tr>\\n\\n                  <tr>\\n                    <td className=\\\"py-3.5 px-4\\\">\\n                      <div className=\\\"font-bold text-slate-900\\\">\\n                        Deluxe Room (5 Unit)\\n                      </div>\\n                      <div className=\\\"text-slate-500\\\">\\n                        Unit 201 \342\200\223 205 (King Bed Emerald Green, AC, TV)\\n                      </div>\\n                    </td>\\n                    <td className=\\\"py-3.5 px-4 text-slate-700\\\">Deluxe Room AC</td>\\n                    <td className=\\\"py-3.5 px-4 text-emerald-700 font-medium\\\">\\n                      Include Breakfast (2 Pax)\\n                    </td>\\n                    <td className=\\\"py-3.5 px-4\\\">\\n                      <input\\n                        type=\\\"number\\\"\\n                        aria-label=\\\"Deluxe Room Weekday Rate\\\"\\n                        value={formState.deluxeWeekday}\\n                        onChange={(e) =>\\n                          setFormState({\\n                            ...formState,\\n                            deluxeWeekday: Number(e.target.value),\\n                          })\\n                        }\\n                        className=\\\"w-36 px-3 py-1.5 font-mono bg-white border border-slate-300 rounded-lg text-slate-900\\\"\\n                      />\\n                    </td>\\n                    <td className=\\\"py-3.5 px-4\\\">\\n                      <input\\n                        type=\\\"number\\\"\\n                        aria-label=\\\"Deluxe Room Weekend Rate\\\"\\n                        value={formState.deluxeWeekend}\\n                        onChange={(e) =>\\n                          setFormState({\\n                            ...formState,\\n                            deluxeWeekend: Number(e.target.value),\\n                          })\\n                        }\\n                        className=\\\"w-36 px-3 py-1.5 font-mono bg-white border border-slate-300 rounded-lg text-slate-900\\\"\\n                      />\\n                    </td>\\n                  </tr>\\n\\n                  <tr>\\n                    <td className=\\\"py-3.5 px-4\\\">\\n                      <div className=\\\"font-bold text-slate-900\\\">\\n                        Family Suite (2 Unit)\\n                      </div>\\n                      <div className=\\\"text-slate-500\\\">\\n                        Unit 301 \342\200\223 302 (Kamar Keluarga / Ekonomi Kipas Balkon)\\n                      </div>\\n                    </td>\\n                    <td className=\\\"py-3.5 px-4 text-slate-700\\\">\\n                      Family / Ekonomi Kipas Besar\\n                    </td>\\n                    <td className=\\\"py-3.5 px-4 text-emerald-700 font-medium\\\">\\n                      Include Breakfast (4 Pax)\\n                    </td>\\n                    <td className=\\\"py-3.5 px-4\\\">\\n                      <input\\n                        type=\\\"number\\\"\\n                        aria-label=\\\"Family Suite All Day Rate\\\"\\n                        value={formState.familySuiteRate}\\n                        onChange={(e) =>\\n                          setFormState({\\n                            ...formState,\\n                            familySuiteRate: Number(e.target.value),\\n                          })\\n                        }\\n                        className=\\\"w-36 px-3 py-1.5 font-mono bg-white border border-slate-300 rounded-lg text-slate-900\\\"\\n                      />\\n                    </td>\\n                    <td className=\\\"py-3.5 px-4 font-mono text-slate-600\\\">\\n                      All Day Flat ({formatIDR(formState.familySuiteRate)})\\n                    </td>\\n                  </tr>\\n                </tbody>\\n              </table>\\n            </div>\\n          </div>\\n\\n          {/* 6 OTA Commission Percentage Settings */}\\n          <div>\\n            <h2 className=\\\"text-sm font-bold text-slate-900 mb-3\\\">\\n              2. Pengaturan Persentase Komisi 6 Sumber Booking (OTA)\\n            </h2>\\n            <div className=\\\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4\\\">\\n              <div className=\\\"p-4 border border-slate-200 rounded-xl bg-slate-50\\\">\\n                <label className=\\\"block text-xs font-bold text-slate-900\\\">\\n                  Direct Booking / Walk-in (%)\\n                </label>\\n                <p className=\\\"text-[11px] text-slate-500 mb-2\\\">\\n                  Reservasi langsung via WhatsApp / Resepsionis\\n                </p>\\n                <input\\n                  type=\\\"number\\\"\\n                  min={0}\\n                  max={100}\\n                  value={formState.commDirect}\\n                  onChange={(e) =>\\n                    setFormState({\\n                      ...formState,\\n                      commDirect: Number(e.target.value),\\n                    })\\n                  }\\n                  className=\\\"w-full px-3 py-2 text-xs font-mono bg-white border border-slate-300 rounded-lg\\\"\\n                />\\n              </div>\\n\\n              <div className=\\\"p-4 border border-slate-200 rounded-xl bg-slate-50\\\">\\n                <label className=\\\"block text-xs font-bold text-slate-900\\\">\\n                  Airbnb (%)\\n                </label>\\n                <p className=\\\"text-[11px] text-slate-500 mb-2\\\">\\n                  Standar komisi host-only Airbnb (Default: 14%)\\n                </p>\\n                <input\\n                  type=\\\"number\\\"\\n                  min={0}\\n                  max={100}\\n                  value={formState.commAirbnb}\\n                  onChange={(e) =>\\n                    setFormState({\\n                      ...formState,\\n                      commAirbnb: Number(e.target.value),\\n                    })\\n                  }\\n                  className=\\\"w-full px-3 py-2 text-xs font-mono bg-white border border-slate-300 rounded-lg\\\"\\n                />\\n              </div>\\n\\n              <div className=\\\"p-4 border border-slate-200 rounded-xl bg-slate-50\\\">\\n                <label className=\\\"block text-xs font-bold text-slate-900\\\">\\n                  Traveloka (%)\\n                </label>\\n                <p className=\\\"text-[11px] text-slate-500 mb-2\\\">\\n                  Komisi kontrak TERA Traveloka (Default: 15%)\\n                </p>\\n                <input\\n                  type=\\\"number\\\"\\n                  min={0}\\n                  max={100}\\n                  value={formState.commTraveloka}\\n                  onChange={(e) =>\\n                    setFormState({\\n                      ...formState,\\n                      commTraveloka: Number(e.target.value),\\n                    })\\n                  }\\n                  className=\\\"w-full px-3 py-2 text-xs font-mono bg-white border border-slate-300 rounded-lg\\\"\\n                />\\n              </div>\\n\\n              <div className=\\\"p-4 border border-slate-200 rounded-xl bg-slate-50\\\">\\n                <label className=\\\"block text-xs font-bold text-slate-900\\\">\\n                  Tiket.com (%)\\n                </label>\\n                <p className=\\\"text-[11px] text-slate-500 mb-2\\\">\\n                  Komisi ekstranet Tiket.com (Default: 15%)\\n                </p>\\n                <input\\n                  type=\\\"number\\\"\\n                  min={0}\\n                  max={100}\\n                  value={formState.commTiket}\\n                  onChange={(e) =>\\n                    setFormState({\\n                      ...formState,\\n                      commTiket: Number(e.target.value),\\n                    })\\n                  }\\n                  className=\\\"w-full px-3 py-2 text-xs font-mono bg-white border border-slate-300 rounded-lg\\\"\\n                />\\n              </div>\\n\\n              <div className=\\\"p-4 border border-slate-200 rounded-xl bg-slate-50\\\">\\n                <label className=\\\"block text-xs font-bold text-slate-900\\\">\\n                  Agoda (%)\\n                </label>\\n                <p className=\\\"text-[11px] text-slate-500 mb-2\\\">\\n                  Komisi YCS Agoda (Default: 17%)\\n                </p>\\n                <input\\n                  type=\\\"number\\\"\\n                  min={0}\\n                  max={100}\\n                  value={formState.commAgoda}\\n                  onChange={(e) =>\\n                    setFormState({\\n                      ...formState,\\n                      commAgoda: Number(e.target.value),\\n                    })\\n                  }\\n                  className=\\\"w-full px-3 py-2 text-xs font-mono bg-white border border-slate-300 rounded-lg\\\"\\n                />\\n              </div>\\n\\n              <div className=\\\"p-4 border border-slate-200 rounded-xl bg-slate-50\\\">\\n                <label className=\\\"block text-xs font-bold text-slate-900\\\">\\n                  Booking.com (%)\\n                </label>\\n                <p className=\\\"text-[11px] text-slate-500 mb-2\\\">\\n                  Komisi Pulse Booking.com (Default: 18%)\\n                </p>\\n                <input\\n                  type=\\\"number\\\"\\n                  min={0}\\n                  max={100}\\n                  value={formState.commBooking}\\n                  onChange={(e) =>\\n                    setFormState({\\n                      ...formState,\\n                      commBooking: Number(e.target.value),\\n                    })\\n                  }\\n                  className=\\\"w-full px-3 py-2 text-xs font-mono bg-white border border-slate-300 rounded-lg\\\"\\n                />\\n              </div>\\n            </div>\\n          </div>\\n\\n          <button\\n            type=\\\"submit\\\"\\n            className=\\\"inline-flex items-center gap-2 px-5 py-2.5 text-xs font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-lg transition-colors\\\"\\n          >\\n            <Save className=\\\"w-4 h-4\\\" />\\n            <span>Simpan Perubahan Rate Plan & Komisi OTA</span>\\n          </button>\\n        </form>\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create RatePlanAndOtaConfig.tsx allowing Admin and Owner to configure Weekday/Weekend room rates and 6 OTA commission rates\", \"Overwrite\":true, \"TargetFile\":\"/src/components/RatePlanAndOtaConfig.tsx\", \"toolAction\":\"Creating RatePlanAndOtaConfig.tsx\", \"toolSummary\":\"Create RatePlanAndOtaConfig.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_1358313"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport { ExpenseCategory, ExpenseRecord } from \'../types/hms\';\\nimport { ALL_EXPENSE_CATEGORIES, formatIDR } from \'../utils/hotelCalculations\';\\nimport { Plus, Trash2 } from \'lucide-react\';\\n\\ninterface OperationalExpensesViewProps {\\n  expenses: ExpenseRecord[];\\n  selectedMonth: string;\\n  onSelectMonth: (m: string) => void;\\n  onAddExpense: (newExp: Omit<ExpenseRecord, \'id\' | \'ownerId\'>) => void;\\n  onDeleteExpense: (expenseId: string) => void;\\n}\\n\\nexport const OperationalExpensesView: React.FC<OperationalExpensesViewProps> = ({\\n  expenses,\\n  selectedMonth,\\n  onSelectMonth,\\n  onAddExpense,\\n  onDeleteExpense,\\n}) => {\\n  const [category, setCategory] = useState<ExpenseCategory>(\\n    ALL_EXPENSE_CATEGORIES[0]\\n  );\\n  const [description, setDescription] = useState(\'\');\\n  const [amount, setAmount] = useState(\'\');\\n  const [date, setDate] = useState(`${selectedMonth}-25`);\\n  const [pic, setPic] = useState(\'Admin Keuangan\');\\n  const [errorMsg, setErrorMsg] = useState(\'\');\\n  const [successMsg, setSuccessMsg] = useState(\'\');\\n\\n  const monthExpenses = expenses.filter((e) => e.monthKey === selectedMonth);\\n  const totalMonthExpense = monthExpenses.reduce((sum, e) => sum + e.amount, 0);\\n\\n  const handleSubmit = (e: React.FormEvent) => {\\n    e.preventDefault();\\n    setErrorMsg(\'\');\\n    setSuccessMsg(\'\');\\n\\n    const numAmount = Number(amount);\\n    if (!description.trim()) {\\n      setErrorMsg(\'Deskripsi pengeluaran operasional wajib diisi.\');\\n      return;\\n    }\\n    if (!numAmount || numAmount <= 0) {\\n      setErrorMsg(\'Nominal biaya harus lebih besar dari Rp 0.\');\\n      return;\\n    }\\n\\n    const monthKey = date.slice(0, 7);\\n    onAddExpense({\\n      category,\\n      description: description.trim(),\\n      amount: numAmount,\\n      date,\\n      monthKey,\\n      pic: pic.trim() || \'Admin\',\\n    });\\n\\n    setDescription(\'\');\\n    setAmount(\'\');\\n    setSuccessMsg(\\n      `Biaya \\\"${description.trim()}\\\" sebesar ${formatIDR(numAmount)} berhasil dicatat ke kategori ${category}.`\\n    );\\n  };\\n\\n  return (\\n    <div className=\\\"space-y-6\\\">\\n      <div className=\\\"bg-white border border-slate-200 rounded-xl p-6\\\">\\n        <div className=\\\"flex flex-wrap items-center justify-between gap-4 pb-5 border-b border-slate-100\\\">\\n          <div>\\n            <h1 className=\\\"text-xl font-bold text-slate-900\\\">\\n              Modul Biaya Operasional Bulanan (Expense Tracker)\\n            </h1>\\n            <p className=\\\"text-xs text-slate-500 mt-1\\\">\\n              Pencatatan pengeluaran 7 kategori akuntansi Hotel Putri Sari yang\\n              otomatis mengurangi Net Room Revenue pada Laporan Laba Rugi\\n            </p>\\n          </div>\\n\\n          <div className=\\\"flex items-center gap-3\\\">\\n            <label\\n              htmlFor=\\\"expense-month-filter\\\"\\n              className=\\\"text-xs font-medium text-slate-600\\\"\\n            >\\n              Periode:\\n            </label>\\n            <select\\n              id=\\\"expense-month-filter\\\"\\n              value={selectedMonth}\\n              onChange={(e) => onSelectMonth(e.target.value)}\\n              className=\\\"px-3 py-2 text-xs font-mono bg-slate-50 border border-slate-300 rounded-lg text-slate-900\\\"\\n            >\\n              <option value=\\\"2026-10\\\">Oktober 2026</option>\\n              <option value=\\\"2026-09\\\">September 2026</option>\\n            </select>\\n          </div>\\n        </div>\\n\\n        {/* 7 Category Summary Grid */}\\n        <div className=\\\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 mt-5\\\">\\n          {ALL_EXPENSE_CATEGORIES.map((cat, idx) => {\\n            const sum = monthExpenses\\n              .filter((e) => e.category === cat)\\n              .reduce((s, e) => s + e.amount, 0);\\n            return (\\n              <div\\n                key={cat}\\n                className=\\\"p-3.5 border border-slate-200 rounded-lg bg-slate-50/70 flex flex-col justify-between\\\"\\n              >\\n                <p className=\\\"text-xs font-semibold text-slate-800\\\">\\n                  0{idx + 1}. {cat}\\n                </p>\\n                <p className=\\\"text-base font-bold font-mono tabular-nums text-slate-900 mt-2\\\">\\n                  {formatIDR(sum)}\\n                </p>\\n              </div>\\n            );\\n          })}\\n\\n          <div className=\\\"p-3.5 border border-slate-900 rounded-lg bg-slate-900 text-white flex flex-col justify-between\\\">\\n            <p className=\\\"text-xs text-slate-300\\\">\\n              TOTAL BIAYA OPERASIONAL ({selectedMonth})\\n            </p>\\n            <p\\n              data-testid=\\\"expense-tracker-total\\\"\\n              className=\\\"text-lg font-bold font-mono tabular-nums text-rose-400 mt-2\\\"\\n            >\\n              {formatIDR(totalMonthExpense)}\\n            </p>\\n          </div>\\n        </div>\\n      </div>\\n\\n      {/* Form Input Pengeluaran & Tabel Rincian */}\\n      <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6\\\">\\n        <form\\n          onSubmit={handleSubmit}\\n          className=\\\"lg:col-span-5 bg-white border border-slate-200 rounded-xl p-6 space-y-4 h-fit\\\"\\n        >\\n          <div>\\n            <h2 className=\\\"text-base font-bold text-slate-900\\\">\\n              Input Biaya Operasional Baru\\n            </h2>\\n            <p className=\\\"text-xs text-slate-500\\\">\\n              Pilih salah satu dari 7 kategori biaya standar perhotelan\\n            </p>\\n          </div>\\n\\n          {errorMsg && (\\n            <div\\n              role=\\\"alert\\\"\\n              className=\\\"p-3 text-xs font-medium text-rose-800 bg-rose-50 border border-rose-200 rounded-lg\\\"\\n            >\\n              {errorMsg}\\n            </div>\\n          )}\\n\\n          {successMsg && (\\n            <div\\n              role=\\\"status\\\"\\n              className=\\\"p-3 text-xs font-medium text-emerald-800 bg-emerald-50 border border-emerald-200 rounded-lg\\\"\\n            >\\n              {successMsg}\\n            </div>\\n          )}\\n\\n          <div>\\n            <label\\n              htmlFor=\\\"exp-category\\\"\\n              className=\\\"block text-xs font-semibold text-slate-700 mb-1\\\"\\n            >\\n              Kategori Biaya Operasional (7 Kategori) *\\n            </label>\\n            <select\\n              id=\\\"exp-category\\\"\\n              value={category}\\n              onChange={(e) => setCategory(e.target.value as ExpenseCategory)}\\n              className=\\\"w-full px-3 py-2 text-xs bg-white border border-slate-300 rounded-lg text-slate-900\\\"\\n            >\\n              {ALL_EXPENSE_CATEGORIES.map((cat) => (\\n                <option key={cat} value={cat}>\\n                  {cat}\\n                </option>\\n              ))}\\n            </select>\\n          </div>\\n\\n          <div>\\n            <label\\n              htmlFor=\\\"exp-description\\\"\\n              className=\\\"block text-xs font-semibold text-slate-700 mb-1\\\"\\n            >\\n              Keterangan / Rincian Pengeluaran *\\n            </label>\\n            <input\\n              id=\\\"exp-description\\\"\\n              type=\\\"text\\\"\\n              value={description}\\n              onChange={(e) => setDescription(e.target.value)}\\n              placeholder=\\\"Contoh: Pembelian Deterjen & Softener Laundry\\\"\\n              className=\\\"w-full px-3 py-2 text-xs bg-white border border-slate-300 rounded-lg text-slate-900\\\"\\n            />\\n          </div>\\n\\n          <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-3\\\">\\n            <div>\\n              <label\\n                htmlFor=\\\"exp-amount\\\"\\n                className=\\\"block text-xs font-semibold text-slate-700 mb-1\\\"\\n              >\\n                Nominal Biaya (IDR) *\\n              </label>\\n              <input\\n                id=\\\"exp-amount\\\"\\n                type=\\\"number\\\"\\n                value={amount}\\n                onChange={(e) => setAmount(e.target.value)}\\n                placeholder=\\\"350000\\\"\\n                className=\\\"w-full px-3 py-2 text-xs font-mono bg-white border border-slate-300 rounded-lg text-slate-900\\\"\\n              />\\n            </div>\\n\\n            <div>\\n              <label\\n                htmlFor=\\\"exp-date\\\"\\n                className=\\\"block text-xs font-semibold text-slate-700 mb-1\\\"\\n              >\\n                Tanggal Transaksi *\\n              </label>\\n              <input\\n                id=\\\"exp-date\\\"\\n                type=\\\"date\\\"\\n                value={date}\\n                onChange={(e) => setDate(e.target.value)}\\n                className=\\\"w-full px-3 py-2 text-xs font-mono bg-white border border-slate-300 rounded-lg text-slate-900\\\"\\n              />\\n            </div>\\n          </div>\\n\\n          <div>\\n            <label\\n              htmlFor=\\\"exp-pic\\\"\\n              className=\\\"block text-xs font-semibold text-slate-700 mb-1\\\"\\n            >\\n              Penanggung Jawab (PIC)\\n            </label>\\n            <input\\n              id=\\\"exp-pic\\\"\\n              type=\\\"text\\\"\\n              value={pic}\\n              onChange={(e) => setPic(e.target.value)}\\n              className=\\\"w-full px-3 py-2 text-xs bg-white border border-slate-300 rounded-lg text-slate-900\\\"\\n            />\\n          </div>\\n\\n          <button\\n            type=\\\"submit\\\"\\n            className=\\\"w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 text-xs font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-lg transition-colors\\\"\\n          >\\n            <Plus className=\\\"w-4 h-4\\\" />\\n            <span>Simpan Pengeluaran Operasional</span>\\n          </button>\\n        </form>\\n\\n        {/* Expense Ledger Table */}\\n        <div className=\\\"lg:col-span-7 bg-white border border-slate-200 rounded-xl p-6\\\">\\n          <h2 className=\\\"text-base font-bold text-slate-900 mb-4\\\">\\n            Jurnal Rincian Pengeluaran ({selectedMonth})\\n          </h2>\\n\\n          <div className=\\\"overflow-x-auto\\\">\\n            <table className=\\\"w-full text-left border-collapse text-xs\\\">\\n              <thead>\\n                <tr className=\\\"border-b border-slate-200 text-slate-500 font-semibold\\\">\\n                  <th className=\\\"py-2.5 pr-3\\\">Tanggal</th>\\n                  <th className=\\\"py-2.5 px-3\\\">Kategori & Deskripsi</th>\\n                  <th className=\\\"py-2.5 px-3\\\">PIC</th>\\n                  <th className=\\\"py-2.5 px-3 text-right\\\">Nominal (IDR)</th>\\n                  <th className=\\\"py-2.5 pl-3 text-right\\\">Aksi</th>\\n                </tr>\\n              </thead>\\n              <tbody className=\\\"divide-y divide-slate-100\\\">\\n                {monthExpenses.map((exp) => (\\n                  <tr key={exp.id} className=\\\"hover:bg-slate-50\\\">\\n                    <td className=\\\"py-3 pr-3 font-mono tabular-nums text-slate-600 whitespace-nowrap\\\">\\n                      {exp.date}\\n                    </td>\\n                    <td className=\\\"py-3 px-3\\\">\\n                      <div className=\\\"font-semibold text-slate-900\\\">\\n                        {exp.category}\\n                      </div>\\n                      <div className=\\\"text-slate-500\\\">{exp.description}</div>\\n                    </td>\\n                    <td className=\\\"py-3 px-3 text-slate-600\\\">\\n                      {exp.pic || \'Admin\'}\\n                    </td>\\n                    <td className=\\\"py-3 px-3 text-right font-mono tabular-nums font-semibold text-slate-900 whitespace-nowrap\\\">\\n                      {formatIDR(exp.amount)}\\n                    </td>\\n                    <td className=\\\"py-3 pl-3 text-right\\\">\\n                      <button\\n                        type=\\\"button\\\"\\n                        aria-label={`Hapus pengeluaran ${exp.description}`}\\n                        onClick={() => onDeleteExpense(exp.id)}\\n                        className=\\\"p-1.5 text-slate-400 hover:text-rose-600 rounded transition-colors\\\"\\n                      >\\n                        <Trash2 className=\\\"w-4 h-4\\\" />\\n                      </button>\\n                    </td>\\n                  </tr>\\n                ))}\\n              </tbody>\\n            </table>\\n          </div>\\n        </div>\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create OperationalExpensesView.tsx for tracking expenses across all 7 accounting categories\", \"Overwrite\":true, \"TargetFile\":\"/src/components/OperationalExpensesView.tsx\", \"toolAction\":\"Creating OperationalExpensesView.tsx\", \"toolSummary\":\"Create OperationalExpensesView.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_1358541"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React from \'react\';\\nimport { MonthlyProfitLossReport } from \'../types/hms\';\\nimport {\\n  exportProfitLossToCsv,\\n  formatIDR,\\n} from \'../utils/hotelCalculations\';\\nimport { Download, Printer } from \'lucide-react\';\\n\\ninterface ProfitLossStatementViewProps {\\n  report: MonthlyProfitLossReport;\\n  selectedMonth: string;\\n  onSelectMonth: (monthKey: string) => void;\\n}\\n\\nexport const ProfitLossStatementView: React.FC<\\n  ProfitLossStatementViewProps\\n> = ({ report, selectedMonth, onSelectMonth }) => {\\n  const maxGross = Math.max(\\n    1,\\n    ...report.channelRows.map((c) => c.grossRevenue)\\n  );\\n\\n  const handleDownloadCsv = () => {\\n    const csvContent = exportProfitLossToCsv(report);\\n    const blob = new Blob([csvContent], { type: \'text/csv;charset=utf-8;\' });\\n    const url = URL.createObjectURL(blob);\\n    const a = document.createElement(\'a\');\\n    a.href = url;\\n    a.download = `Laporan-Keuangan-PnL-Hotel-Putri-Sari-${report.monthKey}.csv`;\\n    document.body.appendChild(a);\\n    a.click();\\n    document.body.removeChild(a);\\n    URL.revokeObjectURL(url);\\n  };\\n\\n  const handlePrintPdf = () => {\\n    window.print();\\n  };\\n\\n  return (\\n    <div className=\\\"space-y-6\\\">\\n      {/* Top Action & Filter Header */}\\n      <div className=\\\"bg-white border border-slate-200 rounded-xl p-6 flex flex-wrap items-center justify-between gap-4\\\">\\n        <div>\\n          <p className=\\\"text-xs font-mono text-slate-500\\\">\\n            HOTEL PUTRI SARI (15 KAMAR) \302\267 LAPORAN AKUNTANSI BULANAN OTOMATIS\\n          </p>\\n          <h1 className=\\\"text-xl font-bold text-slate-900 mt-0.5\\\">\\n            Laporan Laba Rugi (Profit & Loss Statement) \342\200\224 Periode {selectedMonth}\\n          </h1>\\n        </div>\\n\\n        <div className=\\\"flex flex-wrap items-center gap-3 no-print\\\">\\n          <div className=\\\"flex items-center gap-2\\\">\\n            <label\\n              htmlFor=\\\"pnl-month-select\\\"\\n              className=\\\"text-xs font-semibold text-slate-700\\\"\\n            >\\n              Filter Bulan & Tahun:\\n            </label>\\n            <select\\n              id=\\\"pnl-month-select\\\"\\n              value={selectedMonth}\\n              onChange={(e) => onSelectMonth(e.target.value)}\\n              className=\\\"px-3 py-2 text-xs font-mono bg-slate-50 border border-slate-300 rounded-lg text-slate-900\\\"\\n            >\\n              <option value=\\\"2026-10\\\">Oktober 2026</option>\\n              <option value=\\\"2026-09\\\">September 2026</option>\\n            </select>\\n          </div>\\n\\n          <button\\n            type=\\\"button\\\"\\n            onClick={handleDownloadCsv}\\n            className=\\\"inline-flex items-center gap-2 px-4 py-2 text-xs font-semibold text-slate-800 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors whitespace-nowrap shrink-0\\\"\\n          >\\n            <Download className=\\\"w-3.5 h-3.5\\\" />\\n            <span>Export CSV</span>\\n          </button>\\n\\n          <button\\n            type=\\\"button\\\"\\n            onClick={handlePrintPdf}\\n            className=\\\"inline-flex items-center gap-2 px-4 py-2 text-xs font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-lg transition-colors whitespace-nowrap shrink-0\\\"\\n          >\\n            <Printer className=\\\"w-3.5 h-3.5\\\" />\\n            <span>Export PDF / Cetak</span>\\n          </button>\\n        </div>\\n      </div>\\n\\n      {/* BAGIAN A: PENDAPATAN PER CHANNEL (OTA & DIRECT BOOKING) */}\\n      <div className=\\\"bg-white border border-slate-200 rounded-xl p-6\\\">\\n        <div className=\\\"pb-4 border-b border-slate-200\\\">\\n          <h2 className=\\\"text-base font-bold text-slate-900\\\">\\n            Bagian A \342\200\224 Pendapatan Kamar per Channel (Direct Booking & 5 OTA)\\n          </h2>\\n          <p className=\\\"text-xs text-slate-500 mt-0.5\\\">\\n            Rincian Malam Terjual (Room Nights), Gross Revenue, Persentase Komisi,\\n            Nominal Potongan Komisi, dan Net Room Revenue\\n          </p>\\n        </div>\\n\\n        <div className=\\\"overflow-x-auto mt-4\\\">\\n          <table\\n            data-testid=\\\"pnl-table-bagian-a\\\"\\n            className=\\\"w-full text-left border-collapse text-xs\\\"\\n          >\\n            <thead>\\n              <tr className=\\\"bg-slate-50 border-b border-slate-200 text-slate-600 font-semibold\\\">\\n                <th className=\\\"py-3 px-4\\\">Sumber Channel Booking</th>\\n                <th className=\\\"py-3 px-4 text-right\\\">\\n                  Jumlah Malam Terjual (Room Nights)\\n                </th>\\n                <th className=\\\"py-3 px-4 text-right\\\">Gross Revenue (IDR)</th>\\n                <th className=\\\"py-3 px-4 text-right\\\">Komisi (%)</th>\\n                <th className=\\\"py-3 px-4 text-right\\\">\\n                  Nominal Potongan Komisi (IDR)\\n                </th>\\n                <th className=\\\"py-3 px-4 text-right\\\">\\n                  Net Room Revenue (IDR)\\n                </th>\\n              </tr>\\n            </thead>\\n            <tbody className=\\\"divide-y divide-slate-200\\\">\\n              {report.channelRows.map((row) => (\\n                <tr key={row.channel} className=\\\"hover:bg-slate-50\\\">\\n                  <td className=\\\"py-3 px-4 font-semibold text-slate-900\\\">\\n                    {row.channel}\\n                    <span className=\\\"text-slate-400 font-normal ml-1.5\\\">\\n                      ({row.bookingsCount} rsv)\\n                    </span>\\n                  </td>\\n                  <td className=\\\"py-3 px-4 text-right font-mono tabular-nums text-slate-800\\\">\\n                    {row.roomNights} malam\\n                  </td>\\n                  <td className=\\\"py-3 px-4 text-right font-mono tabular-nums text-slate-900\\\">\\n                    {formatIDR(row.grossRevenue)}\\n                  </td>\\n                  <td className=\\\"py-3 px-4 text-right font-mono tabular-nums text-slate-600\\\">\\n                    {row.commissionRate}%\\n                  </td>\\n                  <td className=\\\"py-3 px-4 text-right font-mono tabular-nums text-amber-700\\\">\\n                    -{formatIDR(row.commissionAmount)}\\n                  </td>\\n                  <td className=\\\"py-3 px-4 text-right font-mono tabular-nums font-semibold text-emerald-700\\\">\\n                    {formatIDR(row.netRevenue)}\\n                  </td>\\n                </tr>\\n              ))}\\n            </tbody>\\n            <tfoot>\\n              <tr className=\\\"bg-slate-900 text-white font-bold text-xs\\\">\\n                <td className=\\\"py-3.5 px-4\\\">TOTAL PENDAPATAN KAMAR (BAGIAN A)</td>\\n                <td className=\\\"py-3.5 px-4 text-right font-mono tabular-nums\\\">\\n                  {report.totalRoomNightsSold} malam\\n                </td>\\n                <td className=\\\"py-3.5 px-4 text-right font-mono tabular-nums\\\">\\n                  {formatIDR(report.totalGrossRevenue)}\\n                </td>\\n                <td className=\\\"py-3.5 px-4 text-right font-mono tabular-nums\\\">\\n                  {report.totalGrossRevenue > 0\\n                    ? (\\n                        (report.totalCommissionAmount /\\n                          report.totalGrossRevenue) *\\n                        100\\n                      ).toFixed(1)\\n                    : \'0.0\'}\\n                  % (Rata-rata)\\n                </td>\\n                <td className=\\\"py-3.5 px-4 text-right font-mono tabular-nums text-amber-300\\\">\\n                  -{formatIDR(report.totalCommissionAmount)}\\n                </td>\\n                <td className=\\\"py-3.5 px-4 text-right font-mono tabular-nums text-emerald-400\\\">\\n                  {formatIDR(report.totalNetRoomRevenue)}\\n                </td>\\n              </tr>\\n            </tfoot>\\n          </table>\\n        </div>\\n      </div>\\n\\n      {/* BAGIAN B & BAGIAN C SIDE BY SIDE */}\\n      <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6\\\">\\n        {/* BAGIAN B: RINCIAN BIAYA OPERASIONAL */}\\n        <div className=\\\"lg:col-span-7 bg-white border border-slate-200 rounded-xl p-6\\\">\\n          <div className=\\\"pb-4 border-b border-slate-200\\\">\\n            <h2 className=\\\"text-base font-bold text-slate-900\\\">\\n              Bagian B \342\200\224 Rincian Biaya Operasional (7 Kategori)\\n            </h2>\\n            <p className=\\\"text-xs text-slate-500 mt-0.5\\\">\\n              Seluruh beban operasional bulanan termasuk Depresiasi Aset & Peralatan\\n            </p>\\n          </div>\\n\\n          <div className=\\\"overflow-x-auto mt-4\\\">\\n            <table\\n              data-testid=\\\"pnl-table-bagian-b\\\"\\n              className=\\\"w-full text-left border-collapse text-xs\\\"\\n            >\\n              <thead>\\n                <tr className=\\\"bg-slate-50 border-b border-slate-200 text-slate-600 font-semibold\\\">\\n                  <th className=\\\"py-3 px-4\\\">Kategori Biaya Operasional</th>\\n                  <th className=\\\"py-3 px-3 text-right\\\">Porsi (%)</th>\\n                  <th className=\\\"py-3 px-4 text-right\\\">Total Pengeluaran (IDR)</th>\\n                </tr>\\n              </thead>\\n              <tbody className=\\\"divide-y divide-slate-200\\\">\\n                {report.expenseRows.map((exp, idx) => (\\n                  <tr key={exp.category} className=\\\"hover:bg-slate-50\\\">\\n                    <td className=\\\"py-3 px-4 font-medium text-slate-900\\\">\\n                      0{idx + 1}. {exp.category}\\n                    </td>\\n                    <td className=\\\"py-3 px-3 text-right font-mono tabular-nums text-slate-500\\\">\\n                      {exp.shareOfTotalExpense.toFixed(1)}%\\n                    </td>\\n                    <td className=\\\"py-3 px-4 text-right font-mono tabular-nums font-semibold text-slate-900\\\">\\n                      {formatIDR(exp.amount)}\\n                    </td>\\n                  </tr>\\n                ))}\\n              </tbody>\\n              <tfoot>\\n                <tr className=\\\"bg-slate-100 border-t-2 border-slate-300 font-bold text-slate-900 text-xs\\\">\\n                  <td className=\\\"py-3.5 px-4\\\">\\n                    TOTAL BIAYA OPERASIONAL (BAGIAN B)\\n                  </td>\\n                  <td className=\\\"py-3.5 px-3 text-right font-mono tabular-nums\\\">\\n                    100.0%\\n                  </td>\\n                  <td className=\\\"py-3.5 px-4 text-right font-mono tabular-nums text-rose-700\\\">\\n                    {formatIDR(report.totalOperationalExpenses)}\\n                  </td>\\n                </tr>\\n              </tfoot>\\n            </table>\\n          </div>\\n        </div>\\n\\n        {/* BAGIAN C: RINGKASAN AKHIR (PROFIT & LOSS SUMMARY) */}\\n        <div\\n          data-testid=\\\"pnl-bagian-c-summary\\\"\\n          className=\\\"lg:col-span-5 bg-white border border-slate-200 rounded-xl p-6 flex flex-col justify-between\\\"\\n        >\\n          <div>\\n            <div className=\\\"pb-4 border-b border-slate-200\\\">\\n              <h2 className=\\\"text-base font-bold text-slate-900\\\">\\n                Bagian C \342\200\224 Ringkasan Akhir Laba Rugi\\n              </h2>\\n              <p className=\\\"text-xs text-slate-500 mt-0.5\\\">\\n                Kalkulasi otomatis Net Profit Akhir, Margin & Occupancy Rate\\n              </p>\\n            </div>\\n\\n            <div className=\\\"mt-4 space-y-3 text-xs\\\">\\n              <div className=\\\"flex items-center justify-between py-2 border-b border-slate-100\\\">\\n                <span className=\\\"text-slate-600\\\">Total Gross Revenue</span>\\n                <span className=\\\"font-mono tabular-nums font-semibold text-slate-900\\\">\\n                  {formatIDR(report.totalGrossRevenue)}\\n                </span>\\n              </div>\\n\\n              <div className=\\\"flex items-center justify-between py-2 border-b border-slate-100\\\">\\n                <span className=\\\"text-slate-600\\\">\\n                  Total Potongan Komisi OTA\\n                </span>\\n                <span className=\\\"font-mono tabular-nums font-semibold text-amber-700\\\">\\n                  -{formatIDR(report.totalCommissionAmount)}\\n                </span>\\n              </div>\\n\\n              <div className=\\\"flex items-center justify-between py-2 border-b border-slate-200 bg-slate-50 px-3 rounded\\\">\\n                <span className=\\\"font-semibold text-slate-900\\\">\\n                  Total Net Room Revenue\\n                </span>\\n                <span className=\\\"font-mono tabular-nums font-bold text-slate-900\\\">\\n                  {formatIDR(report.totalNetRoomRevenue)}\\n                </span>\\n              </div>\\n\\n              <div className=\\\"flex items-center justify-between py-2 border-b border-slate-100\\\">\\n                <span className=\\\"text-slate-600\\\">\\n                  Total Biaya Operasional (7 Kategori)\\n                </span>\\n                <span className=\\\"font-mono tabular-nums font-semibold text-rose-700\\\">\\n                  -{formatIDR(report.totalOperationalExpenses)}\\n                </span>\\n              </div>\\n            </div>\\n          </div>\\n\\n          <div className=\\\"mt-6 p-5 bg-slate-900 text-white rounded-xl space-y-4\\\">\\n            <div>\\n              <p className=\\\"text-xs font-mono text-slate-300\\\">\\n                NET PROFIT AKHIR (Net Room Revenue \342\210\222 Biaya Operasional)\\n              </p>\\n              <p\\n                data-testid=\\\"pnl-final-net-profit\\\"\\n                className=\\\"text-2xl sm:text-3xl font-bold font-mono tabular-nums text-emerald-400 mt-1\\\"\\n              >\\n                {formatIDR(report.netProfit)}\\n              </p>\\n            </div>\\n\\n            <div className=\\\"grid grid-cols-2 gap-4 pt-3 border-t border-slate-800\\\">\\n              <div>\\n                <p className=\\\"text-xs text-slate-400\\\">Net Profit Margin (%)</p>\\n                <p\\n                  data-testid=\\\"pnl-net-profit-margin\\\"\\n                  className=\\\"text-lg font-bold font-mono tabular-nums text-white mt-0.5\\\"\\n                >\\n                  {report.netProfitMargin.toFixed(2)}%\\n                </p>\\n              </div>\\n              <div>\\n                <p className=\\\"text-xs text-slate-400\\\">Occupancy Rate (%)</p>\\n                <p\\n                  data-testid=\\\"pnl-occupancy-rate\\\"\\n                  className=\\\"text-lg font-bold font-mono tabular-nums text-white mt-0.5\\\"\\n                >\\n                  {report.occupancyRate.toFixed(2)}%\\n                </p>\\n                <p className=\\\"text-[11px] text-slate-400 font-mono\\\">\\n                  ({report.totalRoomNightsSold} / {report.availableRoomNights} mlm)\\n                </p>\\n              </div>\\n            </div>\\n          </div>\\n        </div>\\n      </div>\\n\\n      {/* GRAFIK PERBANDINGAN PENDAPATAN OTA */}\\n      <div className=\\\"bg-white border border-slate-200 rounded-xl p-6\\\">\\n        <h2 className=\\\"text-base font-bold text-slate-900\\\">\\n          Grafik Perbandingan Pendapatan OTA vs Direct Booking ({selectedMonth})\\n        </h2>\\n        <p className=\\\"text-xs text-slate-500 mt-0.5\\\">\\n          Visualisasi kontribusi Gross Revenue dan Net Room Revenue setelah dikurangi\\n          komisi masing-masing channel\\n        </p>\\n\\n        <div className=\\\"grid grid-cols-1 md:grid-cols-6 gap-4 mt-6 items-end pt-4\\\">\\n          {report.channelRows.map((row) => {\\n            const barHeightPct = Math.max(\\n              8,\\n              Math.round((row.grossRevenue / maxGross) * 100)\\n            );\\n            const netHeightPct = Math.max(\\n              6,\\n              Math.round((row.netRevenue / maxGross) * 100)\\n            );\\n\\n            return (\\n              <div\\n                key={row.channel}\\n                className=\\\"flex flex-col items-center p-3 border border-slate-200 rounded-lg bg-slate-50/50\\\"\\n              >\\n                <div className=\\\"w-full h-36 flex items-end justify-center gap-2 px-2 border-b border-slate-200\\\">\\n                  <div\\n                    className=\\\"w-6 bg-slate-400 rounded-t transition-all\\\"\\n                    style={{ height: `${barHeightPct}%` }}\\n                    title={`Gross Revenue: ${formatIDR(row.grossRevenue)}`}\\n                  />\\n                  <div\\n                    className=\\\"w-6 bg-emerald-600 rounded-t transition-all\\\"\\n                    style={{ height: `${netHeightPct}%` }}\\n                    title={`Net Revenue: ${formatIDR(row.netRevenue)}`}\\n                  />\\n                </div>\\n                <p className=\\\"text-xs font-bold text-slate-900 mt-2.5 text-center\\\">\\n                  {row.channel}\\n                </p>\\n                <p className=\\\"text-[11px] font-mono tabular-nums text-slate-500\\\">\\n                  Komisi {row.commissionRate}%\\n                </p>\\n                <p className=\\\"text-xs font-mono tabular-nums font-semibold text-emerald-700 mt-1\\\">\\n                  {formatIDR(row.netRevenue)}\\n                </p>\\n              </div>\\n            );\\n          })}\\n        </div>\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create ProfitLossStatementView.tsx with Bagian A, Bagian B, Bagian C, OTA revenue comparison chart, and CSV/PDF export\", \"Overwrite\":true, \"TargetFile\":\"/src/components/ProfitLossStatementView.tsx\", \"toolAction\":\"Creating ProfitLossStatementView.tsx\", \"toolSummary\":\"Create ProfitLossStatementView.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_1358900"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport { MonthlyProfitLossReport, UserRole } from \'../types/hms\';\\nimport { HOTEL_PHOTOS } from \'../data/initialData\';\\nimport { BrainCircuit, Image, MapPin, MessageSquare, Sparkles } from \'lucide-react\';\\n\\ninterface AiAndMapsHubProps {\\n  role: UserRole;\\n  pnlReport: MonthlyProfitLossReport;\\n}\\n\\nexport const AiAndMapsHub: React.FC<AiAndMapsHubProps> = ({\\n  role,\\n  pnlReport,\\n}) => {\\n  const [activeTab, setActiveTab] = useState<\\n    \'quick_assist\' | \'maps\' | \'thinking_audit\' | \'image_studio\'\\n  >(role === UserRole.RESEPSIONIS ? \'quick_assist\' : \'thinking_audit\');\\n\\n  // 1. High-Thinking Financial Audit (gemini-4-argon)\\n  const [auditQuestion, setAuditQuestion] = useState(\\n    \'Bagaimana strategi menurunkan beban komisi OTA dan meningkatkan Net Profit Margin Hotel Putri Sari bulan depan?\'\\n  );\\n  const [auditResult, setAuditResult] = useState(\'\');\\n  const [auditModel, setAuditModel] = useState(\'\');\\n  const [isAuditing, setIsAuditing] = useState(false);\\n\\n  // 2. Quick Front Desk Assistant (gemini-3.1-flash-lite)\\n  const [guestName, setGuestName] = useState(\'Keluarga Bp. Bambang Suryono\');\\n  const [roomName, setRoomName] = useState(\'Family Suite 301\');\\n  const [quickOutput, setQuickOutput] = useState(\'\');\\n  const [isQuickLoading, setIsQuickLoading] = useState(false);\\n\\n  // 3. Google Maps Grounding (gemini-3.8-flash + googleMaps)\\n  const [mapsQuery, setMapsQuery] = useState(\\n    \'Rekomendasi tempat kuliner populer, ATM center, dan objek wisata keluarga terdekat untuk tamu Hotel Putri Sari\'\\n  );\\n  const [mapsText, setMapsText] = useState(\'\');\\n  const [mapsPlaces, setMapsPlaces] = useState<\\n    Array<{ title: string; uri: string }>\\n  >([]);\\n  const [isMapsLoading, setIsMapsLoading] = useState(false);\\n\\n  // 4. Image Studio (gemini-nano-banana-2.1)\\n  const [selectedAsset, setSelectedAsset] = useState(HOTEL_PHOTOS.deluxeMain);\\n  const [imagePrompt, setImagePrompt] = useState(\\n    \'Create a warm, high-resolution luxury tropical hotel promotional banner featuring an emerald green bed setup with morning sunlight\'\\n  );\\n  const [generatedImg, setGeneratedImg] = useState(\'\');\\n  const [imageError, setImageError] = useState(\'\');\\n  const [isGeneratingImg, setIsGeneratingImg] = useState(false);\\n\\n  const handleRunAudit = async () => {\\n    setIsAuditing(true);\\n    setAuditResult(\'\');\\n    try {\\n      const res = await fetch(\'/api/gemini/financial-audit\', {\\n        method: \'POST\',\\n        headers: { \'Content-Type\': \'application/json\' },\\n        body: JSON.stringify({\\n          pnlSummary: reportToCompactPayload(pnlReport),\\n          customQuestion: auditQuestion,\\n        }),\\n      });\\n      const data = await res.json();\\n      if (!res.ok) throw new Error(data.error || \'Gagal menjalankan analisis AI.\');\\n      setAuditResult(data.text);\\n      setAuditModel(data.modelUsed || \'gemini-4-argon\');\\n    } catch (err: unknown) {\\n      setAuditResult(\\n        err instanceof Error ? `Info API: ${err.message}` : \'Gagal memuat respons.\'\\n      );\\n    } finally {\\n      setIsAuditing(false);\\n    }\\n  };\\n\\n  const handleRunQuickAssist = async () => {\\n    setIsQuickLoading(true);\\n    setQuickOutput(\'\');\\n    try {\\n      const res = await fetch(\'/api/gemini/quick-assist\', {\\n        method: \'POST\',\\n        headers: { \'Content-Type\': \'application/json\' },\\n        body: JSON.stringify({\\n          taskType: \'Konfirmasi Reservasi & Panduan Check-In WhatsApp\',\\n          guestName,\\n          roomName,\\n          checkIn: \'2026-10-25\',\\n          checkOut: \'2026-10-27\',\\n          channel: \'Direct Booking\',\\n          totalAmount: 1500000,\\n        }),\\n      });\\n      const data = await res.json();\\n      if (!res.ok) throw new Error(data.error || \'Gagal membuat pesan cepat.\');\\n      setQuickOutput(data.text);\\n    } catch (err: unknown) {\\n      setQuickOutput(\\n        err instanceof Error ? `Info API: ${err.message}` : \'Gagal memuat respons.\'\\n      );\\n    } finally {\\n      setIsQuickLoading(false);\\n    }\\n  };\\n\\n  const handleRunMapsGrounding = async () => {\\n    setIsMapsLoading(true);\\n    setMapsText(\'\');\\n    setMapsPlaces([]);\\n    try {\\n      const res = await fetch(\'/api/gemini/maps-grounding\', {\\n        method: \'POST\',\\n        headers: { \'Content-Type\': \'application/json\' },\\n        body: JSON.stringify({ query: mapsQuery }),\\n      });\\n      const data = await res.json();\\n      if (!res.ok) throw new Error(data.error || \'Gagal memuat Google Maps Grounding.\');\\n      setMapsText(data.text);\\n      setMapsPlaces(data.places || []);\\n    } catch (err: unknown) {\\n      setMapsText(\\n        err instanceof Error ? `Info API: ${err.message}` : \'Gagal memuat data Maps.\'\\n      );\\n    } finally {\\n      setIsMapsLoading(false);\\n    }\\n  };\\n\\n  const handleGenerateImage = async () => {\\n    setIsGeneratingImg(true);\\n    setImageError(\'\');\\n    try {\\n      const res = await fetch(\'/api/gemini/image-studio\', {\\n        method: \'POST\',\\n        headers: { \'Content-Type\': \'application/json\' },\\n        body: JSON.stringify({\\n          prompt: imagePrompt,\\n          sourceAssetPath: selectedAsset,\\n          aspectRatio: \'16:9\',\\n        }),\\n      });\\n      const data = await res.json();\\n      if (!res.ok) throw new Error(data.error || \'Gagal membuat gambar promosi.\');\\n      setGeneratedImg(data.imageUrl);\\n    } catch (err: unknown) {\\n      setImageError(\\n        err instanceof Error\\n          ? err.message\\n          : \'Gagal membuat gambar. Pastikan API Key mendukung image generation.\'\\n      );\\n    } finally {\\n      setIsGeneratingImg(false);\\n    }\\n  };\\n\\n  return (\\n    <div className=\\\"space-y-6\\\">\\n      <div className=\\\"bg-white border border-slate-200 rounded-xl p-6\\\">\\n        <h1 className=\\\"text-xl font-bold text-slate-900\\\">\\n          AI Revenue Intelligence, Google Maps Concierge & Studio Promosi\\n        </h1>\\n        <p className=\\\"text-xs text-slate-500 mt-1\\\">\\n          Didukung oleh Gemini 4 Argon (High Thinking), Gemini 3.8 Flash (Google Maps\\n          Grounding), Gemini 3.1 Flash Lite, dan Nano Banana 2.1\\n        </p>\\n\\n        <div className=\\\"flex flex-wrap items-center gap-2 mt-5 pt-4 border-t border-slate-100\\\">\\n          {role !== UserRole.RESEPSIONIS && (\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => setActiveTab(\'thinking_audit\')}\\n              className={`inline-flex items-center gap-2 px-3.5 py-2 text-xs font-semibold rounded-lg transition-colors ${\\n                activeTab === \'thinking_audit\'\\n                  ? \'bg-slate-900 text-white\'\\n                  : \'bg-slate-100 text-slate-700 hover:bg-slate-200\'\\n              }`}\\n            >\\n              <BrainCircuit className=\\\"w-4 h-4\\\" />\\n              <span>Konsultan P&L High-Thinking (Gemini 4 Argon)</span>\\n            </button>\\n          )}\\n\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => setActiveTab(\'quick_assist\')}\\n            className={`inline-flex items-center gap-2 px-3.5 py-2 text-xs font-semibold rounded-lg transition-colors ${\\n              activeTab === \'quick_assist\'\\n                ? \'bg-slate-900 text-white\'\\n                : \'bg-slate-100 text-slate-700 hover:bg-slate-200\'\\n            }`}\\n          >\\n            <MessageSquare className=\\\"w-4 h-4\\\" />\\n            <span>Asisten Cepat Resepsionis (Flash Lite)</span>\\n          </button>\\n\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => setActiveTab(\'maps\')}\\n            className={`inline-flex items-center gap-2 px-3.5 py-2 text-xs font-semibold rounded-lg transition-colors ${\\n              activeTab === \'maps\'\\n                ? \'bg-slate-900 text-white\'\\n                : \'bg-slate-100 text-slate-700 hover:bg-slate-200\'\\n            }`}\\n          >\\n            <MapPin className=\\\"w-4 h-4\\\" />\\n            <span>Panduan Lokasi Google Maps Grounding</span>\\n          </button>\\n\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => setActiveTab(\'image_studio\')}\\n            className={`inline-flex items-center gap-2 px-3.5 py-2 text-xs font-semibold rounded-lg transition-colors ${\\n              activeTab === \'image_studio\'\\n                ? \'bg-slate-900 text-white\'\\n                : \'bg-slate-100 text-slate-700 hover:bg-slate-200\'\\n            }`}\\n          >\\n            <Image className=\\\"w-4 h-4\\\" />\\n            <span>Studio Foto Promosi OTA (Nano Banana 2.1)</span>\\n          </button>\\n        </div>\\n      </div>\\n\\n      {/* Tab Content */}\\n      {activeTab === \'thinking_audit\' && role !== UserRole.RESEPSIONIS && (\\n        <div className=\\\"bg-white border border-slate-200 rounded-xl p-6 space-y-4\\\">\\n          <h2 className=\\\"text-base font-bold text-slate-900\\\">\\n            Audit Strategis Laporan Keuangan & Optimasi OTA (ThinkingLevel.HIGH)\\n          </h2>\\n          <div>\\n            <label\\n              htmlFor=\\\"audit-question-input\\\"\\n              className=\\\"block text-xs font-semibold text-slate-700 mb-1\\\"\\n            >\\n              Pertanyaan Strategis untuk AI Revenue Consultant:\\n            </label>\\n            <input\\n              id=\\\"audit-question-input\\\"\\n              type=\\\"text\\\"\\n              value={auditQuestion}\\n              onChange={(e) => setAuditQuestion(e.target.value)}\\n              className=\\\"w-full px-3 py-2 text-xs bg-white border border-slate-300 rounded-lg\\\"\\n            />\\n          </div>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={handleRunAudit}\\n            disabled={isAuditing}\\n            className=\\\"inline-flex items-center gap-2 px-4 py-2 text-xs font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-lg disabled:opacity-60\\\"\\n          >\\n            <Sparkles className=\\\"w-4 h-4\\\" />\\n            <span>\\n              {isAuditing\\n                ? \'Menganalisis Laporan P&L dengan High Thinking...\'\\n                : \'Jalankan Analisis Mendalam P&L\'}\\n            </span>\\n          </button>\\n\\n          {auditResult && (\\n            <div className=\\\"p-4 bg-slate-50 border border-slate-200 rounded-lg text-xs text-slate-800 whitespace-pre-wrap leading-relaxed\\\">\\n              <div className=\\\"font-mono text-[11px] text-slate-500 mb-2\\\">\\n                Model: {auditModel}\\n              </div>\\n              {auditResult}\\n            </div>\\n          )}\\n        </div>\\n      )}\\n\\n      {activeTab === \'quick_assist\' && (\\n        <div className=\\\"bg-white border border-slate-200 rounded-xl p-6 space-y-4\\\">\\n          <h2 className=\\\"text-base font-bold text-slate-900\\\">\\n            Generator Pesan Konfirmasi Tamu Instan (Gemini 3.1 Flash Lite)\\n          </h2>\\n          <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-4\\\">\\n            <div>\\n              <label className=\\\"block text-xs font-semibold text-slate-700 mb-1\\\">\\n                Nama Tamu\\n              </label>\\n              <input\\n                type=\\\"text\\\"\\n                value={guestName}\\n                onChange={(e) => setGuestName(e.target.value)}\\n                className=\\\"w-full px-3 py-2 text-xs bg-white border border-slate-300 rounded-lg\\\"\\n              />\\n            </div>\\n            <div>\\n              <label className=\\\"block text-xs font-semibold text-slate-700 mb-1\\\">\\n                Unit Kamar\\n              </label>\\n              <input\\n                type=\\\"text\\\"\\n                value={roomName}\\n                onChange={(e) => setRoomName(e.target.value)}\\n                className=\\\"w-full px-3 py-2 text-xs bg-white border border-slate-300 rounded-lg\\\"\\n              />\\n            </div>\\n          </div>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={handleRunQuickAssist}\\n            disabled={isQuickLoading}\\n            className=\\\"inline-flex items-center gap-2 px-4 py-2 text-xs font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-lg disabled:opacity-60\\\"\\n          >\\n            <span>\\n              {isQuickLoading\\n                ? \'Menyusun Draf Pesan...\'\\n                : \'Buat Pesan WhatsApp Resepsionis\'}\\n            </span>\\n          </button>\\n          {quickOutput && (\\n            <div className=\\\"p-4 bg-slate-50 border border-slate-200 rounded-lg text-xs text-slate-800 whitespace-pre-wrap leading-relaxed\\\">\\n              {quickOutput}\\n            </div>\\n          )}\\n        </div>\\n      )}\\n\\n      {activeTab === \'maps\' && (\\n        <div className=\\\"bg-white border border-slate-200 rounded-xl p-6 space-y-4\\\">\\n          <h2 className=\\\"text-base font-bold text-slate-900\\\">\\n            Pencarian Tempat & Rekomendasi Area dengan Google Maps Grounding\\n          </h2>\\n          <div>\\n            <label className=\\\"block text-xs font-semibold text-slate-700 mb-1\\\">\\n              Cari Lokasi / Rekomendasi Sekitar Properti:\\n            </label>\\n            <input\\n              type=\\\"text\\\"\\n              value={mapsQuery}\\n              onChange={(e) => setMapsQuery(e.target.value)}\\n              className=\\\"w-full px-3 py-2 text-xs bg-white border border-slate-300 rounded-lg\\\"\\n            />\\n          </div>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={handleRunMapsGrounding}\\n            disabled={isMapsLoading}\\n            className=\\\"inline-flex items-center gap-2 px-4 py-2 text-xs font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-lg disabled:opacity-60\\\"\\n          >\\n            <MapPin className=\\\"w-4 h-4\\\" />\\n            <span>\\n              {isMapsLoading\\n                ? \'Mencari Data di Google Maps...\'\\n                : \'Cari dengan Google Maps Grounding\'}\\n            </span>\\n          </button>\\n\\n          {mapsText && (\\n            <div className=\\\"p-4 bg-slate-50 border border-slate-200 rounded-lg text-xs text-slate-800 whitespace-pre-wrap leading-relaxed space-y-3\\\">\\n              <div>{mapsText}</div>\\n              {mapsPlaces.length > 0 && (\\n                <div className=\\\"pt-3 border-t border-slate-200\\\">\\n                  <p className=\\\"font-semibold text-slate-900 mb-2\\\">\\n                    Tautan Lokasi Google Maps Terverifikasi:\\n                  </p>\\n                  <div className=\\\"flex flex-wrap gap-2\\\">\\n                    {mapsPlaces.map((pl, idx) => (\\n                      <a\\n                        key={idx}\\n                        href={pl.uri}\\n                        target=\\\"_blank\\\"\\n                        rel=\\\"noopener noreferrer\\\"\\n                        className=\\\"underline text-blue-700 hover:text-blue-900\\\"\\n                      >\\n                        {pl.title}\\n                      </a>\\n                    ))}\\n                  </div>\\n                </div>\\n              )}\\n            </div>\\n          )}\\n        </div>\\n      )}\\n\\n      {activeTab === \'image_studio\' && (\\n        <div className=\\\"bg-white border border-slate-200 rounded-xl p-6 space-y-4\\\">\\n          <h2 className=\\\"text-base font-bold text-slate-900\\\">\\n            Studio Pembuatan & Edit Foto Promosi Kamar (Gemini Nano Banana 2.1)\\n          </h2>\\n          <div className=\\\"grid grid-cols-1 md:grid-cols-2 gap-4\\\">\\n            <div className=\\\"space-y-3\\\">\\n              <label className=\\\"block text-xs font-semibold text-slate-700\\\">\\n                Pilih Foto Referensi Kamar Hotel Putri Sari:\\n              </label>\\n              <select\\n                value={selectedAsset}\\n                onChange={(e) => setSelectedAsset(e.target.value)}\\n                className=\\\"w-full px-3 py-2 text-xs bg-white border border-slate-300 rounded-lg\\\"\\n              >\\n                <option value={HOTEL_PHOTOS.deluxeMain}>\\n                  Deluxe Room (Sprei Hijau Emerald)\\n                </option>\\n                <option value={HOTEL_PHOTOS.standardAcBalcony}>\\n                  Standard AC Room (Sprei Oranye & Balkon)\\n                </option>\\n                <option value={HOTEL_PHOTOS.ekonomiFan1}>\\n                  Room Ekonomi Kipas (Sprei Putih)\\n                </option>\\n                <option value={HOTEL_PHOTOS.exterior}>\\n                  Plang Depan Hotel Putri Sari\\n                </option>\\n              </select>\\n\\n              <label className=\\\"block text-xs font-semibold text-slate-700\\\">\\n                Instruksi Prompt Edit / Pembuatan Gambar Promosi:\\n              </label>\\n              <textarea\\n                rows={3}\\n                value={imagePrompt}\\n                onChange={(e) => setImagePrompt(e.target.value)}\\n                className=\\\"w-full px-3 py-2 text-xs bg-white border border-slate-300 rounded-lg\\\"\\n              />\\n\\n              <button\\n                type=\\\"button\\\"\\n                onClick={handleGenerateImage}\\n                disabled={isGeneratingImg}\\n                className=\\\"inline-flex items-center gap-2 px-4 py-2 text-xs font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-lg disabled:opacity-60\\\"\\n              >\\n                <Image className=\\\"w-4 h-4\\\" />\\n                <span>\\n                  {isGeneratingImg\\n                    ? \'Memproses dengan Nano Banana 2.1...\'\\n                    : \'Generate / Edit Foto Promosi\'}\\n                </span>\\n              </button>\\n\\n              {imageError && (\\n                <p className=\\\"text-xs text-amber-800 bg-amber-50 border border-amber-200 p-3 rounded-lg\\\">\\n                  {imageError}\\n                </p>\\n              )}\\n            </div>\\n\\n            <div className=\\\"border border-slate-200 rounded-lg p-3 bg-slate-50\\\">\\n              <p className=\\\"text-xs font-semibold text-slate-700 mb-2\\\">\\n                {generatedImg ? \'Hasil Foto AI Studio:\' : \'Foto Referensi Saat Ini:\'}\\n              </p>\\n              <img\\n                src={generatedImg || selectedAsset}\\n                alt=\\\"Preview Kamar Hotel Putri Sari\\\"\\n                referrerPolicy=\\\"no-referrer\\\"\\n                className=\\\"w-full h-56 object-cover rounded-lg border border-slate-200\\\"\\n              />\\n            </div>\\n          </div>\\n        </div>\\n      )}\\n    </div>\\n  );\\n};\\n\\nfunction reportToCompactPayload(r: MonthlyProfitLossReport) {\\n  return {\\n    monthKey: r.monthKey,\\n    occupancyRate: `${r.occupancyRate.toFixed(1)}%`,\\n    totalRoomNightsSold: r.totalRoomNightsSold,\\n    totalGrossRevenue: r.totalGrossRevenue,\\n    totalCommissionAmount: r.totalCommissionAmount,\\n    totalNetRoomRevenue: r.totalNetRoomRevenue,\\n    totalOperationalExpenses: r.totalOperationalExpenses,\\n    netProfit: r.netProfit,\\n    netProfitMargin: `${r.netProfitMargin.toFixed(1)}%`,\\n    channels: r.channelRows,\\n    expenses: r.expenseRows,\\n  };\\n}\\n\", \"Description\":\"Create AiAndMapsHub.tsx integrating High Thinking P&L Audit, Flash Lite Receptionist Assist, Google Maps Grounding, and Nano Banana 2.1 Image Studio\", \"Overwrite\":true, \"TargetFile\":\"/src/components/AiAndMapsHub.tsx\", \"toolAction\":\"Creating AiAndMapsHub.tsx\", \"toolSummary\":\"Create AiAndMapsHub.tsx\"}"
      original_name: "write_to_file"
    }
    thinking_duration {
      seconds: 291
      nanos: 187187129
    }
    stop_reason: STOP_REASON_STOP_PATTERN
    provider_assigned_message_id: "_9reaofYN8KUmtkPlbvSyQ8"
  }
}
