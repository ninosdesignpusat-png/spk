      thinking_signature: "\022\277\r\n\274\r\001i\024}\023{\350L-\vL\356:\001\246\361\226\365\204\214?S\317]Z\357\303\340\220\236\v\314m\244B\311\353\342\177{\315\335\237\336\026:\n\341\006I\243\005\227y\304\'\031\371R\252\334\313\364\327n\257N\367\177\337\343hY\235dx\\\207K\326\205\2045\204r\217\267]\266\330\302\310\300+W.\333\225\207\364\225\203\243I\351\305W\243\314\240u\\\314/\240^p\216\334\340\377[\332zB\222R\t]\364>q\ry\326\363\v\252!o\337\375Z\274\353!\263\353\324\003\25180\246V\227\245\230\257\334\274\253r\325i\333f\017\365\317^\'\307\355x\"3z\210\310\r\237U\000c\r\036\333>{\246X\240XrfV\202\241:\226.\025E\363\002\362l\036\264\241\230\371\024\255\251\220kCj\351B\201FOk\a<\022\212\336\216\276\200\353\004\227\372w(l\230>\3062\326P\\\004\313\003\333\227\375\020\263\267\306\270_!\257\2315\327\2431\257\025\300nU\313+\370\244\206\336\351\252PL\306\360\331?\216V\345\357\202\260n\037\a\264\357\244\343^\321V\020\263\300\321\270\343D2\373E:\350\b|\366\317\344d{\004\273Y\346\031\\\366\203\003M\216\242b\246\377\'5S\016\177\232\t\2711\035Y\207\207B\224\366\366U \217\304\215Yv\226\226\263\004\025\327\017\324`~<\330\352\006e\030\263\332\300\205\263\333U\275\200\356\235<\314\315\261\373\356F1\213d\324\017!\321:\a\022\"\022@wH7}K\271\034FsS\240\243/\364\242\276$\247\302\365\350\320\267z)t\321\f\237\326\354\330\272\252:\277\225\301~x\373(\353\232`\"\022\321\r\374\330\210Geu\2311U[kz){n}iL\333q\266g\t\370\310\277\205)\302\365\242@#\322)T\234 \332)\377\022L\364b\026\362\266\231\274\225\001\352\f\304\217Z\345O\3709&\373\213\257+\267\"\a+\223E\3132\026?Z\305\322.\234\255\356\032\235m\327\262\210\244\364K\364\302%\321\264\224G\226\227\305\321\262\216*\0040kN\273\223\314\325=y\016k\270\032\037\206M\307\375\301<\344\324\376\2116\307M\265\337\222wY\365t\263\317\207=\235\316\375\265\002\242\221\240^\241(\366\3058\b:\267x\373\001\353\2705\036w\r\307\242nl\367\327\223\313.\377\004]\373A[\237\006\026\251\331l\003\265T GYQ\bi\317\231??\215\213\204\200\334x ST\302\242E-\360\355\2355\355\2